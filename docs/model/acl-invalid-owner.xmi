<?xml version="1.0" encoding="UTF-8"?>
<acl:AclModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:acl="https://vnu.edu.vn/sme/goal/acl/2.0"
    xsi:schemaLocation="https://vnu.edu.vn/sme/goal/acl/2.0 acl.ecore"
    version="v2.0" name="InvalidOwnerExample">
  <classifiers xsi:type="acl:Group" name="Team"/>
  <classifiers xsi:type="acl:Entity" name="Document"/>
  <!-- Deliberately invalid: Owner may target only Role or Group, never Entity. -->
  <owners source="//@classifiers.0" target="//@classifiers.1" lower="1" upper="-1"/>
</acl:AclModel>
