<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_SF" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.27.0">
  <bpmn:collaboration id="Process_SF_collab">
    <bpmn:participant id="Process_SF_p" name="Sales Forecast" processRef="Process_SF"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_SF" isExecutable="false">
    <bpmn:laneSet id="Process_SF_ls">
      <bpmn:lane id="Process_SF_lane7" name="Credit Control">
        <bpmn:flowNodeRef>Act_cc_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_cc_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_cc_appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_SF_lane6" name="Financial Control">
        <bpmn:flowNodeRef>Act_fc_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_fc_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_fc_appr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_SF_lane5" name="Business VP">
        <bpmn:flowNodeRef>Act_vp_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_vp_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_vp_appr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_SF_lane4" name="Sector Manager">
        <bpmn:flowNodeRef>Act_sm_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_sm_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_sm_lvl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_SF_lane3" name="Department Manager">
        <bpmn:flowNodeRef>Act_dm_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_dm_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_dm_appr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_SF_lane2" name="Service Agreements">
        <bpmn:flowNodeRef>Act_sa_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_sa_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_sa_appr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_SF_lane1" name="Presale Engineer">
        <bpmn:flowNodeRef>Act_ps_bom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_ps_hld</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_ps_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ps</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_SF_lane0" name="Customer Manager">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_newcust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_updcust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_cust_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_insertdeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_presale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_vendorbom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_bomupdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_bommanual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_bom_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_missingpn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_pnsprice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_creatingpns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_svcpct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_svcfee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_svc_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_updprofit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_loop_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_profit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_kit_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_appr_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_250k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_dealapproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_kitcomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_createpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0rt5rll</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Deal opportunity">
      <bpmn:documentation>-- trigger
post DealOpportunity_post: deal.dealDetailsInserted = false</bpmn:documentation>
      <bpmn:outgoing>Process_SF_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_newcust" name="New customer?">
      <bpmn:documentation>context Deal inv NewCustomer_guard:
  self.customerIsNew = true  -- 'Yes'
  self.customerIsNew = false -- 'No'</bpmn:documentation>
      <bpmn:incoming>Process_SF_f0</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f1</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_updcust" name="Updating customer details">
      <bpmn:documentation>context CustomerManager::updatingCustomerDetails()
pre UpdatingCustomerDetails_pre: deal.customerIsNew = false</bpmn:documentation>
      <bpmn:incoming>Process_SF_f1</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_ticket" name="Creating Customer Ticket">
      <bpmn:documentation>context CustomerManager::creatingCustomerTicket()
pre CreatingCustomerTicket_pre: deal.customerIsNew = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f2</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_cust_m">
      <bpmn:documentation>-- pure merge, no guard</bpmn:documentation>
      <bpmn:incoming>Process_SF_f3</bpmn:incoming>
      <bpmn:incoming>Process_SF_f4</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_insertdeal" name="Inserting and updating deal details">
      <bpmn:documentation>context CustomerManager::insertingAndUpdatingDealDetails()
post InsertingDeal_post: deal.dealDetailsInserted = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f5</bpmn:incoming>
      <bpmn:incoming>Process_SF_f54</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="Gw_presale" name="Required Presale Engineer?">
      <bpmn:documentation>context Deal inv RequiredPresaleEngineer_guard:
  self.presaleInvoked = true  -- inclusive: main flow continues in parallel with the Presale sub-flow
  self.presaleInvoked = false -- main flow proceeds directly to vendor-BOM check</bpmn:documentation>
      <bpmn:incoming>Process_SF_f6</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f7</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f8</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_vendorbom" name="There is vendor BOM?">
      <bpmn:documentation>context Deal inv VendorBom_guard:
  self.vendorBomExists = true  -- 'Yes': Updating BOM and HLD
  self.vendorBomExists = false -- 'No': Creating a BOM manually</bpmn:documentation>
      <bpmn:incoming>Process_SF_f8</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f12</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_bomupdate" name="Updating BOM and HLD">
      <bpmn:documentation>context CustomerManager::updatingBomAndHld()
post UpdatingBomHld_post: deal.bomReady = true and deal.hldReady = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f13</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_bommanual" name="Creating a BOM manually">
      <bpmn:documentation>context CustomerManager::creatingBomManually()
post CreatingBomManually_post: deal.bomReady = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f12</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_bom_m">
      <bpmn:documentation>-- pure merge, no guard</bpmn:documentation>
      <bpmn:incoming>Process_SF_f14</bpmn:incoming>
      <bpmn:incoming>Process_SF_f15</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_missingpn" name="Missing PN?">
      <bpmn:documentation>context Deal inv MissingPn_guard:
  self.pnMissing = true  -- 'Yes': Creating PNs
  self.pnMissing = false -- 'No'</bpmn:documentation>
      <bpmn:incoming>Process_SF_f16</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f17</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_pnsprice" name="Updating PNs Price">
      <bpmn:documentation>context CustomerManager::updatingPnsPrice()
pre  UpdatingPnsPrice_pre: deal.bomReady = true
post UpdatingPnsPrice_post: deal.pnsReady = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f17</bpmn:incoming>
      <bpmn:incoming>Process_SF_f19</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_creatingpns" name="Creating PNs">
      <bpmn:documentation>context CustomerManager::creatingPns()
pre  CreatingPns_pre: deal.pnMissing = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f18</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_svcpct" name="Updating percentages for service contract">
      <bpmn:documentation>context CustomerManager::updatingPercentagesForServiceContract()
post UpdatingServicePct_post: deal.serviceContractPct = deal.serviceContractPct@pre</bpmn:documentation>
      <bpmn:incoming>Process_SF_f20</bpmn:incoming>
      <bpmn:incoming>Process_SF_f26</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_svcfee" name="Service fee">
      <bpmn:documentation>context Deal inv ServiceFee_guard:
  self.serviceContractPct &gt; 7  -- 'Yes': Service Agreements approval required
  self.serviceContractPct &lt;= 7 -- 'No': skip service-agreement approval entirely (not a violation)</bpmn:documentation>
      <bpmn:incoming>Process_SF_f21</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f22</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_svc_m">
      <bpmn:documentation>-- pure merge, no guard: ServiceFee&lt;=7 or SaApprove=Yes feed here</bpmn:documentation>
      <bpmn:incoming>Process_SF_f23</bpmn:incoming>
      <bpmn:incoming>Process_SF_f27</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_ps_bom" name="Creating BOM">
      <bpmn:documentation>context PresaleEngineer::creatingBom()
pre  CreatingBomPresale_pre: deal.presaleInvoked = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f7</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_ps_hld" name="Writing HLD Document">
      <bpmn:documentation>context PresaleEngineer::writingHldDocument()
pre  WritingHld_pre: deal.bomReady = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f9</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_ps_send" name="Sending HLD to Customer Manager">
      <bpmn:documentation>context PresaleEngineer::sendingHldToCustomerManager()
post SendingHld_post: deal.hldReady = true and deal.bomReady = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f10</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_ps" name="HLD sent">
      <bpmn:documentation>context Deal inv HldSent_endInvariant: deal.hldReady = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f11</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_ps_med"/>
    </bpmn:endEvent>
    <bpmn:task id="Act_sa_pending" name="Pending approval">
      <bpmn:documentation>context ServiceAgreements::pendingApproval()
pre SaPending_pre: deal.serviceContractPct &gt; 7</bpmn:documentation>
      <bpmn:incoming>Process_SF_f22</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_sa_review" name="Contract review and approval">
      <bpmn:documentation>context ServiceAgreements::contractReviewAndApproval()</bpmn:documentation>
      <bpmn:incoming>Process_SF_f24</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_sa_appr" name="Approved?">
      <bpmn:documentation>context Deal inv SaApprove_guard:
  self.serviceAgreementApproved = true  -- 'Yes'
  else -- 'No': loops back to Act_sa_review, goal stays open</bpmn:documentation>
      <bpmn:incoming>Process_SF_f25</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f26</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_updprofit" name="Updating deal profitability and closure percentages">
      <bpmn:documentation>context CustomerManager::updatingDealProfitabilityAndClosurePercentages()
post UpdatingProfitability_post: deal.profitabilityPct = deal.profitabilityPct@pre</bpmn:documentation>
      <bpmn:incoming>Process_SF_f28</bpmn:incoming>
      <bpmn:incoming>Process_SF_f29</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_loop_m">
      <bpmn:documentation>-- pure merge, no guard: exactly one rejection loop (Dept/Sector/VP 'No') feeds back here</bpmn:documentation>
      <bpmn:incoming>Process_SF_f35</bpmn:incoming>
      <bpmn:incoming>Process_SF_f47</bpmn:incoming>
      <bpmn:incoming>Flow_07pzf14</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_profit" name="Profitability">
      <bpmn:documentation>context Deal inv Profitability_guard:
  self.profitabilityPct &gt; 12  -- 'Yes': skip Dept/Sector/VP chain entirely
  self.profitabilityPct &lt;= 12 -- 'No': Department Manager pending approval</bpmn:documentation>
      <bpmn:incoming>Process_SF_f30</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f31</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_dm_pending" name="Pending approval">
      <bpmn:documentation>context DeptManager::pendingApproval()
pre DmPending_pre: deal.profitabilityPct &lt;= 12</bpmn:documentation>
      <bpmn:incoming>Process_SF_f32</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_dm_exam" name="Profitability examination">
      <bpmn:documentation>context DeptManager::profitabilityExamination()</bpmn:documentation>
      <bpmn:incoming>Process_SF_f33</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_dm_appr" name="Approved?">
      <bpmn:documentation>context Deal inv DmApprove_guard:
  self.approvedBy-&gt;includes(Role::DeptManager) and deal.profitabilityPct &gt; 10 -- 'Yes, &gt;10%'
  self.approvedBy-&gt;includes(Role::DeptManager) and deal.profitabilityPct &lt;= 10 -- 'Yes, &lt;10%': escalate to Sector Manager
  else -- 'No': loops back to Act_updprofit</bpmn:documentation>
      <bpmn:incoming>Process_SF_f34</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f35</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f36</bpmn:outgoing>
      <bpmn:outgoing>Flow_0lukkhq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_sm_pending" name="Pending approval">
      <bpmn:documentation>context SectorManager::pendingApproval()
pre SmPending_pre: deal.profitabilityPct &lt;= 10</bpmn:documentation>
      <bpmn:incoming>Flow_0lukkhq</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_sm_exam" name="Profitability examination">
      <bpmn:documentation>context SectorManager::profitabilityExamination()</bpmn:documentation>
      <bpmn:incoming>Process_SF_f39</bpmn:incoming>
      <bpmn:outgoing>Flow_1qb4suh</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_sm_lvl" name="Approved?">
      <bpmn:documentation>context Deal inv SmApprove_guard:
  self.approvedBy-&gt;includes(Role::SectorManager) and deal.profitabilityPct &gt; 5  -- 'Yes, &gt;5%'
  self.approvedBy-&gt;includes(Role::SectorManager) and deal.profitabilityPct &lt;= 5 -- 'Yes, &lt;5%': escalate to Business VP
  else -- 'No': loops back to Act_updprofit</bpmn:documentation>
      <bpmn:incoming>Flow_1qb4suh</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f44</bpmn:outgoing>
      <bpmn:outgoing>Flow_1x6ystf</bpmn:outgoing>
      <bpmn:outgoing>Flow_07pzf14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_vp_pending" name="Pending approval">
      <bpmn:documentation>context BusinessVP::pendingApproval()
pre VpPending_pre: deal.profitabilityPct &lt;= 5</bpmn:documentation>
      <bpmn:incoming>Process_SF_f44</bpmn:incoming>
      <bpmn:outgoing>Flow_1c4basn</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_vp_exam" name="Profitability examination">
      <bpmn:documentation>context BusinessVP::profitabilityExamination()</bpmn:documentation>
      <bpmn:incoming>Flow_1c4basn</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f46</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_vp_appr" name="Approved?">
      <bpmn:documentation>context Deal inv VpApprove_guard:
  self.approvedBy-&gt;includes(Role::BusinessVP)  -- 'Yes'
  else -- 'No': loops back to Act_updprofit</bpmn:documentation>
      <bpmn:incoming>Process_SF_f46</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f47</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ogjw5x</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_kit_m">
      <bpmn:documentation>-- pure merge, no guard: exactly one of the profitability-approval outcomes feeds here</bpmn:documentation>
      <bpmn:incoming>Process_SF_f36</bpmn:incoming>
      <bpmn:incoming>Flow_1x6ystf</bpmn:incoming>
      <bpmn:incoming>Flow_1ogjw5x</bpmn:incoming>
      <bpmn:outgoing>Flow_1rm70yq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_appr_m">
      <bpmn:documentation>-- pure merge, no guard: Profitability&gt;12 or the profitability-approval chain feed here</bpmn:documentation>
      <bpmn:incoming>Process_SF_f31</bpmn:incoming>
      <bpmn:incoming>Flow_1rm70yq</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_250k" name="&gt;250,000 NIS?">
      <bpmn:documentation>context Deal inv Above250k_guard:
  self.dealValue &gt; 250000  -- 'Yes': Financial Control approval required
  self.dealValue &lt;= 250000 -- 'No': skip Financial Control -- NOTE: no i* actor represents Financial Control at all</bpmn:documentation>
      <bpmn:incoming>Process_SF_f49</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f51</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ik94bb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_dealapproved" name="Deal approved">
      <bpmn:documentation>context CustomerManager::dealApproved()
pre  DealApproved_pre: deal.creditControlApproved = true
post DealApproved_post: deal.approvedProposal = deal.currentProposal</bpmn:documentation>
      <bpmn:incoming>Process_SF_f59</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f60</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_kitcomplete" name="Completion of kit components">
      <bpmn:documentation>context CustomerManager::completionOfKitComponents()
pre  KitComplete_pre: deal.approvedProposal-&gt;notEmpty()
post KitComplete_post: deal.kitCompleted = true
-- NOTE: if this operation changes deal.currentProposal, then
-- deal.currentProposal &lt;&gt; deal.approvedProposal afterwards (see Case A)</bpmn:documentation>
      <bpmn:incoming>Process_SF_f60</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f62</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_transfer" name="Transferring to order operator">
      <bpmn:documentation>context CustomerManager::transferringToOrderOperator()
pre  Transfer_pre: deal.kitCompleted = true
post Transfer_post: deal.transferredToOperator = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f62</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f63</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_createpo" name="Creating PO in CRM System">
      <bpmn:documentation>context CustomerManager::creatingPoInCrmSystem()
post CreatePo_post: deal.poCreated = true</bpmn:documentation>
      <bpmn:incoming>Process_SF_f63</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f64</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_done" name="PO created">
      <bpmn:documentation>context Deal inv PoCreated_endInvariant:
  self.poCreated = true
  -- NOTE: does NOT logically imply self.currentProposal = self.approvedProposal (Case A)</bpmn:documentation>
      <bpmn:incoming>Process_SF_f64</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_done_med"/>
    </bpmn:endEvent>
    <bpmn:task id="Act_fc_pending" name="Pending approval">
      <bpmn:documentation>context FinancialControl::pendingApproval()
pre FcPending_pre: deal.dealValue &gt; 250000</bpmn:documentation>
      <bpmn:incoming>Flow_0ik94bb</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f52</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_fc_exam" name="Deal financial examination">
      <bpmn:documentation>context FinancialControl::dealFinancialExamination()</bpmn:documentation>
      <bpmn:incoming>Process_SF_f52</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f53</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_fc_appr" name="Approved?">
      <bpmn:documentation>context Deal inv FcApprove_guard:
  self.financialControlApproved = true  -- 'Yes': Credit Control next
  else -- 'No': loops back to Act_updprofit</bpmn:documentation>
      <bpmn:incoming>Process_SF_f53</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f54</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f55</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_cc_pending" name="Pending approval">
      <bpmn:documentation>context CreditControl::pendingApproval()
pre CcPending_pre: deal.dealValue &lt;= 250000 or deal.financialControlApproved = true</bpmn:documentation>
      <bpmn:incoming>Flow_1p1hf2s</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f56</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_cc_exam" name="Deal credit examination">
      <bpmn:documentation>context CreditControl::dealCreditExamination()</bpmn:documentation>
      <bpmn:incoming>Process_SF_f56</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f57</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_cc_appr" name="Approved?">
      <bpmn:documentation>context Deal inv CcApprove_guard:
  self.creditControlApproved = true  -- 'Yes'
  self.creditControlApproved = false -- 'No': deal rejected, process ends (not a loop)</bpmn:documentation>
      <bpmn:incoming>Process_SF_f57</bpmn:incoming>
      <bpmn:outgoing>Process_SF_f58</bpmn:outgoing>
      <bpmn:outgoing>Process_SF_f59</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_reject" name="Deal rejected">
      <bpmn:documentation>context Deal inv DealRejected_endInvariant: self.creditControlApproved = false</bpmn:documentation>
      <bpmn:incoming>Process_SF_f58</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_reject_med"/>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0rt5rll">
      <bpmn:documentation>-- pure merge, no guard: Above250k=No, or FcApprove=Yes, feed here (Credit Control always runs downstream)</bpmn:documentation>
      <bpmn:incoming>Process_SF_f51</bpmn:incoming>
      <bpmn:incoming>Process_SF_f55</bpmn:incoming>
      <bpmn:outgoing>Flow_1p1hf2s</bpmn:outgoing>
    </bpmn:exclusiveGateway>
