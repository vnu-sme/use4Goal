model CustomerComplaintProcess {

  pool ComplaintHandling for ComplaintCase {
    name "Customer Complaint Handling"
    lane FieldMan;
    lane Examiner;
    lane CustomerManager;
    lane Accountment;
  }

  start complaintReceived {
    name "Complaint received"
    lane FieldMan
    trigger none

    pre {[
      self.phase = ComplaintPhase::RECEIVED
    ]}

    flow updateArtifacts
  }

  activity updateArtifacts {
    name "Update artifacts"
    type task
    lane FieldMan

    pre {[
      self.phase = ComplaintPhase::RECEIVED
    ]}

    post {[
      self.phase = ComplaintPhase::ARTIFACTS_UPDATED
    ]}

    flow examineComplaint
  }

  activity examineComplaint {
    name "Examine complaint"
    type task
    lane Examiner

    pre {[
      self.phase = ComplaintPhase::ARTIFACTS_UPDATED
    ]}

    post {[
      self.phase = ComplaintPhase::EXAMINATION_COMPLETE
    ]}

    flow decideRefund
  }

  activity decideRefund {
    name "Decide refund"
    type task
    lane CustomerManager

    pre {[
      self.phase = ComplaintPhase::EXAMINATION_COMPLETE
    ]}

    post {[
      self.phase = ComplaintPhase::REFUND_APPROVED
    ]}

    flow recordRefund
  }

  activity recordRefund {
    name "Record refund"
    type task
    lane Accountment

    pre {[
      self.phase = ComplaintPhase::REFUND_APPROVED
    ]}

    post {[
      self.phase = ComplaintPhase::REFUND_RECORDED
    ]}

    flow complaintClosed
  }

  end complaintClosed {
    name "Complaint closed"
    lane Accountment
    trigger none
  }
}
