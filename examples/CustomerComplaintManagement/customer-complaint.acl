acl v4.0 CustomerComplaint {

    datatype DateTime;

    enum ComplaintCategory {
        CUSTOMER_ACCOUNT,
        NUTRITION,
        LAB_QUALITY
    }

    enum ComplaintPhase {
        RECEIVED,
        ARTIFACTS_UPDATED,
        UNDER_EXAMINATION,
        EXAMINATION_COMPLETE,
        COMPENSATION_DECIDED,
        REFUND_APPROVED,
        REFUND_RECORDED,
        CLOSED
    }

    enum ApprovalOutcome {
        PENDING,
        APPROVED,
        REJECTED
    }

    role ComplaintParticipant {
        email : String;
    }

    role Examiner specializes ComplaintParticipant;

    role FinancialApprover specializes ComplaintParticipant {
        approvalCeilingAmount : Integer;
    }

    orgContext ComplaintCase {
        attribute complaintId : Integer required;
        attribute category : ComplaintCategory required;
        attribute refundAmount : Integer required;
        attribute phase : ComplaintPhase required mutable default RECEIVED;

        role FieldMan specializes ComplaintParticipant;
        role Nutritionist specializes Examiner;
        role LabManager specializes Examiner;
        role CustomerManager specializes FinancialApprover;
        role Cfo specializes FinancialApprover;
        role Accountment specializes ComplaintParticipant;

        entity ExaminationRecord {
            attribute finding : String required;
            attribute examDate : DateTime required;
        }

        entity RefundDecision {
            attribute outcome : ApprovalOutcome required;
            attribute approvedAmount : Integer required;
            attribute decidedAt : DateTime required;
        }
    }

    composition ComplaintExaminations {
        ComplaintCase [1] role complaint;
        ExaminationRecord [0..*] role examinations;
    }

    composition ComplaintRefunds {
        ComplaintCase [1] role complaint;
        RefundDecision [0..*] role refunds;
    }

    association ExaminerRecords {
        Examiner [1] role examiner;
        ExaminationRecord [0..*] role examinations;
    }

    association ApproverRefunds {
        FinancialApprover [1] role approver;
        RefundDecision [0..*] role refunds;
    }

    context ComplaintCase inv UniqueExaminationDates:
        self.ExaminationRecord->isUnique(examDate);

    context ComplaintCase inv ExaminersBelongToComplaint:
        self.ExaminationRecord->forAll(e |
            self.Nutritionist->includes(e.examiner) or
            self.LabManager->includes(e.examiner)
        );
}
