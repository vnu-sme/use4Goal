// CustomerComplaint intentional model.
//
// OCL context convention: self : ComplaintCase

istar CustomerComplaintGoals {

  agent ComplaintCase {

    goal ComplaintResolvedAndClosed : Achieve

    goal ComplaintExaminedAndSettled : Achieve
      > or ComplaintResolvedAndClosed

    goal ComplaintReceivedAndRegistered : Sustain
      > or ComplaintResolvedAndClosed

    goal ComplaintArtifactsUpdated : None
      > or ComplaintReceivedAndRegistered
    condition {[
      self.phase = ComplaintPhase::ARTIFACTS_UPDATED
    ]}

    goal ComplaintExaminedBySpecialist : None
      > or ComplaintExaminedAndSettled

    goal SpecialistExaminationReceived : None
      > or ComplaintExaminedAndSettled

    goal RefundApprovedByManager : Achieve
      > or ComplaintExaminedAndSettled
    condition {[
      self.RefundDecision->notEmpty()
      and
      self.RefundDecision->forAll(r | r.outcome = ApprovalOutcome::APPROVED)
    ]}

    goal RefundRejectedByManager : None
      > or ComplaintExaminedAndSettled

    task ExamineComplaint
      > or ComplaintExaminedBySpecialist
    pre {[
      self.phase = ComplaintPhase::ARTIFACTS_UPDATED
    ]}
    post {[
      self.phase = ComplaintPhase::EXAMINATION_COMPLETE
    ]}

    task DecideRefund
      > or RefundApprovedByManager
    pre {[
      self.phase = ComplaintPhase::EXAMINATION_COMPLETE
    ]}
    post {[
      self.phase = ComplaintPhase::REFUND_APPROVED
    ]}

    task RecordRefundAndClose
      > or ComplaintResolvedAndClosed
    pre {[
      self.phase = ComplaintPhase::REFUND_APPROVED
    ]}
    post {[
      self.phase = ComplaintPhase::CLOSED
    ]}
  }

  role Examiner {

    task ConductExamination
    pre {[
      self.phase = ComplaintPhase::UNDER_EXAMINATION
    ]}
    post {[
      self.ExaminationRecord->notEmpty()
    ]}
  }

  depend ComplaintCase.SpecialistExaminationReceived
    -> goal ComplaintExaminedByExaminer
    -> Examiner.ConductExamination
}
