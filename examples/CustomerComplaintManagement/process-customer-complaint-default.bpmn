    <bpmn:sequenceFlow id="Process_CCM_f6" sourceRef="Gw_route" targetRef="Act_nu_exam" />
    <bpmn:sequenceFlow id="Process_CCM_f7" sourceRef="Gw_route" targetRef="Act_lm_exam" />
    <bpmn:sequenceFlow id="Process_CCM_f9" name="Yes" sourceRef="Gw_cm_req" targetRef="Act_nu_exam" />
    <bpmn:sequenceFlow id="Process_CCM_f10" name="No" sourceRef="Gw_cm_req" targetRef="Gw_examdone" />
    <bpmn:sequenceFlow id="Process_CCM_f11" sourceRef="Act_nu_exam" targetRef="Gw_nu_req" />
    <bpmn:sequenceFlow id="Process_CCM_f12" name="Yes" sourceRef="Gw_nu_req" targetRef="Act_lm_exam" />
