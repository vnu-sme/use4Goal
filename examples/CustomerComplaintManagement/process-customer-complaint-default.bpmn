        <bpmn:flowNodeRef>Gw_cm_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_cm_sugg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_cm_appr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_CCM_lane2" name="Nutritionist">
        <bpmn:flowNodeRef>Act_nu_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_nu_req</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_CCM_lane3" name="Lab Manager">
        <bpmn:flowNodeRef>Act_lm_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_lm_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_lm_qio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_lm_improve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_lm_merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_CCM_lane4" name="CFO">
        <bpmn:flowNodeRef>Act_cfo_sugg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_cfo_appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_cfo_complex</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_CCM_lane5" name="CEO">
        <bpmn:flowNodeRef>Act_ceo_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ceo_appr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_CCM_lane6" name="Accountment">
        <bpmn:flowNodeRef>Gw_refund_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_acc_update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Process_CCM_f0" sourceRef="StartEvent_1" targetRef="Act_create" />
    <bpmn:sequenceFlow id="Process_CCM_f1" sourceRef="Act_create" targetRef="Act_updartifacts" />
