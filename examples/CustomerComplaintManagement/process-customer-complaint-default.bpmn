    </bpmn:startEvent>
    <bpmn:task id="Act_create" name="Creating complaint">
      <bpmn:incoming>Process_CCM_f0</bpmn:incoming>
      <bpmn:outgoing>Process_CCM_f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_updartifacts" name="Updating artifacts">
