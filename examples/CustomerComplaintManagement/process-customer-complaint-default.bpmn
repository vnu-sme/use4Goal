      <bpmn:outgoing>Process_CCM_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="Gw_examdone">
      <bpmn:incoming>Process_CCM_f10</bpmn:incoming>
