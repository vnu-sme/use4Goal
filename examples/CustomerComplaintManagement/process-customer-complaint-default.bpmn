<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_CCM" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.27.0">
  <bpmn:collaboration id="Process_CCM_collab">
    <bpmn:participant id="Process_CCM_p" name="Customer Complaint Management" processRef="Process_CCM" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CCM" isExecutable="false">
    <bpmn:laneSet id="Process_CCM_ls">
      <bpmn:lane id="Process_CCM_lane0" name="Field Man">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_updartifacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_examdone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_reqexam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_comp</bpmn:flowNodeRef>
