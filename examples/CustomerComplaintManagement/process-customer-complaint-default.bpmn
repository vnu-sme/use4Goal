      <bpmn:outgoing>Process_CCM_f9</bpmn:outgoing>
      <bpmn:outgoing>Process_CCM_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Process_CCM_f4" name="Yes" sourceRef="Gw_reqexam" targetRef="Gw_route" />
    <bpmn:sequenceFlow id="Process_CCM_f5" sourceRef="Gw_route" targetRef="Act_cm_exam" />
    <bpmn:sequenceFlow id="Process_CCM_f8" sourceRef="Act_cm_exam" targetRef="Gw_cm_req" />
