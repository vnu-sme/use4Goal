        <bpmn:flowNodeRef>Gw_updcompl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_updcompl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_CCM_lane1" name="Customer Manager">
