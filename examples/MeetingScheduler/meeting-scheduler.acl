acl v4.0 MeetingScheduler {

    datatype DateTime;

    enum CollectionStatus {
        NOT_REQUESTED,
        REQUESTED,
        COLLECTED
    }

    enum NotificationStatus {
        NOT_SENT,
        SENT
    }

    enum MeetingPhase {
        REQUESTED,
        CONSTRAINTS_REQUESTED,
        CONSTRAINTS_COLLECTED,
        DATE_CHOSEN,
        NOTIFIED,
        HELD,
        CANCELLED
    }

    role MeetingParty {
        partyName : String;
        phone : String optional;
    }

    orgContext MeetingUnit {
        attribute meetingId : Integer required;
        attribute phase : MeetingPhase required mutable default REQUESTED;
        attribute proposedFromDay : Integer required;
        attribute proposedToDay : Integer required;
        attribute chosenDay : Integer required mutable default 0;

        role Initiator specializes MeetingParty;
        role Organizer specializes MeetingParty;
        role Secretary specializes MeetingParty;
        role Participant specializes MeetingParty;

        entity TimetableResponse {
            attribute earliestDay : Integer required;
            attribute latestDay : Integer required;
            attribute status : CollectionStatus required;
        }

        entity PhoneContact {
            attribute phoneNumber : String required;
        }

        entity MeetingNotification {
            attribute status : NotificationStatus required;
            attribute sentAt : DateTime required;
        }
    }

    composition UnitTimetables {
        MeetingUnit [1] role unit;
        TimetableResponse [0..*] role timetables;
    }

    association ParticipantTimetable {
        Participant [1] role participant;
        TimetableResponse [0..1] role timetable;
    }

    association SecretaryContacts {
        Secretary [1] role secretary;
        PhoneContact [0..*] role contacts;
    }

    association ContactForParticipant {
        Participant [1] role participant;
        PhoneContact [0..1] role phoneContact;
    }

    composition UnitNotifications {
        MeetingUnit [1] role unit;
        MeetingNotification [0..*] role notifications;
    }

    context MeetingUnit inv ChosenDayInWindow:
        self.chosenDay = 0 or (
            self.chosenDay >= self.proposedFromDay and
            self.chosenDay <= self.proposedToDay
        );
}
