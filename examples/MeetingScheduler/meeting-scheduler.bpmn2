model MeetingSchedulerProcess {

  pool MeetingOrganization for MeetingUnit {
    name "Meeting Scheduling Organization"
    lane Initiator;
    lane Organizer;
    lane Participant;
  }

  start meetingRequested {
    name "Meeting requested"
    lane Initiator
    trigger none

    pre {[
      self.phase = MeetingPhase::REQUESTED
    ]}

    flow requestConstraints
  }

  activity requestConstraints {
    name "Request constraints"
    type task
    lane Organizer

    pre {[
      self.phase = MeetingPhase::REQUESTED
    ]}

    post {[
      self.phase = MeetingPhase::CONSTRAINTS_REQUESTED
    ]}

    flow collectConstraints
  }

  activity collectConstraints {
    name "Collect constraints"
    type task
    lane Participant

    pre {[
      self.phase = MeetingPhase::CONSTRAINTS_REQUESTED
    ]}

    post {[
      self.phase = MeetingPhase::CONSTRAINTS_COLLECTED
    ]}

    flow selectDate
  }

  activity selectDate {
    name "Select meeting date"
    type task
    lane Organizer

    pre {[
      self.phase = MeetingPhase::CONSTRAINTS_COLLECTED
    ]}

    post {[
      self.phase = MeetingPhase::DATE_CHOSEN
    ]}

    flow notifyParticipants
  }

  activity notifyParticipants {
    name "Notify participants"
    type task
    lane Organizer

    pre {[
      self.phase = MeetingPhase::DATE_CHOSEN
    ]}

    post {[
      self.phase = MeetingPhase::NOTIFIED
    ]}

    flow holdMeeting
  }

  activity holdMeeting {
    name "Hold meeting"
    type task
    lane Participant

    pre {[
      self.phase = MeetingPhase::NOTIFIED
    ]}

    post {[
      self.phase = MeetingPhase::HELD
    ]}

    flow meetingHeld
  }

  end meetingHeld {
    name "Meeting held"
    lane Participant
    trigger none
  }
}
