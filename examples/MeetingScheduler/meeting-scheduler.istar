// MeetingScheduler intentional model.
//
// OCL context convention: self : MeetingUnit

istar MeetingSchedulerGoals {

  agent MeetingUnit {

    goal MeetingScheduledAndHeld : Achieve

    goal MeetingPreparedAndNotified : Achieve
      > or MeetingScheduledAndHeld

    goal MeetingRequestedAndInitiated : Sustain
      > or MeetingScheduledAndHeld

    goal TimetablesCollectedFromParticipants : None
      > or MeetingPreparedAndNotified

    goal TimetablesReceivedFromParticipants : None
      > or MeetingPreparedAndNotified

    goal MeetingDateChosen : Achieve
      > or MeetingPreparedAndNotified
    condition {[
      self.chosenDay > 0
    ]}

    goal ParticipantsNotified : Achieve
      > or MeetingPreparedAndNotified
    condition {[
      self.phase = MeetingPhase::NOTIFIED
    ]}

    task RequestConstraints
      > or TimetablesCollectedFromParticipants
    pre {[
      self.phase = MeetingPhase::REQUESTED
    ]}
    post {[
      self.phase = MeetingPhase::CONSTRAINTS_REQUESTED
    ]}

    task SelectDate
      > or MeetingDateChosen
    pre {[
      self.phase = MeetingPhase::CONSTRAINTS_COLLECTED
    ]}
    post {[
      self.phase = MeetingPhase::DATE_CHOSEN
    ]}

    task NotifyParticipants
      > or ParticipantsNotified
    pre {[
      self.phase = MeetingPhase::DATE_CHOSEN
    ]}
    post {[
      self.phase = MeetingPhase::NOTIFIED
    ]}

    task HoldMeeting
      > or MeetingScheduledAndHeld
    pre {[
      self.phase = MeetingPhase::NOTIFIED
    ]}
    post {[
      self.phase = MeetingPhase::HELD
    ]}
  }

  role Participant {

    task ProvideTimetable
    pre {[
      self.phase = MeetingPhase::CONSTRAINTS_REQUESTED
    ]}
    post {[
      self.TimetableResponse->notEmpty()
    ]}
  }

  depend MeetingUnit.TimetablesReceivedFromParticipants
    -> goal TimetableProvidedByParticipant
    -> Participant.ProvideTimetable
}
