// Bounded-verification scope for the ProposalReview case study
// (proposal-review-final.acl / .istar / .bpmn2).
acl-bpmn-boundary v1.0 ProposalReviewBound {
  snapshots 16;
  loop-bound 1;
  integer -1..4;

  objects ProposalParticipant 4;
  objects Proposal 2;
  objects ProposalManager 2;
  objects Customer 2;
  // Entities and their links are created during execution; these are per-state bounds.
  objects ProposalRevision 0..4;
  objects Validation 0..4;
  objects Review 0..4;

  links RevisionValidations 0..4;
  links RevisionReviews 0..4;
  links ProposalManagerValidates 0..4;
  links CustomerProvidesReview 0..4;
}
