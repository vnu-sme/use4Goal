        <mxCell id="n5a" value="&lt;Lang&gt;LayoutBuilder&#10;[ADAPTER]&#10;MM element -&gt; Node/Edge" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
