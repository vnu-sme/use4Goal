        <mxCell id="viewnote" value="Ghi chu: day la THIET KE DE XUAT (chua co trong code hien tai). istar/bpmn2 hien nay goi thang View.setModel(mm) va View tu tinh layout — xem doc/02 cho hien trang tung ngon ngu." style="text;fontSize=10;fontStyle=2;align=left;fontColor=#333333;" vertex="1" parent="1">
