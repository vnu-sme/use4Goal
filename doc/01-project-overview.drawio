        <!-- Step 3: MM -->
        <mxCell id="n3" value="&lt;Lang&gt;Model (MM)&#10;record / sealed interface" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="640" y="300" width="240" height="55" as="geometry"/>
