        <mxCell id="n5c" value="&lt;Lang&gt;View&#10;[RENDERER]&#10;JPanel + Graphics2D, chi ve" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
