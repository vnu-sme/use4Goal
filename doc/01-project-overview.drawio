        <mxCell id="n4c" value="&lt;LANG&gt;Compiler&#10;Result(model, errors) record" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="640" y="460" width="240" height="55" as="geometry"/>
