        <mxCell id="mmnote" value="MM KHONG import ast/ hay view/ — dependency 1 chieu: view -&gt; mm &lt;- factory &lt;- ast" style="text;fontSize=10;fontStyle=2;align=left;fontColor=#333333;" vertex="1" parent="1">
