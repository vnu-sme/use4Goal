        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="n4a" target="n4b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="n4b" target="n4c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="n4c" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5b" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="n3" target="n4a"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Step 5: View — Adapter / Layout / Render -->
        <mxCell id="viewbox" value="View — 3 tang tach biet (Adapter -&gt; Layout -&gt; Render), giong ClassDiagramView/PlaceableNode/DirectedGraph cua USE core" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="820" height="180" as="geometry"/>
