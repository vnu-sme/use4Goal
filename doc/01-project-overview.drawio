<mxfile host="app.diagrams.net">
  <diagram id="overview" name="Generic Plugin Architecture">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Kien truc CHUNG cho moi plugin ngon ngu trong goal/ (khong phai instance cu the — xem doc/02 cho ban ve tung ngon ngu)" style="text;fontSize=15;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1300" height="30" as="geometry"/>
        </mxCell>

        <!-- ============ USE Platform loading mechanism (generic, accurate) ============ -->
        <mxCell id="usebox" value="USE Platform — co che nap plugin (KHONG duoc sua file nao trong use/)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="1300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="use1" value="Main.java nap MainPluginRuntime, quet thu muc plugin tim *.jar" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="290" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="use2" value="PluginRegistry (Singleton) mo jar, doc useplugin.xml bang SAX parser (PluginParser)" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="290" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="use3" value="ActionExtensionPoint dang ky action theo PluginActionModel da parse" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="290" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="use4" value="PluginClassLoader rieng cho tung plugin jar — nap class Java that CHI KHI can (lazy)" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="970" y="100" width="330" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="use1" target="use2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="use2" target="use3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="use3" target="use4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="usenote" value="Chi tiet class/file cu the: doc/use-core-design-rules.md muc 1. Khong co API/hook nao yeu cau sua code trong use/." style="text;fontSize=10;fontStyle=2;align=left;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="900" height="24" as="geometry"/>
        </mxCell>

        <mxCell name="hookarrow" id="hookarrow" value="useplugin.xml + IPluginActionDelegate — ranh gioi duy nhat giua USE core va plugin" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=11;fontStyle=1;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="usebox" target="langbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============ Generic <Lang> plugin module template ============ -->
        <mxCell id="langbox" value="goal/&lt;lang&gt;/  — khuon chung ap dung cho MOI ngon ngu (iStar, BPMN2, va ngon ngu tuong lai)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="1300" height="980" as="geometry"/>
        </mxCell>

        <!-- Step 1: grammar -->
        <mxCell id="n1" value="&lt;LANG&gt;.g4&#10;(grammar ANTLR4)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="[VISITOR]&#10;ANTLR BaseVisitor" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;dashed=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="365" width="220" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 2: AST -->
        <mxCell id="n2" value="&lt;Lang&gt;BuildingVisitor&#10;-&gt; &lt;Lang&gt;*CS (AST)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="240" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="[FACTORY]&#10;&lt;Lang&gt;ModelFactory.build(cs)" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;dashed=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="365" width="240" height="40" as="geometry"/>
