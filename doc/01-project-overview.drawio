        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Step 4: Action/Form/Compiler -->
        <mxCell id="n4a" value="ActionOpen&lt;Lang&gt;&#10;implements IPluginActionDelegate" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
