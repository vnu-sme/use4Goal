                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="[Pattern: BUILDER / STRATEGY — day la BUOC HIEN CHUA CO trong code]&#10;&lt;lang&gt;LayoutBuilder.build(MM model): DiagramLayout&#10;dung RefineSpecVisitor&lt;layoutfragment&gt; de tinh vi tri/canh theo tung loai refine&#10;&#10;DiagramLayout la POJO thuan: List&lt;node{id,x,y,w,h,kind}&gt;, List&lt;edge{from,to,style}&gt;&#10;KHONG phu thuoc Swing/Graphics2D -&amp;gt; test duoc doc lap, tai su dung cho renderer khac (SVG, in an)&lt;/edge{from,to,style}&gt;&lt;/node{id,x,y,w,h,kind}&gt;&lt;/layoutfragment&gt;&lt;/lang&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#000000;fontSize=11;align=left;spacingLeft=8;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
