                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="branchA" value="[Pattern: VISITOR / STRATEGY]&#10;interface RefineSpecVisitor&lt;r&gt; { R seq(...); R par(...); R xor(...); R ior(...); R iter(...); }&#10;GoalToBpmnTransformer implements RefineSpecVisitor&lt;fragment&gt;&#10;&#10;Nghiep vu: MM (MAXGoalModel) --&amp;gt; MM ngon ngu khac (BpmnProcess)&#10;Day la buoc \&quot;ve nghiep vu da xong\&quot; ban da co (GoalToBpmnTransformer)&#10;-- chi can chuan hoa switch thanh interface Visitor dung chung&lt;/fragment&gt;&lt;/r&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#000000;fontSize=11;align=left;spacingLeft=8;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="380" width="380" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="eA" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;fontColor=#000000;strokeColor=#000000;" parent="1" source="s4" target="branchA" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s4b" value="MM dich (vd: BpmnProcess) — co the tiep tuc di qua nhanh B rieng de hien thi" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#000000;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="540" width="380" height="50" as="geometry"/>
