                </mxCell>
                <mxCell id="s6" value="View — &lt;lang&gt;View extends JPanel&#10;paintComponent(Graphics2D) CHI render DiagramLayout (khong tu tinh layout nua)&#10;xu ly input: drag/zoom/select&lt;/lang&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#000000;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
