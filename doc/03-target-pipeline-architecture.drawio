                <mxCell id="s3" value="AST — CS records (bat buoc cho MOI ngon ngu, ke ca MAXGoal)&#10;vd: GoalDefCS, TaskDefCS, RefineSpecCS..." style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#000000;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
