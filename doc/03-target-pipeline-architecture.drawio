                <mxCell id="p2" value="[Pattern: FACTORY METHOD]&#10;interface ModelFactory&lt;cs,mm&gt; { MM build(CS cs); }&#10;moi ngon ngu implement 1 lan, khong duplicate tu do&lt;/cs,mm&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#000000;fontSize=11;dashed=1;fontColor=#000000;" parent="1" vertex="1">
