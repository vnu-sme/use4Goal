                </mxCell>
                <mxCell id="p5" value="Khong doi: Action (IPluginActionDelegate, nhan Session+MainWindow) -&amp;gt; Form (JDialog, non-modal) -&amp;gt; Compiler (Result record: model + errors)&#10;— cac lop nay da dung khuon tot o iStar/BPMN2, chi can bo sung tuong tu cho MAXGoal + rieng cho MAXBpmn (hien dang dung ke MAXGoalForm)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#000000;fontSize=11;align=left;spacingLeft=8;fontColor=#000000;" parent="1" vertex="1">
