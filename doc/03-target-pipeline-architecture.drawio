                <mxCell id="p1" value="[Pattern: VISITOR]&#10;&lt;lang&gt;BaseVisitor (ANTLR sinh)&#10;implemented boi &lt;lang&gt;AstBuildingVisitor&lt;/lang&gt;&lt;/lang&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#000000;fontSize=11;dashed=1;fontColor=#000000;" parent="1" vertex="1">
