                </mxCell>
                <mxCell id="s4" value="MetaModel (MM) — record / sealed interface&#10;vd: MAXGoalModel, RefineSpec(sealed: Seq/Par/Xor/Ior/Iter)&#10;KHONG import AST, KHONG import View" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#000000;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
