                <mxCell id="p4" value="[Pattern: TABLE-DRIVEN LOOKUP]&#10;abstract EnumLookup&lt;t extends=&quot;&quot; enum&lt;t=&quot;&quot;&gt;&amp;gt; { T from(String) qua Map co san }&#10;dung chung cho ActorKind, ResKind, GatewayType, EventType, ContribType, AssocKind&#10;thay vi moi enum tu viet lai ham from(String) rieng le&lt;/t&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#000000;fontSize=11;dashed=1;align=left;spacingLeft=8;fontColor=#000000;" parent="1" vertex="1">
