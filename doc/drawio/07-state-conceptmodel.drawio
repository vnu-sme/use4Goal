                    <mxGeometry x="766" y="175" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sc-note-safe" value="Safe-net assumption (section 3.3.2): at most 1 token per arc.&#10;For DCR the equivalent state is DcrMarking per event&#10;(executed, included, pending) — see 06-dcr-metamodel.drawio." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;size=16;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
