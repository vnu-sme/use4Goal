                <mxCell id="sc-note-domain" value="Value domain (Definition 3.1): Delta = {bottom, top, ?}. E := Delta (+) (Delta x Delta).&#10;GoalTaskStatus corresponds to {(?,?), (top,bottom), (top,top)} = unknown / fulfilled / pending.&#10;QualityStatus corresponds to Delta = unknown / fulfilled(top) / denied(bottom)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;size=16;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
