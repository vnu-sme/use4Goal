                <mxCell id="v33" value="&lt;div style=&quot;font-family:Helvetica;font-size:12px;text-align:left&quot;&gt;&lt;b&gt;Design-time proof obligation&lt;/b&gt;&lt;br/&gt;Postcondition:&lt;br/&gt;  self.status = APPROVED&lt;br/&gt;&lt;br/&gt;GoalCondition:&lt;br/&gt;  self.status = APPROVED&lt;br/&gt;&lt;br/&gt;Therefore:&lt;br/&gt;  post(Order::approve) =&amp;gt; goal(Order is approved)&lt;br/&gt;&lt;br/&gt;Conclusion: the BPMN Task guarantees achievement of the Goal.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
