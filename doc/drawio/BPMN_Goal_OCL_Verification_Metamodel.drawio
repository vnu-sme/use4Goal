                </mxCell>
                <mxCell id="v184" value="&lt;div style=&quot;font-family:Helvetica;font-size:12px;text-align:left&quot;&gt;&lt;b&gt;Core verification semantics&lt;/b&gt;&lt;br/&gt;Concrete execution:&lt;br/&gt;pre(op, s) and post(op, s, s&amp;#x27;) and goal(g, s&amp;#x27;)&lt;br/&gt;&lt;br/&gt;Design-time guarantee:&lt;br/&gt;for all valid s,s&amp;#x27;: pre(op,s) and post(op,s,s&amp;#x27;) implies goal(g,s&amp;#x27;)&lt;br/&gt;&lt;br/&gt;Equivalent proof obligation:&lt;br/&gt;Operation.postcondition =&amp;gt; Goal.satisfactionCondition&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="900" width="680" height="245" as="geometry"/>
                </mxCell>
                <mxCell id="v185" value="&lt;div style=&quot;font-family:Helvetica;font-size:12px;text-align:left&quot;&gt;&lt;b&gt;Result interpretation&lt;/b&gt;&lt;br/&gt;ACHIEVED: postcondition guarantees the goal condition.&lt;br/&gt;CONTRIBUTED: operation establishes only part of the goal.&lt;br/&gt;NOT_ACHIEVED: goal is not guaranteed after the operation.&lt;br/&gt;VIOLATED: operation guarantees the negation of the goal.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="1180" width="680" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="v186" value="&lt;div style=&quot;font-family:Helvetica;font-size:12px;text-align:left&quot;&gt;&lt;b&gt;Scope of this metamodel&lt;/b&gt;&lt;br/&gt;This extension verifies whether one BPMN Activity, through its mapped DomainOperation, changes a domain state so that a Goal becomes satisfied.&lt;br/&gt;Token-flow verification, deadlock freedom and temporal properties require a separate execution/trace semantics.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="1370" width="680" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
