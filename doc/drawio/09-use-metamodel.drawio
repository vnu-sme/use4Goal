                <mxCell id="N1" value="Conceptually an AssociationClass is both&#10;a Class and an Association.&#10;&#10;In the Java code this is NOT multiple&#10;inheritance (impossible in Java): MAssociationClassImpl&#10;extends only MClassifierImpl and DELEGATES to a&#10;private MClassImpl + MAssociationImpl pair." style="shape=note;whiteSpace=wrap;html=0;fillColor=#fff9c4;strokeColor=#999999;fontColor=#333333;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="1181" y="725" width="280" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="g3" style="strokeColor=#000000;endArrow=block;endSize=16;endFill=0;html=1;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontColor=#000000;" parent="1" source="MDataType" target="MClassifier" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="N2" value="In the reference UML metamodel, DataType is&#10;normally a leaf (Enumeration / PrimitiveType) with&#10;no attributes or operations of its own.&#10;&#10;USE deliberately goes further: a dataType CAN declare&#10;an 'operations' section (constructor + methods), e.g.&#10;examples/Documentation/Datatypes/Currency.use ':&#10;  dataType Amount operations Amount(amount:Real, ...)&#10;Its attributes come from that constructor's parameters,&#10;not from a separate 'attributes' section.&#10;Left off the main diagram to match standard semantics." style="shape=note;whiteSpace=wrap;html=0;fillColor=#fff9c4;strokeColor=#999999;fontColor=#333333;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="990" y="770" width="300" height="170" as="geometry"/>
                </mxCell>
