// Expected final marking after the BPMN effects have completed.
// Instance ids match AOL role-instance ids, so every actor binding is explicit.

scenario MeetingSchedulerExpected for "meeting_scheduler.istar" {
  instance initiatorAlice : Initiator;
  instance organizerBob : Organizer;
  instance secretaryBob : Secretary;
  instance participantAlice, participantCarol : Participant;

  fire initiatorAlice.DecideMeetingDetails;
  fire organizerBob.ChooseTimeAndDate;

  fire participantAlice.CollectFromCalendar;
  fire secretaryBob.CollectConstraintsByPhone;
  assign participantCarol.CollectFromCalendar = Pending;
  assign participantAlice.QuickScheduling = True;

  fire participantAlice.AnnounceMeeting;
  fire participantCarol.AnnounceMeeting;
  fire participantAlice.Participate;
  fire participantCarol.Participate;

  assign participantAlice.TimetableCollected = Fulfilled;
  assign participantCarol.TimetableCollected = Fulfilled;
  assign participantAlice.MeetingAttendedByParticipant = Fulfilled;
  assign participantCarol.MeetingAttendedByParticipant = Fulfilled;
  assign HaveSchedulingPerformedByOrganizer = Fulfilled;

  assign participantAlice.HavePPCalled = Pending;
  assign participantCarol.HavePPCalled = Fulfilled;

  assign initiatorAlice.HaveMeetingOrganized = Fulfilled;
  assign organizerBob.HaveMeetingScheduled = Fulfilled;
}
