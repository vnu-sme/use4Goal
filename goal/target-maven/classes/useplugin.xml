                menuitem="ACL Model Viewer"
                toolbaritem="ACL Viewer"
                id="org.vnu.sme.goal.acl.action.ActionOpenAcl">
        </action>
        <action label="AOL Object Model Viewer"
                icon="images/acl.png"
                class="org.vnu.sme.goal.aol.action.ActionOpenAol"
