// iStar 2.0 — Harder example 5: reversed nesting order
// G1 <-AND- {G2, G3}
//   G2 <-pick(C)- G2P <-forall(C)- G2PF <-AND- {K1,K2}   (pick -> forall, reverse of example 3)
//   G3 <-OR- {K3, K4}                                     (plain OR alternative)
// Combine: K2 and K4 each carry two rel clauses at once (refine + contribute)

istar Example5 {

  role C {
    task     K10
    resource R5
  }

  agent B {
    quality Q5
  }

  agent A {
    goal G1                         // root, AND of G2 and G3

    goal G2 > G1
    goal G3 > G1

    goal G2P  > pick C G2           // pick first this time
    goal G2PF > forall C G2P        // then forall nested underneath the pick

    task K1 > G2PF
    task K2 > G2PF > break Q1       // AND: G2PF needs K1 and K2; K2 also hurts(break) Q1

    task K3 > or G3
    task K4 > or G3 > make Q1       // OR: G3 satisfied by K3 or K4; K4 also makes Q1

    quality Q1
  }

  depend A.G2P  -> task     K10 -> C.K10
  depend A.G2PF -> resource R5  -> C.R5
  depend A      -> quality  Q5  -> B
}
