// iStar 2.0 — Harder example 4: sibling combination under one OR
// G1 <-OR- {G2, G3}
//   G2 <-AND- {G4, G5}
//     G4 <-forall(C)- G4F <-pick(C)- G4FP <-AND- {K1,K2}   (forall -> pick, nested)
//     G5 <-OR- {K3, K4}                                     (plain OR, sibling of the chain above)
//   G3 <-forall(B)- G3F <-AND- {K5,K6}          (quantify over a concrete agent, not just a role)

istar Example4 {

  agent B {
    goal G9
    task K9
  }

  role C {
    quality Q3
    task    K10
    goal    G10
  }

  agent A {
    goal G1                        // root: satisfied by G2 OR G3

    goal G2 > or G1
    goal G3 > or G1

    goal G4 > G2
    goal G5 > G2                   // AND: G2 needs both G4 and G5

    goal G4F  > forall C G4        // forall over role C
    goal G4FP > pick C G4F         // pick over role C, nested inside the forall branch

    task K1 > G4FP > help Q1
    task K2 > G4FP                 // AND: G4FP needs both K1 and K2; K1 also helps Q1

    task K3 > or G5
    task K4 > or G5                // OR at the same depth as the forall/pick branch above

    goal G3F > forall B G3         // forall over a concrete agent (combine role- and agent-typed quantification)

    task K5 > G3F
    task K6 > G3F                  // AND: G3F needs both K5 and K6

    quality Q1
  }

  depend A.G4F  -> goal G10 -> C.G10
  depend A.G4FP -> task K10 -> C.K10
  depend A.G3F  -> goal G9  -> B.G9
  depend A      -> task K9  -> B
}
