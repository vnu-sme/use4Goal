dcr ConstructionPermit {
  event e1 "Register";
  event e2 "Assess";
  event e3 "Approve";
  event e4 "Deny";

  marking e1: included;
  marking e2: ;
  marking e3: ;
  marking e4: ;

  condition e1 after 0 -> e2;
  condition e2 after 0 -> e3;
  condition e2 after 0 -> e4;

  response e1 within omega -> e2;

  include e1 -> e2;
  include e1 -> e3;
  include e1 -> e4;

  exclude e3 -> e3;
  exclude e3 -> e4;
  exclude e4 -> e3;
  exclude e4 -> e4;
}
