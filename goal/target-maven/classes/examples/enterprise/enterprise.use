self.target_Reviewer_plays_Auditor->forAll(r1 : Auditor |
self.target_Reviewer_plays_ComplianceOfficer->forAll(r2 : ComplianceOfficer |
      not (r1.source_Auditor_in_AuditCommittee = r2.source_ComplianceOfficer_in_AuditCommittee or r1.source_Auditor_in_AuditCommittee.source_Owner_Corporation_AuditCommittee = r2.source_ComplianceOfficer_in_AuditCommittee.source_Owner_Corporation_AuditCommittee) or (r1.source_Auditor_in_AuditCommittee = r2.source_ComplianceOfficer_in_AuditCommittee)))

context Reviewer inv NoConflict_SeniorAuditor_ComplianceOfficer:
self.target_Reviewer_plays_Auditor->forAll(r1_a0 : Auditor |
r1_a0.target_Auditor_plays_SeniorAuditor->forAll(r1 : SeniorAuditor |
self.target_Reviewer_plays_ComplianceOfficer->forAll(r2 : ComplianceOfficer |
      not (r1.source_SeniorAuditor_in_AuditCommittee = r2.source_ComplianceOfficer_in_AuditCommittee or r1.source_SeniorAuditor_in_AuditCommittee.source_Owner_Corporation_AuditCommittee = r2.source_ComplianceOfficer_in_AuditCommittee.source_Owner_Corporation_AuditCommittee) or (r1.source_SeniorAuditor_in_AuditCommittee = r2.source_ComplianceOfficer_in_AuditCommittee))))

