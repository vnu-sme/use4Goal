// BPMN 2.0 Example — Job Application Review
// Paired with job_application_review.istar (3 actors -> 3 pools). Written against the
// current 'model ... { pool ... }' grammar (Bpmn2.g4), not the older 'collaboration'
// keyword still used by the other example .bpmn2 files in this directory tree.

model JobApplicationReview {

  pool CandidatePool {
    name "Candidate"
    start start_candidate { trigger none }    task submitApplication { name "Submit Application" }    task attendInterview { name "Attend Interview" }    end end_candidate { trigger none }
    flow start_candidate -> submitApplication
    flow submitApplication -> attendInterview
    flow attendInterview -> end_candidate
  }

  pool HRDepartmentPool {
    name "HR Department"
    lane screening_lane {
      name "Screening"
      start start_hr { trigger none }      task screenApplication { name "Screen Application" }      gateway gw_screen { type xor }      task rejectEarly { name "Reject Early" }      end end_rejected { trigger none }    }
    lane outcome_lane {
      name "Outcome"
      task notifyOutcome { name "Notify Outcome" }      end end_hr { trigger none }    }

    flow start_hr -> screenApplication
    flow screenApplication -> gw_screen
    flow gw_screen -> rejectEarly { name "not qualified" }    flow rejectEarly -> end_rejected
    flow gw_screen -> notifyOutcome { name "qualified" }    flow notifyOutcome -> end_hr
  }

  pool HiringManagerPool {
    name "Hiring Manager"
    start start_hm { trigger none }    task conductInterview { name "Conduct Interview" }    gateway gw_decision { type xor }    task makeOffer { name "Make Offer" }    task makeRejection { name "Make Rejection" }    end end_offer { trigger none }    end end_rejection { trigger none }
    flow start_hm -> conductInterview
    flow conductInterview -> gw_decision
    flow gw_decision -> makeOffer { name "hire" }    flow gw_decision -> makeRejection { name "no hire" }    flow makeOffer -> end_offer
    flow makeRejection -> end_rejection
  }

  message ApplicationMsg { name "Application submitted" }  message InterviewMsg { name "Interview invitation" }  message DecisionMsg { name "Hiring decision" }  message OutcomeMsg { name "Outcome notification" }
  message-flow submitApplication -> screenApplication { message ApplicationMsg }  message-flow screenApplication -> conductInterview { message InterviewMsg }  message-flow attendInterview -> makeOffer { message InterviewMsg }  message-flow makeOffer -> notifyOutcome { message DecisionMsg }  message-flow makeRejection -> notifyOutcome { message DecisionMsg }  message-flow notifyOutcome -> end_candidate { message OutcomeMsg }}
