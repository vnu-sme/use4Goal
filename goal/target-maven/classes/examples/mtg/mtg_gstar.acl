acl v2.0 ExtendedMeetingSchedulerState {
  // Person is an agent profile; the specialized roles below are occurrences
  // owned by a concrete MeetingUnit.
  role Person;
  role MeetingInitiator extends Person;
  role MeetingSchedulerSystem extends Person;

  role Participant extends Person {
    availabilityChecked : Boolean;
    availabilitySubmitted : Boolean;
    notified : Boolean;
    slotReviewed : Boolean;
    slotConfirmed : Boolean;
  }

  role CalendarService extends Person {
    available : Boolean;
    calendarDataRead : Boolean;
    calendarDataReturned : Boolean;
  }

  role RoomBookingService extends Person {
    availabilityChecked : Boolean;
    reservationConfirmed : Boolean;
    availableRooms : Integer;
    inventoryConsistent : Boolean;
  }

  role NotificationService extends Person {
    available : Boolean;
    channelSelected : Boolean;
    deliveryLogged : Boolean;
  }

  // One occurrence represents one meeting request throughout its lifecycle.
  group MeetingUnit {
    requestCreated : Boolean;
    requestValid : Boolean;
    requestRegistered : Boolean;
    availabilityRequestSent : Boolean;
    privacyPreserved : Boolean;
    intersectionComputed : Boolean;
    commonSlotAvailable : Boolean;
    candidateSlotProposed : Boolean;
    preferencesRespected : Boolean;
    roomReservationRequested : Boolean;
    roomAvailable : Boolean;
    roomReserved : Boolean;
    notificationsRequested : Boolean;
    scheduled : Boolean;
    invitationsIssued : Boolean;
    responseTimedOut : Boolean;
    rescheduleRequested : Boolean;
    cancelled : Boolean;
    reviewPerformed : Boolean;

    MeetingInitiator [1];
    MeetingSchedulerSystem [1];
    Participant [2..*];
    CalendarService [1];
    RoomBookingService [1];
    NotificationService [1];

    MeetingInitiator compatible Participant;
  }
}
