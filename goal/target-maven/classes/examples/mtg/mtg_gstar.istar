// Extended Meeting Scheduler case study.
//
// The actor and milestone structure is adapted from the gStar meeting-
// scheduling example, but this is an iStar model of this project:
//   * Obstacle and Operation are deliberately absent from our metamodel;
//   * adverse situations are ACL state predicates handled by ordinary Tasks;
//   * every Goal/Task contract reads the shared ACL state through OCL;
//   * every dependency composition-owns a concrete dependum.
//
// The companion ACL model will provide the state referenced below. This file
// is developed first so that the intentional structure is fixed before the
// organizational state and BPMN realization are expanded.
istar ExtendedMeetingScheduler {

  // Meeting initiator: requests the service and issues final invitations.
  role MeetingInitiator {
    goal MeetingArranged : Achieve
    activation {[
      true
    ]}

    goal RequestInitiated : Achieve > MeetingArranged
    condition {[
      self.group.requestCreated
    ]}

    task CreateMeetingRequest
      > MeetingArranged
      > make RequestUsability
    pre {[
      not self.group.requestCreated
    ]}
    post {[
      self.group.requestCreated
    ]}

    goal InvitationsIssued : Achieve > MeetingArranged
    condition {[
      self.group.invitationsIssued
    ]}

    task SendInvitations
      > MeetingArranged
      > help RequestUsability
    pre {[
      self.group.scheduled
      and not self.group.invitationsIssued
    ]}
    post {[
      self.group.invitationsIssued
    ]}

    goal PreferredDateRespected : Maintain
    activation {[
      self.group.candidateSlotProposed
    ]}
    condition {[
      self.group.preferencesRespected
    ]}

    resource MeetingRequestData > needed-by CreateMeetingRequest
    resource InvitationList > needed-by SendInvitations
    quality RequestUsability > qualifies MeetingArranged
  }

  // Central system actor. RequestResolved is activated through the incoming
  // dependency, hence it deliberately has no local activation.
  role MeetingSchedulerSystem {
    // The request is resolved either normally or through controlled recovery.
    goal RequestResolved : Achieve
    goal NominalScheduling : Achieve > or RequestResolved
    goal RecoveryCompleted : Achieve > or RequestResolved

    // NominalScheduling is an AND-refinement describing the milestone chain.
    goal RequestRegistered : Achieve > NominalScheduling
    condition {[
      self.group.requestRegistered
    ]}

    task ValidateMeetingRequest > RequestRegistered
    pre {[
      self.group.requestCreated
      and not self.group.requestRegistered
    ]}
    post {[
      self.group.requestValid
    ]}

    task AcceptMeetingRequest > RequestRegistered
    pre {[
      self.group.requestValid
      and not self.group.requestRegistered
    ]}
    post {[
      self.group.requestRegistered
    ]}

    task SendAvailabilityRequests
      > NominalScheduling
      > help Timeliness
    pre {[
      self.group.requestRegistered
      and not self.group.availabilityRequestSent
    ]}
    post {[
      self.group.availabilityRequestSent
    ]}

    task ProtectAvailabilityData
      > NominalScheduling
      > make Privacy
    pre {[
      self.group.requestRegistered
    ]}
    post {[
      self.group.privacyPreserved
    ]}

    goal AllAvailabilityReceived : Achieve > NominalScheduling

    // One occurrence is evaluated for every Participant in this MeetingUnit.
    goal ParticipantAvailabilityReceived : Achieve
      > forall Participant AllAvailabilityReceived
    condition {[
      self.availabilitySubmitted
    ]}

    goal CandidateSlotProposed : Achieve > NominalScheduling
    condition {[
      self.group.candidateSlotProposed
    ]}

    task ComputeAvailabilityIntersection
      > CandidateSlotProposed
      > help Fairness
    pre {[
      self.group.Participant->forAll(participant |
        participant.availabilitySubmitted)
    ]}
    post {[
      self.group.intersectionComputed
    ]}

    task ProposeCandidateSlot
      > CandidateSlotProposed
      > make Fairness
    pre {[
      self.group.intersectionComputed
      and self.group.commonSlotAvailable
    ]}
    post {[
      self.group.candidateSlotProposed
      and self.group.preferencesRespected
    ]}

    goal RoomReserved : Achieve > NominalScheduling
    condition {[
      self.group.roomReserved
    ]}

    task RequestRoomReservation > RoomReserved
    pre {[
      self.group.candidateSlotProposed
      and not self.group.roomReservationRequested
    ]}
    post {[
      self.group.roomReservationRequested
    ]}

    task RecordRoomReservation > RoomReserved
    pre {[
      self.group.roomReservationRequested
      and self.group.roomAvailable
    ]}
    post {[
      self.group.roomReserved
    ]}

    task RequestParticipantNotifications
      > NominalScheduling
      > help Timeliness
    pre {[
      self.group.roomReserved
      and not self.group.notificationsRequested
    ]}
    post {[
      self.group.notificationsRequested
    ]}

    goal AllParticipantsNotified : Achieve > NominalScheduling
    goal ParticipantNotified : Achieve
      > forall Participant AllParticipantsNotified
    condition {[
      self.notified
    ]}

    goal AllParticipantsConfirmed : Achieve > NominalScheduling
    goal ParticipantConfirmed : Achieve
      > forall Participant AllParticipantsConfirmed
    condition {[
      self.slotConfirmed
    ]}

    task FinalizeMeeting
      > NominalScheduling
      > make Timeliness
    pre {[
      self.group.roomReserved
      and self.group.Participant->forAll(participant |
        participant.notified and participant.slotConfirmed)
    ]}
    post {[
      self.group.scheduled
    ]}

    // gStar obstacles become state predicates and explicit recovery Tasks;
    // they are not Obstacle intentional elements in this metamodel.
    goal RescheduleRequested : Achieve > or RecoveryCompleted
    condition {[
      self.group.rescheduleRequested
    ]}

    goal RequestCancelled : Achieve > or RecoveryCompleted
    condition {[
      self.group.cancelled
    ]}

    task HandleParticipantTimeout > make RecoveryResilience
    pre {[
      self.group.availabilityRequestSent
      and self.group.responseTimedOut
      and not self.group.scheduled
    ]}
    post {[
      self.group.rescheduleRequested
    ]}

    task HandleNoCommonSlot > make RecoveryResilience
    pre {[
      self.group.intersectionComputed
      and not self.group.commonSlotAvailable
    ]}
    post {[
      self.group.rescheduleRequested
    ]}

    task HandleRoomUnavailable > help RecoveryResilience
    pre {[
      self.group.roomReservationRequested
      and not self.group.roomAvailable
    ]}
    post {[
      self.group.rescheduleRequested or self.group.cancelled
    ]}

    task CancelUnresolvableRequest > make RecoveryResilience
    pre {[
      self.group.rescheduleRequested
      and not self.group.scheduled
    ]}
    post {[
      self.group.cancelled
    ]}

    // The four temporal GoalTypes are all exercised by this case study.
    goal SchedulingOrderPreserved : Maintain
    activation {[
      true
    ]}
    condition {[
      (self.group.scheduled implies
        self.group.roomReserved
        and self.group.Participant->forAll(participant |
          participant.notified and participant.slotConfirmed))
      and (self.group.roomReserved implies
        self.group.candidateSlotProposed)
      and not (self.group.scheduled and self.group.cancelled)
    ]}

    goal AvailabilityPrivacyPreserved : Maintain
    activation {[
      self.group.requestRegistered
      and not self.group.cancelled
    ]}
    condition {[
      self.group.privacyPreserved
    ]}

    goal AcceptedRequestRemainsValid : Sustain
    activation {[
      self.group.requestRegistered
      and not self.group.cancelled
    ]}
    condition {[
      self.group.requestValid
    ]}

    goal PendingRequestReassessed : Recur
    activation {[
      self.group.requestRegistered
      and not self.group.scheduled
      and not self.group.cancelled
    ]}
    condition {[
      self.group.reviewPerformed
    ]}

    resource AvailabilityInformation
      > needed-by ProtectAvailabilityData
      > needed-by ComputeAvailabilityIntersection
    resource ProposedSlot > needed-by RequestRoomReservation
    resource RoomReservationRecord > needed-by RecordRoomReservation

    quality Timeliness > qualifies RequestResolved
    quality Privacy > qualifies AllAvailabilityReceived
    quality Fairness > qualifies CandidateSlotProposed
    quality RecoveryResilience > qualifies RecoveryCompleted
  }

  // Participant. Both root goals inherit demand through dependencies.
  role Participant {
    goal AvailabilityProvided : Achieve

    task CheckPersonalCalendar
      > AvailabilityProvided
      > help ParticipantConvenience
    pre {[
      self.group.availabilityRequestSent
      and not self.availabilityChecked
    ]}
    post {[
      self.availabilityChecked
    ]}

    task SubmitAvailability
      > AvailabilityProvided
      > make ParticipantConvenience
    pre {[
      self.availabilityChecked
      and not self.availabilitySubmitted
    ]}
    post {[
      self.availabilitySubmitted
    ]}

    goal CandidateSlotConfirmed : Achieve

    task ReviewCandidateSlot > CandidateSlotConfirmed
    pre {[
      self.group.candidateSlotProposed
      and self.notified
      and not self.slotReviewed
    ]}
    post {[
      self.slotReviewed
    ]}

    task ConfirmCandidateSlot > CandidateSlotConfirmed
    pre {[
      self.slotReviewed
      and not self.slotConfirmed
    ]}
    post {[
      self.slotConfirmed
    ]}

    resource ParticipantAvailabilityData > needed-by SubmitAvailability
    resource CandidateSlotData > needed-by ReviewCandidateSlot
    quality ParticipantConvenience > qualifies AvailabilityProvided
  }

  // Calendar service. Failure is captured by a Maintain goal over ACL state.
  role CalendarService {
    goal CalendarAvailabilityProvided : Achieve

    task ReadParticipantCalendars
      > CalendarAvailabilityProvided
      > help CalendarAccuracy
    pre {[
      self.group.availabilityRequestSent
      and self.available
    ]}
    post {[
      self.calendarDataRead
    ]}

    task ReturnCalendarAvailability
      > CalendarAvailabilityProvided
      > make CalendarAccuracy
    pre {[
      self.calendarDataRead
    ]}
    post {[
      self.calendarDataReturned
    ]}

    goal CalendarServiceAvailable : Maintain
    activation {[
      self.group.availabilityRequestSent
      and not self.group.intersectionComputed
    ]}
    condition {[
      self.available
    ]}

    resource CalendarStatus > needed-by ReadParticipantCalendars
    resource CalendarAvailabilityResult > needed-by ReturnCalendarAvailability
    quality CalendarAccuracy > qualifies CalendarAvailabilityProvided
  }

  // Room booking service.
  role RoomBookingService {
    goal RoomReservationGranted : Achieve

    task CheckRoomAvailability
      > RoomReservationGranted
      > help ReservationReliability
    pre {[
      self.group.roomReservationRequested
    ]}
    post {[
      self.availabilityChecked
    ]}

    task ReserveAvailableRoom
      > RoomReservationGranted
      > make ReservationReliability
    pre {[
      self.availabilityChecked
      and self.group.roomAvailable
    ]}
    post {[
      self.reservationConfirmed
    ]}

    goal RoomInventoryConsistent : Maintain
    activation {[
      true
    ]}
    condition {[
      self.inventoryConsistent
    ]}

    resource RoomInventory > needed-by CheckRoomAvailability
    resource ServiceReservationRecord > needed-by ReserveAvailableRoom
    quality ReservationReliability > qualifies RoomReservationGranted
  }

  // Notification service.
  role NotificationService {
    goal NotificationsDelivered : Achieve

    task SelectNotificationChannel
      > NotificationsDelivered
      > help NotificationReliability
    pre {[
      self.group.notificationsRequested
      and self.available
    ]}
    post {[
      self.channelSelected
    ]}

    task DeliverMeetingNotifications
      > NotificationsDelivered
      > make NotificationReliability
    pre {[
      self.channelSelected
    ]}
    post {[
      self.group.Participant->forAll(participant | participant.notified)
    ]}

    task RecordNotificationLog > NotificationsDelivered
    pre {[
      self.group.Participant->forAll(participant | participant.notified)
    ]}
    post {[
      self.deliveryLogged
    ]}

    goal NotificationChannelSustained : Sustain
    activation {[
      self.group.notificationsRequested
      and not self.group.Participant->forAll(participant | participant.notified)
    ]}
    condition {[
      self.available
    ]}

    resource NotificationChannel > needed-by DeliverMeetingNotifications
    resource NotificationLog > needed-by RecordNotificationLog
    quality NotificationReliability > qualifies NotificationsDelivered
  }

  // Strategic dependencies. Each middle element is a newly owned dependum,
  // not a reference to an actor-owned element with the same label.
  depend MeetingInitiator.MeetingArranged
    -> goal SchedulingService
    -> MeetingSchedulerSystem.RequestResolved

  depend MeetingSchedulerSystem.AllAvailabilityReceived
    -> task ProvideParticipantAvailability
    -> Participant.AvailabilityProvided

  depend MeetingSchedulerSystem.CandidateSlotProposed
    -> resource CalendarAvailabilityData
    -> CalendarService.CalendarAvailabilityProvided

  depend MeetingSchedulerSystem.RoomReserved
    -> resource RoomBookingConfirmation
    -> RoomBookingService.RoomReservationGranted

  depend MeetingSchedulerSystem.AllParticipantsNotified
    -> task DeliverNotificationService
    -> NotificationService.NotificationsDelivered

  depend MeetingSchedulerSystem.AllParticipantsConfirmed
    -> goal ConfirmProposedSlot
    -> Participant.CandidateSlotConfirmed
}
