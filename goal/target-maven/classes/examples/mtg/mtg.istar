// Computer-supported Meeting Scheduler, rebuilt directly from the actual
// diagrams of Yu (RE'97): Figure 2 (SD model, with computer scheduler — the
// eight `depend` blocks below) and Figure 4 (SR model, with computer
// scheduler — the internal rationale inside each role). Element names follow
// the diagrams as closely as this metamodel allows.
//
// Two structural rules force a handful of deliberate departures from the
// literal picture, both enforced by GoalModelValidator:
//   (1) element ids must be unique across the WHOLE model, not just within
//       one actor, so the initiator's old manual routine cannot reuse the
//       scheduler's "ScheduleMeeting" label the way Figure 4 does;
//   (2) a refinement parent can never be a dependency's boundary element, so
//       every node a `depend` block touches is kept a leaf even where the
//       picture draws it with children (see EnterDateRange).
//
// Figure 4 also carries the participant's own trade-off from Section 2.4
// ("Supporting design"): using the computer scheduler is less rich/friendly
// as a channel than talking to the initiator directly, and that in turn
// costs the participant effort. Modelled as the AgreeableMeetingDate
// OR-choice between FindAgreeableDateUsingScheduler (hurts
// RicherMedium/UserFriendly) and FindAgreeableDateByTalkingToInitiator
// (helps them), with RicherMedium/UserFriendly feeding into the
// participant's own LowEffort quality — distinct from the initiator's
// LowEffortInitiator, since Figures 3-4 draw one LowEffort cloud per actor.
istar ClassicIStarMeetingScheduler {

  role MeetingInitiator {
    goal MeetingOrganized : Achieve
    activation {[
      self.group.meetingRequested
    ]}

    // Figure 4 draws four concerns under OrganizeMeeting: getting a date
    // fixed, ordinary participants attending, important participants
    // actually attending (marked critical/X in Figures 1-2), and being
    // assured in advance that they will.
    goal MeetingBeScheduled : Achieve > MeetingOrganized

    goal ParticipantsAttend : Achieve > MeetingOrganized
    goal ParticipantAttends : Achieve
      > forall MeetingParticipant ParticipantsAttend
    condition {[
      self.attending
    ]}

    // Figures 1-2 draw this as its own critical (X) goal dependency,
    // separate from the softgoal "Assured" dependency below — the initiator
    // cares both that important participants attend AND that this is
    // assured ahead of time.
    goal ImportantParticipantsAttend : Achieve > MeetingOrganized
    goal ImportantParticipantAttends : Achieve
      > forall ImportantParticipant ImportantParticipantsAttend
    condition {[
      self.attending
    ]}

    goal ImportantParticipantsAssured : Achieve > MeetingOrganized
    goal ImportantAttendanceAssured : Achieve
      > forall ImportantParticipant ImportantParticipantsAssured
    condition {[
      self.attendanceAssured
    ]}

    // Two means for MeetingBeScheduled, as in Figure 4: the existing manual
    // routine hurts Quick/LowEffort, delegating to the scheduler helps both.
    // Renamed from the picture's shared "ScheduleMeeting" label because
    // element ids are unique across the whole model here, and the scheduler
    // role below owns its own "ScheduleMeeting" task.
    task ScheduleMeetingManually
      > or MeetingBeScheduled
      > hurt Quick
      > hurt LowEffortInitiator
    pre {[
      self.group.meetingRequested
      and not self.schedulingDelegated
    ]}
    post {[ self.group.meetingScheduled ]}

    task LetSchedulerScheduleMeeting
      > or MeetingBeScheduled
      > make Quick
      > make LowEffortInitiator
    pre {[
      self.group.meetingRequested
      and not self.schedulingDelegated
    ]}
    post {[ self.schedulingDelegated ]}

    // Figure 4 draws this as a decomposition child of LetSchedulerScheduleMeeting.
    // It has to stay a standalone leaf here: LetSchedulerScheduleMeeting is
    // itself the depender-boundary element of the "MeetingBeScheduled"
    // dependency below, and a refinement parent can never be a dependency
    // endpoint. EnterDateRange instead gets its demand from the
    // "EnterDateRange" dependency (the scheduler depends on it directly).
    task EnterDateRange
    pre {[
      self.group.meetingRequested
      and not self.dateRangeEntered
    ]}
    post {[ self.dateRangeEntered ]}

    quality Quick
    quality LowEffortInitiator
  }

  role MeetingScheduler {
    // Leaf interface goal used only at the actor boundary — the attachment
    // point for the incoming "MeetingBeScheduled" dependency. Kept separate
    // from the task below it because that task is a refinement parent and
    // therefore cannot itself be a dependency endpoint.
    goal SchedulingServiceProvided : Achieve
    condition {[ self.group.meetingScheduled ]}

    // The actual root task drawn in Figure 4 inside the scheduler's
    // boundary, AND-decomposing into the four steps below.
    task ScheduleMeeting

    task ObtainAvailDates
      > ScheduleMeeting
    pre {[
      self.group.MeetingInitiator.schedulingDelegated
      and self.group.MeetingInitiator.dateRangeEntered
      and not self.availabilityRequested
    ]}
    post {[ self.availabilityRequested ]}

    // FindAgreeableSlot is the subgoal Figure 4 leaves open to alternative
    // means; MergeAvailDates is currently the only known means to it.
    goal FindAgreeableSlot : Achieve
      > ScheduleMeeting
    condition {[
      self.availabilityMerged
      and self.suitableSlotFound
    ]}

    task MergeAvailDates
      > or FindAgreeableSlot
      > make QualityProposedDate
    pre {[
      self.group.MeetingParticipant->forAll(participant |
        participant.exclusionDatesEntered
        and participant.preferredDatesEntered)
    ]}
    post {[
      self.availabilityMerged
      and self.suitableSlotFound
    ]}

    // Not confirmed as its own box in Figure 4, but the "ProposedDate"
    // resource dependency below needs a leaf attachment point on this side,
    // and publishing the date is the step the SD dependency presupposes.
    task PublishProposedDate
      > ScheduleMeeting
      > help QualityProposedDate
    pre {[ self.suitableSlotFound ]}
    post {[ self.proposedDatePublished ]}

    // Getting the last agreement is what actually confirms the meeting —
    // folded in here rather than as a separate final task, since Figure 4
    // does not draw one beyond these four steps.
    task ObtainAgreement
      > ScheduleMeeting
    pre {[ self.proposedDatePublished ]}
    post {[
      self.group.MeetingParticipant->forAll(participant |
        participant.agreementProvided)
      and self.group.ImportantParticipant->forAll(participant |
        participant.attendanceAssured)
      and self.group.meetingScheduled
    ]}

    quality QualityProposedDate
  }

  role MeetingParticipant {
    // The participant's two concerns from Figure 4: reach an agreeable date,
    // then attend.
    goal ParticipatesInMeeting : Achieve
    activation {[
      self.group.meetingRequested
    ]}

    goal AgreeableMeetingDate : Achieve > ParticipatesInMeeting
    condition {[
      self.exclusionDatesEntered
      and self.preferredDatesEntered
      and self.agreementProvided
    ]}

    // Figure 4's design tension (Section 2.4): use the computer scheduler,
    // or keep talking directly to the initiator the way it worked before
    // the scheduler existed.
    task FindAgreeableDateUsingScheduler
      > or AgreeableMeetingDate
      > hurt RicherMedium
      > hurt UserFriendly

    task EnterAvailDates
      > FindAgreeableDateUsingScheduler
      > make MinInterruption
    pre {[
      self.group.MeetingScheduler.availabilityRequested
      and not self.exclusionDatesEntered
    ]}
    post {[
      self.exclusionDatesEntered
      and self.preferredDatesEntered
    ]}

    task AgreeToDate
      > FindAgreeableDateUsingScheduler
      > make ConvenientMeetingDate
    pre {[
      self.group.MeetingScheduler.proposedDatePublished
      and not self.agreementProvided
    ]}
    post {[ self.agreementProvided ]}

    task FindAgreeableDateByTalkingToInitiator
      > or AgreeableMeetingDate
      > help RicherMedium
      > help UserFriendly
    pre {[
      self.group.meetingRequested
      and not self.exclusionDatesEntered
    ]}
    post {[
      self.exclusionDatesEntered
      and self.preferredDatesEntered
      and self.agreementProvided
    ]}

    // Bare leaf task — Figure 4 does not wrap it in a separate
    // "AttendsMeeting" goal, and it is the dependee-boundary element for
    // the "AttendsMeeting" dependency below.
    task AttendMeeting > ParticipatesInMeeting
    pre {[ self.group.meetingScheduled ]}
    post {[ self.attending ]}

    resource ExclusionDates > needed-by EnterAvailDates
    resource PreferredDates > needed-by EnterAvailDates
    resource ProposedDate > needed-by AgreeToDate
    resource Agreement > needed-by AgreeToDate

    quality ConvenientMeetingDate
    quality MinInterruption
    // Figure 4's own softgoal, distinct from the initiator's
    // LowEffortInitiator: a richer/friendlier channel costs the participant
    // less effort, so the computer-scheduler branch (which hurts
    // RicherMedium/UserFriendly) indirectly threatens it too.
    quality LowEffort
    quality RicherMedium > help LowEffort
    quality UserFriendly > help LowEffort
  }

  role ImportantParticipant {
    // Specializes MeetingParticipant, mirroring the "ISA" mark on Figures
    // 1-2's SD model (and mtg.acl's `ImportantParticipant extends
    // MeetingParticipant`).
    goal ImportantParticipation : Achieve
    activation {[
      self.group.meetingRequested
    ]}

    goal AssuredAttendance : Achieve > ImportantParticipation
    condition {[
      self.attendanceAssured
    ]}

    goal ImportantAttendsMeeting : Achieve > ImportantParticipation
    condition {[
      self.attending
    ]}

    task ConfirmAttendance
      > make AssuredAttendsMeeting
    pre {[
      self.agreementProvided
    ]}
    post {[ self.attendanceAssured ]}

    quality AssuredAttendsMeeting
  }

  // Eight dependencies, matching Figure 2 exactly (including the critical
  // "AttendsMeeting(ip,m)" one that is easy to miss next to the softgoal
  // "Assured" dependency right below it). Every boundary element above is a
  // leaf on purpose — see the two structural rules in the header comment.
  depend MeetingInitiator.LetSchedulerScheduleMeeting
    -> goal MeetingBeScheduled
    -> MeetingScheduler.SchedulingServiceProvided

  depend MeetingScheduler.ObtainAvailDates
    -> task EnterAvailDates
    -> MeetingParticipant.EnterAvailDates

  depend MeetingScheduler.ObtainAgreement
    -> resource Agreement
    -> MeetingParticipant.Agreement

  depend MeetingParticipant.AgreeToDate
    -> resource ProposedDate
    -> MeetingScheduler.PublishProposedDate

  depend MeetingScheduler.ObtainAvailDates
    -> task EnterDateRange
    -> MeetingInitiator.EnterDateRange

  depend MeetingInitiator.ParticipantAttends
    -> goal AttendsMeeting
    -> MeetingParticipant.AttendMeeting

  // Critical (X in Figures 1-2): the initiator's stake in an important
  // participant's actual attendance, separate from wanting it assured.
  depend MeetingInitiator.ImportantParticipantAttends
    -> goal AttendsMeeting
    -> ImportantParticipant.ImportantAttendsMeeting

  depend MeetingInitiator.ImportantAttendanceAssured
    -> quality AssuredAttendsMeeting
    -> ImportantParticipant.AssuredAttendance
}
