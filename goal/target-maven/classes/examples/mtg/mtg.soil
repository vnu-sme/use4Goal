-- Snapshot for mtg_shadow.use.
-- Alice holds the compatible Initiator + Participant pair in one MeetingUnit.
-- Bob holds the compatible Organizer + Secretary pair in the same MeetingUnit.

!create architectureReview : MeetingUnit
!set architectureReview.detailsDecided := false
!set architectureReview.timeChosen := false

!create alice : Agent
!set alice.name := 'Alice'
!set alice.phone := '+84-900-111-222'
!set alice.hasCalendar := true
!create bob : Agent
!set bob.name := 'Bob'
!set bob.phone := '+84-900-222-333'
!set bob.hasCalendar := true
!create carol : Agent
!set carol.name := 'Carol'
!set carol.phone := '+84-900-333-444'
!set carol.hasCalendar := false
!insert (bob, alice) into knowsPhoneOf
!insert (bob, carol) into knowsPhoneOf

!create initiatorAlice : Initiator
!insert (alice, initiatorAlice) into Agent_plays_Initiator
!insert (architectureReview, initiatorAlice) into Initiator_in_MeetingUnit

!create organizerBob : Organizer
!insert (bob, organizerBob) into Agent_plays_Organizer
!insert (architectureReview, organizerBob) into Organizer_in_MeetingUnit

!create secretaryBob : Secretary
!insert (bob, secretaryBob) into Agent_plays_Secretary
!insert (architectureReview, secretaryBob) into Secretary_in_MeetingUnit

!create participantAlice : Participant
!set participantAlice.timetableCollected := false
!set participantAlice.timetableChannel := #none
!set participantAlice.notified := false
!set participantAlice.attended := false
!insert (alice, participantAlice) into Agent_plays_Participant
!insert (architectureReview, participantAlice) into Participant_in_MeetingUnit

!create participantCarol : Participant
!set participantCarol.timetableCollected := false
!set participantCarol.timetableChannel := #none
!set participantCarol.notified := false
!set participantCarol.attended := false
!insert (carol, participantCarol) into Agent_plays_Participant
!insert (architectureReview, participantCarol) into Participant_in_MeetingUnit
