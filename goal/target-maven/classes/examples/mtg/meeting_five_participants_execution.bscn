// BPMN Scenario Execution — same run described by doc/scenario/meeting_five_participants_execution.drawio.
//
// BPMN model = type-level process schema.
// This file = one concrete execution over one process instance and eight actor objects.
// Each completed statement below is one activity occurrence.

scenario MeetingOrganizationFiveParticipantsExecution for "mtg.bpmn2" {
    process meeting1 : MeetingOrganization;

    actor abdul : Initiator;
    actor matilda : Organizer;
    actor alex : Secretary;
    actor xing, amr, naya, bao, chloe : Participant;

    bind meeting1.initiator = abdul;
    bind meeting1.organizer = matilda;
    bind meeting1.secretary = alex;
    bind meeting1.participants = [xing, amr, naya, bao, chloe];

    completed meeting1.decideMeetingDetails by abdul;

    completed meeting1.checkCalendar for xing by matilda;
    completed meeting1.checkCalendar for amr by matilda;
    completed meeting1.checkCalendar for naya by matilda;
    completed meeting1.requestSecretaryCall for naya by matilda;
    completed meeting1.collectConstraintsByPhone for naya by alex;

    completed meeting1.checkCalendar for bao by matilda;
    completed meeting1.requestSecretaryCall for bao by matilda;
    completed meeting1.collectConstraintsByPhone for bao by alex;

    completed meeting1.checkCalendar for chloe by matilda;
    completed meeting1.requestSecretaryCall for chloe by matilda;
    completed meeting1.collectConstraintsByPhone for chloe by alex;

    completed meeting1.chooseTimeAndDate by matilda;

    completed meeting1.announceMeeting for xing by matilda;
    completed meeting1.announceMeeting for amr by matilda;
    completed meeting1.announceMeeting for naya by matilda;
    completed meeting1.announceMeeting for bao by matilda;
    completed meeting1.announceMeeting for chloe by matilda;

    completed meeting1.participate by xing;
    completed meeting1.participate by amr;
    completed meeting1.participate by naya;
    completed meeting1.participate by bao;
    completed meeting1.participate by chloe;

    value xing.timetable = collected;
    value amr.timetable = collected;
    value naya.timetable = collected;
    value bao.timetable = collected;
    value chloe.timetable = collected;

    value xing.notified = true;
    value amr.notified = true;
    value naya.notified = true;
    value bao.notified = true;
    value chloe.notified = true;

    assert count(participants where notified = true) == 5;
    assert count(participants where timetable = collected) == 5;
}
