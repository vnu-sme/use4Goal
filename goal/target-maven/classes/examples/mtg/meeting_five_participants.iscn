// i* Scenario — same domain model as mtg.iscn (mtg.istar), but the initial state described
// in doc/scenario/init.md "Kịch bản C": 5 Participant instances instead of 3, with a
// different calendar/phone split (xing.hasCalendar=amr.hasCalendar=true; naya/bao/chloe have
// none; alex can call all 5) — this is a DIFFERENT scenario over the SAME type-level model,
// not a variant of mtg.iscn (see doc/concept-domain-model-vs-scenario.md: one domain model,
// many possible scenarios).
//
// Occurrence counts this state should produce (matching doc/scenario/init.md's table):
//   Decide Meeting Details        1  (abdul, broadcast)
//   Check Participant Calendar    5  (TimetableCollected, all of Participant)
//   Request Secretary Call / \
//   Collect Constraints By Phone  3  (naya, bao, chloe only)
//   Choose Time And Date          1  (matilda, broadcast)
//   Announce Meeting              5
//   Participate                   5

scenario MeetingOrganization_WithFiveParticipants_MixedCalendarAndPhoneCollection for "mtg.istar" {
    instance abdul   : Initiator;
    instance matilda : Organizer;
    instance alex    : Secretary;
    instance xing, amr, naya, bao, chloe : Participant;

    fire DecideMeetingDetails;
    fire ChooseTimeAndDate;

    // xing, amr: hasCalendar = true -> organizer's own action, no Dependency involved.
    fire xing.CollectFromCalendar;
    fire amr.CollectFromCalendar;

    // naya, bao, chloe: hasCalendar = false -> alex performs the secretary task for
    // each participant; the delegated organizer goals are inferred through dependency.
    fire alex.CollectConstraintsByPhone for naya;
    fire alex.CollectConstraintsByPhone for bao;
    fire alex.CollectConstraintsByPhone for chloe;

    fire xing.AnnounceMeeting;
    fire amr.AnnounceMeeting;
    fire naya.AnnounceMeeting;
    fire bao.AnnounceMeeting;
    fire chloe.AnnounceMeeting;

    // Each participant's own action is fired; the initiator's delegated attendance goal is inferred.
    fire xing.Participate;
    fire amr.Participate;
    fire naya.Participate;
    fire bao.Participate;
    fire chloe.Participate;

    aggregate EveryTimetableCollected : all of Participant over TimetableCollected;
    aggregate EveryoneNotified        : all of Participant over AnnounceMeeting;
    aggregate EveryoneAttended        : all of Participant over MeetingAttendedByParticipant;
    aggregate MeetingFullyOrganized   : all of Participant over HaveMeetingOrganized;

    // 2 of 5 collected by calendar, 3 of 5 collected by secretary phone call:
    aggregate SomeInclusivityViaSecretary : any of Participant over Inclusivity;      // naya/bao/chloe -> holds
    aggregate UniversalQuickScheduling    : all of Participant over QuickScheduling;  // only xing/amr -> fails
}
