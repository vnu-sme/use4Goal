// Two independent MeetingUnit instances, staffed by entirely disjoint
// people, run against the same mtg.bpmn2 in the same session: this is the
// concrete case `pool MeetingOrganization for MeetingUnit` exists for.
// Each instance gets its own Bpmn2ExecutionEngine, self-bound to only that
// instance, so the two meetings advance independently, not in lockstep,
// and neither leaks into the other's timetableCollected/notified/attended.

aol v1.0 MeetingSchedulerTwoMeetings for "mtg.acl" {
  agent MeetingParty as alice {
    name = "Alice";
    phone = "+84-911-111-111";
    hasCalendar = true;
  }

  agent MeetingParty as bob {
    name = "Bob";
    phone = "+84-900-222-333";
    hasCalendar = true;
  }

  agent MeetingParty as carol {
    name = "Carol";
    phone = "+84-922-222-222";
    hasCalendar = false;
  }

  agent MeetingParty as dave {
    name = "Dave";
    phone = "+84-933-444-444";
    hasCalendar = true;
  }

  agent MeetingParty as erin {
    name = "Erin";
    phone = "+84-944-555-555";
    hasCalendar = true;
  }

  agent MeetingParty as frank {
    name = "Frank";
    phone = "+84-955-666-666";
    hasCalendar = false;
  }

  // First meeting: architecture review.
  group MeetingUnit as architectureReview {
    detailsDecided = false;
    timeChosen = false;

    play Initiator as initiatorAlice by alice;
    play Organizer as organizerBob by bob;
    play Secretary as secretaryBob by bob;

    play Participant as participantAlice by alice {
      timetableCollected = false;
      timetableChannel = none;
      notified = false;
      attended = false;
    }

    play Participant as participantCarol by carol {
      timetableCollected = false;
      timetableChannel = none;
      notified = false;
      attended = false;
    }
  }

  // Second meeting: entirely disjoint people, running at the same time.
  group MeetingUnit as budgetPlanning {
    detailsDecided = false;
    timeChosen = false;

    play Initiator as initiatorDave by dave;
    play Organizer as organizerErin by erin;
    play Secretary as secretaryErin by erin;

    play Participant as participantDave by dave {
      timetableCollected = false;
      timetableChannel = none;
      notified = false;
      attended = false;
    }

    play Participant as participantFrank by frank {
      timetableCollected = false;
      timetableChannel = none;
      notified = false;
      attended = false;
    }
  }

  link knowsPhoneOf : bob -> alice, carol;
  link knowsPhoneOf : erin -> dave, frank;
}
