acl v2.0 ClassicIStarMeetingSchedulerState {
  // Agent profile used by the three organizational actors in Yu's example.
  role Person;

  role MeetingInitiator extends Person {
    dateRangeEntered : Boolean;
    schedulingDelegated : Boolean;
  }

  role MeetingScheduler extends Person {
    availabilityRequested : Boolean;
    availabilityMerged : Boolean;
    suitableSlotFound : Boolean;
    proposedDatePublished : Boolean;
  }

  role MeetingParticipant extends Person {
    exclusionDatesEntered : Boolean;
    preferredDatesEntered : Boolean;
    agreementProvided : Boolean;
    attending : Boolean;
  }

  // This specialization represents the ISA edge in the original SD model.
  role ImportantParticipant extends MeetingParticipant {
    agreementProvided : Boolean;
    attendanceAssured : Boolean;
    attending : Boolean;
  }

  group Meeting {
    meetingRequested : Boolean;
    meetingScheduled : Boolean;
    scheduleAnnounced : Boolean;

    MeetingInitiator [1];
    MeetingScheduler [1];
    MeetingParticipant [1..*];
    ImportantParticipant [0..*];

    MeetingInitiator compatible MeetingParticipant;
  }
}
