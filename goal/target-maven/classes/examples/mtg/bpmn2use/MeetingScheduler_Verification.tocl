-- BPMN sequence-flow constraints generated from MeetingScheduler.bpmn2
-- TOCL-compatible profile: each invariant is hosted by the target lane Role.

-- Incoming sequence flow(s) of decideMeetingDetails
context Initiator
inv BPMN_MeetingOrganization_before_decideMeetingDetails:
  always (
    isCalled(decideMeetingDetails())
    implies
    (
      sometimePast (isCalled(start_meeting()))
    )
  )

-- Incoming sequence flow(s) of checkCalendar
context Organizer
inv BPMN_MeetingOrganization_before_checkCalendar:
  always (
    isCalled(checkCalendar())
    implies
    (
      sometimePast (isCalled(Initiator.allInstances()->select(initiatorCandidate : Initiator | initiatorCandidate.meetingUnit.id = self.meetingUnit.id)->select(initiatorCandidate : Initiator | initiatorCandidate = initiatorCandidate)->any(true).decideMeetingDetails()))
    )
  )

-- Incoming sequence flow(s) of phoneCollectionRequired
context Organizer
inv BPMN_MeetingOrganization_before_phoneCollectionRequired:
  always (
    isCalled(phoneCollectionRequired())
    implies
    (
      sometimePast (isCalled(checkCalendar()))
    )
  )

-- Incoming sequence flow(s) of requestSecretaryCall
context Organizer
inv BPMN_MeetingOrganization_before_requestSecretaryCall:
  always (
    isCalled(requestSecretaryCall())
    implies
    (
      sometimePast (isCalled(phoneCollectionRequired()))
    )
  )

-- Incoming sequence flow(s) of timetableCollectionComplete
context Organizer
inv BPMN_MeetingOrganization_before_timetableCollectionComplete:
  always (
    isCalled(timetableCollectionComplete())
    implies
    (
      sometimePast (isCalled(phoneCollectionRequired()))
      or sometimePast (isCalled(Secretary.allInstances()->select(secretaryCandidate : Secretary | secretaryCandidate.meetingUnit.id = self.meetingUnit.id)->select(secretaryCandidate : Secretary | secretaryCandidate = secretaryCandidate)->any(true).collectConstraintsByPhone()))
    )
  )

-- Incoming sequence flow(s) of collectConstraintsByPhone
context Secretary
inv BPMN_MeetingOrganization_before_collectConstraintsByPhone:
  always (
    isCalled(collectConstraintsByPhone())
    implies
    (
      sometimePast (isCalled(Organizer.allInstances()->select(organizerCandidate : Organizer | organizerCandidate.meetingUnit.id = self.meetingUnit.id)->select(organizerCandidate : Organizer | organizerCandidate = organizerCandidate)->any(true).requestSecretaryCall()))
    )
  )

-- Incoming sequence flow(s) of chooseTimeAndDate
context Organizer
inv BPMN_MeetingOrganization_before_chooseTimeAndDate:
  always (
    isCalled(chooseTimeAndDate())
    implies
    (
      sometimePast (isCalled(timetableCollectionComplete()))
    )
  )

-- Incoming sequence flow(s) of announceMeeting
context Organizer
inv BPMN_MeetingOrganization_before_announceMeeting:
  always (
    isCalled(announceMeeting())
    implies
    (
      sometimePast (isCalled(chooseTimeAndDate()))
    )
  )

-- Incoming sequence flow(s) of participate
context Participant
inv BPMN_MeetingOrganization_before_participate:
  always (
    isCalled(participate())
    implies
    (
      sometimePast (isCalled(Organizer.allInstances()->select(organizerCandidate : Organizer | organizerCandidate.meetingUnit.id = self.meetingUnit.id)->select(organizerCandidate : Organizer | organizerCandidate = organizerCandidate)->any(true).announceMeeting()))
    )
  )

