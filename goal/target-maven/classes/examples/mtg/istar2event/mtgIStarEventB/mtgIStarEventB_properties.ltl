# ProB LTL properties generated from iStar
# LTL_ACHIEVE_MeetingOrganized [LIVENESS] iStar achieve goal MeetingOrganized
G({G_MeetingOrganized_A ≠ ∅} => F {G_MeetingOrganized_P = R_Initiator})

# LTL_ACHIEVE_MeetingScheduled [LIVENESS] iStar achieve goal MeetingScheduled
G({G_MeetingScheduled_A ≠ ∅} => F {G_MeetingScheduled_P = R_Initiator})

# LTL_ACHIEVE_ParticipantsAttended [LIVENESS] iStar achieve goal ParticipantsAttended
G({G_ParticipantsAttended_A ≠ ∅} => F {G_ParticipantsAttended_P = R_Initiator})

# LTL_ACHIEVE_OrganizerScheduledMeeting [LIVENESS] iStar achieve goal OrganizerScheduledMeeting
G({G_OrganizerScheduledMeeting_A ≠ ∅} => F {G_OrganizerScheduledMeeting_P = {self,outer1·self∈R_Organizer ∧ outer1∈R_Initiator ∧ owns_Organizer∼[{self}] ≠ ∅ ∧ owns_Organizer∼[{self}] = owns_Initiator∼[{outer1}]∣(outer1 ↦ self)}})

# LTL_ACHIEVE_ParticipantAttended [LIVENESS] iStar achieve goal ParticipantAttended
G({G_ParticipantAttended_A ≠ ∅} => F {G_ParticipantAttended_P = {self,outer1·self∈R_Participant ∧ outer1∈R_Initiator ∧ owns_Participant∼[{self}] ≠ ∅ ∧ owns_Participant∼[{self}] = owns_Initiator∼[{outer1}]∣(outer1 ↦ self)}})

# LTL_MAINTAIN_ChosenTimeHasDetails [SAFETY] iStar maintain goal ChosenTimeHasDetails
G({(∀self·self∈R_Organizer ⇒ (((TRUE = TRUE) ∧ (MeetingUnit_timeChosen[owns_Organizer∼[{self}]] = {TRUE})) ⇒ (MeetingUnit_detailsDecided[owns_Organizer∼[{self}]] = {TRUE})))})

# LTL_ACHIEVE_SchedulingCompleted [LIVENESS] iStar achieve goal SchedulingCompleted
G({G_SchedulingCompleted_A ≠ ∅} => F {G_SchedulingCompleted_P = {self,outer1·self∈R_Organizer ∧ outer1∈R_Initiator ∧ owns_Organizer∼[{self}] ≠ ∅ ∧ owns_Organizer∼[{self}] = owns_Initiator∼[{outer1}]∣(outer1 ↦ self)}})

# LTL_ACHIEVE_TimetablesCollected [LIVENESS] iStar achieve goal TimetablesCollected
G({G_TimetablesCollected_A ≠ ∅} => F {G_TimetablesCollected_P = R_Organizer})

# LTL_SUSTAIN_ParticipantsNotified [SUSTAINMENT] iStar sustain goal ParticipantsNotified
G({G_ParticipantsNotified_A ≠ ∅} => (! {G_ParticipantsNotified_P ≠ ∅} U G {G_ParticipantsNotified_S = R_Organizer}))

# LTL_ACHIEVE_TimetableCollected [LIVENESS] iStar achieve goal TimetableCollected
G({G_TimetableCollected_A ≠ ∅} => F {G_TimetableCollected_P = {self,outer1·self∈R_Participant ∧ outer1∈R_Organizer ∧ owns_Participant∼[{self}] ≠ ∅ ∧ owns_Participant∼[{self}] = owns_Organizer∼[{outer1}]∣(outer1 ↦ self)}})

# LTL_ACHIEVE_ContactedByPhone [LIVENESS] iStar achieve goal ContactedByPhone
G({G_ContactedByPhone_A ≠ ∅} => F {G_ContactedByPhone_P = {self,outer1·self∈R_Participant ∧ outer1∈R_Organizer ∧ owns_Participant∼[{self}] ≠ ∅ ∧ owns_Participant∼[{self}] = owns_Organizer∼[{outer1}]∣(outer1 ↦ self)}})

# LTL_ACHIEVE_SecretaryRequested [LIVENESS] iStar achieve goal SecretaryRequested
G({G_SecretaryRequested_A ≠ ∅} => F {G_SecretaryRequested_P = {self,outer1,outer2·self∈R_Secretary ∧ outer1∈R_Participant ∧ outer2∈R_Organizer ∧ owns_Secretary∼[{self}] ≠ ∅ ∧ owns_Secretary∼[{self}] = owns_Participant∼[{outer1}] ∧ owns_Participant∼[{outer1}] ≠ ∅ ∧ owns_Participant∼[{outer1}] = owns_Organizer∼[{outer2}]∣((outer2 ↦ outer1) ↦ self)}})

# LTL_DEP_ChooseMeetingTime [ASSUMPTION_GUARANTEE] iStar dependency OrganizerScheduledMeeting -> SchedulingCompleted
G({G_OrganizerScheduledMeeting_A ∖ G_OrganizerScheduledMeeting_P ≠ ∅} => F {G_SchedulingCompleted_P ≠ ∅})

# LTL_DEP_CollectByPhone [ASSUMPTION_GUARANTEE] iStar dependency SecretaryRequested -> CollectByPhone
G({G_SecretaryRequested_A ∖ G_SecretaryRequested_P ≠ ∅} => F {T_CollectByPhone_R ≠ ∅})

# LTL_DEP_AttendMeeting [ASSUMPTION_GUARANTEE] iStar dependency ParticipantAttended -> AttendMeeting
G({G_ParticipantAttended_A ∖ G_ParticipantAttended_P ≠ ∅} => F {T_AttendMeeting_R ≠ ∅})

