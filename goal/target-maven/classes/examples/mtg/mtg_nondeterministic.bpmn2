// Two enabled XOR completions for the same valid input: one satisfies attendance,
// one reaches EndEvent without it. Used to demonstrate weak versus strong compliance.
model MeetingSchedulerNondeterministic {
  pool MeetingOrganization for MeetingUnit {
    lane Initiator;
    lane Organizer;
    lane Participant;
  }

  start start_meeting {
    lane Initiator
    trigger none
    flow decideMeetingDetails
  }

  activity decideMeetingDetails {
    type task
    lane Initiator
    post {[
      self.detailsDecided
    ]}
    flow checkCalendar
  }

  activity checkCalendar {
    type task
    lane Organizer
    pre {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.source_Agent_plays_Participant.hasCalendar)
    ]}
    post {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.timetableCollected and p.timetableChannel = #calendar)
    ]}
    flow chooseTimeAndDate
  }

  activity chooseTimeAndDate {
    type task
    lane Organizer
    post {[
      self.timeChosen
    ]}
    flow announceMeeting
  }

  activity announceMeeting {
    type task
    lane Organizer
    post {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.notified)
    ]}
    flow completionChoice
  }

  gateway completionChoice {
    lane Organizer
    type xor
    flow participate
    flow skipAttendance
  }

  activity participate {
    type task
    lane Participant
    post {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.attended)
    ]}
    flow end_meeting
  }

  activity skipAttendance {
    name "Finish without recording attendance"
    type task
    lane Organizer
    flow end_meeting
  }

  end end_meeting {
    lane Organizer
    trigger none
  }
}
