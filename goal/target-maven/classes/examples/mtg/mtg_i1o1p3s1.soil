-- Input scenario: 1 Initiator, 1 Organizer, 3 Participants, 1 Secretary.
-- All participants have calendars; every Agent profile provides a phone number.
-- No BPMN activity has executed yet.

!create meetingUnit : MeetingUnit
!set meetingUnit.detailsDecided := false
!set meetingUnit.timeChosen := false
!create alice : Agent
!set alice.name := 'Alice'
!set alice.phone := '+84-911-111-111'
!set alice.hasCalendar := true
!create bob : Agent
!set bob.name := 'Bob'
!set bob.phone := '+84-900-222-333'
!set bob.hasCalendar := true
!create carol : Agent
!set carol.name := 'Carol'
!set carol.phone := '+84-922-222-222'
!set carol.hasCalendar := true
!create dave : Agent
!set dave.name := 'Dave'
!set dave.phone := '+84-933-333-333'
!set dave.hasCalendar := true
!insert (bob, alice) into knowsPhoneOf
!insert (bob, carol) into knowsPhoneOf
!insert (bob, dave) into knowsPhoneOf
!create initiatorAlice : Initiator
!insert (alice, initiatorAlice) into Agent_plays_Initiator
!insert (meetingUnit, initiatorAlice) into Initiator_in_MeetingUnit
!create organizerBob : Organizer
!insert (bob, organizerBob) into Agent_plays_Organizer
!insert (meetingUnit, organizerBob) into Organizer_in_MeetingUnit
!create secretaryBob : Secretary
!insert (bob, secretaryBob) into Agent_plays_Secretary
!insert (meetingUnit, secretaryBob) into Secretary_in_MeetingUnit

!create participantAlice : Participant
!set participantAlice.timetableCollected := false
!set participantAlice.timetableChannel := #none
!set participantAlice.notified := false
!set participantAlice.attended := false
!insert (alice, participantAlice) into Agent_plays_Participant
!insert (meetingUnit, participantAlice) into Participant_in_MeetingUnit
!create participantCarol : Participant
!set participantCarol.timetableCollected := false
!set participantCarol.timetableChannel := #none
!set participantCarol.notified := false
!set participantCarol.attended := false
!insert (carol, participantCarol) into Agent_plays_Participant
!insert (meetingUnit, participantCarol) into Participant_in_MeetingUnit
!create participantDave : Participant
!set participantDave.timetableCollected := false
!set participantDave.timetableChannel := #none
!set participantDave.notified := false
!set participantDave.attended := false
!insert (dave, participantDave) into Agent_plays_Participant
!insert (meetingUnit, participantDave) into Participant_in_MeetingUnit
