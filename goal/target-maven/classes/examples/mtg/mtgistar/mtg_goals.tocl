-- TOCL constraints generated from MeetingScheduler.istar
-- Each 'context C inv Name:' block encodes one iStar GoalType property.
-- Operators used: always, sometime, alwaysPast, not, implies

-- Initiator::MeetingOrganized [ACHIEVE]
context Initiator
inv ACHIEVE_MeetingOrganized:
  always (
    self.MeetingOrganized_activation
    implies
    sometime self.MeetingOrganized_condition
  )

