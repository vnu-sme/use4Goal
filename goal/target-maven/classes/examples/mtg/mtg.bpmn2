// Operational realization of the computer-supported configuration in Yu's
// original Meeting Scheduler example.
model ClassicIStarMeetingScheduler {
  pool MeetingScheduling for Meeting {
    name "Computer-supported meeting scheduling"
    lane MeetingInitiator;
    lane MeetingScheduler;
    lane MeetingParticipant;
    lane ImportantParticipant;
  }

  start meetingRequested {
    lane MeetingInitiator trigger none
    pre {[ not self.meetingRequested ]}
    flow requestMeeting
  }
  activity requestMeeting {
    name "Request meeting" type task lane MeetingInitiator
    post {[ self.meetingRequested ]}
    flow enterDateRange
  }
  activity enterDateRange {
    name "Enter date range" type task lane MeetingInitiator
    post {[ self.target_MeetingInitiator_in_Meeting.dateRangeEntered ]}
    flow delegateScheduling
  }
  activity delegateScheduling {
    name "Let scheduler schedule meeting" type task lane MeetingInitiator
    post {[ self.target_MeetingInitiator_in_Meeting.schedulingDelegated ]}
    flow requestAvailability
  }
  activity requestAvailability {
    name "Obtain availability dates" type task lane MeetingScheduler
    pre {[
      self.target_MeetingInitiator_in_Meeting.dateRangeEntered
      and self.target_MeetingInitiator_in_Meeting.schedulingDelegated
    ]}
    post {[ self.target_MeetingScheduler_in_Meeting.availabilityRequested ]}
    flow enterAvailability
  }
  activity enterAvailability {
    name "Enter exclusion and preferred dates" type task lane MeetingParticipant
    pre {[ self.target_MeetingScheduler_in_Meeting.availabilityRequested ]}
    post {[
      self.target_MeetingParticipant_in_Meeting->forAll(participant |
        participant.exclusionDatesEntered and participant.preferredDatesEntered)
    ]}
    flow mergeAvailability
  }
  activity mergeAvailability {
    name "Merge availability dates" type task lane MeetingScheduler
    pre {[
      self.target_MeetingParticipant_in_Meeting->forAll(participant |
        participant.exclusionDatesEntered and participant.preferredDatesEntered)
    ]}
    post {[
      self.target_MeetingScheduler_in_Meeting.availabilityMerged
      and self.target_MeetingScheduler_in_Meeting.suitableSlotFound
    ]}
    flow publishProposedDate
  }
  activity publishProposedDate {
    name "Publish proposed date" type task lane MeetingScheduler
    post {[ self.target_MeetingScheduler_in_Meeting.proposedDatePublished ]}
    flow obtainAgreement
  }
  activity obtainAgreement {
    name "Obtain agreement" type task lane MeetingParticipant
    pre {[ self.target_MeetingScheduler_in_Meeting.proposedDatePublished ]}
    post {[
      self.target_MeetingParticipant_in_Meeting
        ->forAll(participant | participant.agreementProvided)
    ]}
    flow importantParticipantDecision
  }
  gateway importantParticipantDecision {
    lane MeetingScheduler type xor
    flow assureImportantAttendance when {[
      not self.target_ImportantParticipant_in_Meeting->isEmpty()
    ]}
    flow agreementsComplete default
  }
  activity assureImportantAttendance {
    name "Assure important-participant attendance" type task lane ImportantParticipant
    post {[
      self.target_ImportantParticipant_in_Meeting
        ->forAll(participant | participant.agreementProvided and participant.attendanceAssured)
    ]}
    flow agreementsComplete
  }
  gateway agreementsComplete {
    lane MeetingScheduler type xor
    pre {[
      self.target_MeetingParticipant_in_Meeting
        ->forAll(participant | participant.agreementProvided)
      and self.target_ImportantParticipant_in_Meeting
        ->forAll(participant | participant.attendanceAssured)
    ]}
    flow scheduleMeeting
  }
  activity scheduleMeeting {
    name "Schedule meeting" type task lane MeetingScheduler
    post {[ self.meetingScheduled ]}
    flow announceMeeting
  }
  activity announceMeeting {
    name "Announce meeting" type task lane MeetingScheduler
    post {[ self.scheduleAnnounced ]}
    flow attendMeeting
  }
  activity attendMeeting {
    name "Attend meeting" type task lane MeetingParticipant
    post {[
      self.target_MeetingParticipant_in_Meeting
        ->forAll(participant | participant.attending)
      and self.target_ImportantParticipant_in_Meeting
        ->forAll(participant | participant.attending)
    ]}
    flow meetingCompleted
  }
  end meetingCompleted { lane MeetingInitiator trigger none }
}
