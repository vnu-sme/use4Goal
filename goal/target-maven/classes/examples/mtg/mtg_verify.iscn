// Same cast and same FINAL outcome as mtg.soil, written against the .iscn fire/assign
// mechanism instead of real .use objects -- exists only to structurally AND value-compare
// IStarScenarioEvaluator's instance graph against IStarUseTraceEvaluator's for the identical
// scenario (same 5 participants, same calendar/phone split).
//
// .iscn has no notion of OCL: a Goal whose only path to Fulfilled in mtg.istar is its own
// ocl {[...]} clause (TimetableCollected, HaveSchedulingPerformedByOrganizer,
// MeetingAttendedByParticipant -- none of them reachable from any fire'd leaf task through
// AND/OR/contribution anymore, by design: see mtg.istar's own header comment) has no way to
// become Fulfilled here except an explicit assign mirroring what the OCL would have derived
// from the .soil run. That is not a workaround, it is the whole point of the .iscn vs.
// .use+.soil comparison: .iscn needs the scenario author to state these fact by hand,
// .use+.soil derives them from real state.

scenario MeetingSchedulerVerify for "mtg.istar" {
    instance abdul   : Initiator;
    instance matilda : Organizer;
    instance alex, hung : Secretary;
    instance xing, amr, naya, bao, chloe : Participant;

    fire DecideMeetingDetails;
    fire ChooseTimeAndDate;

    fire xing.CollectFromCalendar;
    fire amr.CollectFromCalendar;
    // naya/bao/chloe never used the calendar channel in mtg.soil -- CollectFromCalendar's own
    // OCL genuinely evaluates false for them (not "unknown"), so state that directly instead of
    // leaving their trace at the default Unknown.
    assign naya.CollectFromCalendar = Pending;
    assign bao.CollectFromCalendar  = Pending;
    assign chloe.CollectFromCalendar = Pending;

    assign xing.QuickScheduling = True;
    assign amr.QuickScheduling  = True;

    fire alex.CollectConstraintsByPhone for naya;
    fire hung.CollectConstraintsByPhone for bao;
    fire hung.CollectConstraintsByPhone for chloe;

    fire xing.AnnounceMeeting;
    fire amr.AnnounceMeeting;
    fire naya.AnnounceMeeting;
    fire bao.AnnounceMeeting;
    fire chloe.AnnounceMeeting;

    fire xing.Participate;
    fire amr.Participate;
    fire naya.Participate;
    fire bao.Participate;
    assign chloe.Participate = Pending;

    // Every participant's timetable ends up #collected in mtg.soil regardless of channel --
    // TimetableCollected's own ocl clause derives this from real state; .iscn has to be told.
    assign xing.TimetableCollected  = Fulfilled;
    assign amr.TimetableCollected   = Fulfilled;
    assign naya.TimetableCollected  = Fulfilled;
    assign bao.TimetableCollected   = Fulfilled;
    assign chloe.TimetableCollected = Fulfilled;

    // Every participant's attendance ends up #attended in mtg.soil.
    assign xing.MeetingAttendedByParticipant  = Fulfilled;
    assign amr.MeetingAttendedByParticipant   = Fulfilled;
    assign naya.MeetingAttendedByParticipant  = Fulfilled; 
    assign bao.MeetingAttendedByParticipant   = Fulfilled;
    assign chloe.MeetingAttendedByParticipant = Pending;

    // matilda's own ocl-derived fact -- left unqualified: Organizer only ever has one
    // instance, so there is nothing to qualify against, and unqualified is exactly what
    // makes IStarScenarioCompiler broadcast a fact into every other declared instance's
    // own private trace too.
    assign HaveSchedulingPerformedByOrganizer = Fulfilled;

    // HavePPCalled is restored as an OR-child of TimetableCollected (see mtg.istar), so it is
    // now per-participant like CollectFromCalendar, not a single Organizer-wide fact: true for
    // whoever was actually collected by phone in mtg.soil, pending for whoever used their own
    // calendar instead. Inclusivity then follows automatically via propagation/contribution,
    // same as .soil derives it.
    assign xing.HavePPCalled  = Pending;
    assign amr.HavePPCalled   = Pending;
    assign naya.HavePPCalled  = Fulfilled;
    assign bao.HavePPCalled   = Fulfilled;
    assign chloe.HavePPCalled = Fulfilled;
}
