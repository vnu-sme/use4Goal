-- TOCL constraints generated from ClassroomGoals.istar
-- Each 'context C inv Name:' block encodes one iStar GoalType property.
-- Mapping: Achieve=eventually, Maintain=always, Sustain=eventually-always.

-- Teacher::ClassCompleted [ACHIEVE]
context Teacher
inv ACHIEVE_ClassCompleted:
  sometime self.ClassCompleted_condition()

-- Teacher::LessonDelivered [ACHIEVE]
context Teacher
inv ACHIEVE_LessonDelivered:
  sometime self.LessonDelivered_condition()

-- Teacher::AttendanceSummaryRecorded [ACHIEVE]
context Teacher
inv ACHIEVE_AttendanceSummaryRecorded:
  sometime self.AttendanceSummaryRecorded_condition()

-- Tasks of Teacher — pre/post OCL is in the .use file as class operations:
--   self.RecordAttendanceManually_preHolds() : Boolean
