aol v2.0 ClassroomQuestionsAnswered for "classroom.acl" {
  group Classroom as classroom1 {
    lessonStarted = true;
    slidesReady = true;
    rosterChecked = true;
    attendanceRecorded = true;
    attendanceMethod = electronic;
    lessonDelivered = true;
    needsClarification = false;
  }
  role Person as teacherPerson;
  role Teacher as teacher1 { attendanceStarted = true; }
  play teacherPerson -> teacher1;
  role Person as studentPerson;
  role Student as student1 {
    attendanceMarked = true;
    present = true;
  }
  play studentPerson -> student1;
  link Classroom_contains_Teacher : classroom1 -> teacher1;
  link Classroom_contains_Student : classroom1 -> student1;
}
