istar OJSGoals {
  role Author {
    goal SubmissionProcessed
    goal ReviewsCompleted > SubmissionProcessed
    goal DecisionRecorded > SubmissionProcessed
    goal ReviewsCompletedForAll > forall Review ReviewsCompleted post {[
      self.recommendation = Recommendation::accept
    ]}
    goal DecisionRecordedByEditor > pick SectionEditor DecisionRecorded post {[
      ReviewRound.allInstances()->forAll(r | r.editorDecision = EditorDecision::accept)
    ]}
  }
  role Review {
    task ReviewSubmission post {[ self.recommendation = Recommendation::accept ]}
  }
  role SectionEditor {
    task DecideSubmission post {[
      ReviewRound.allInstances()->forAll(r | r.editorDecision = EditorDecision::accept)
    ]}
  }
}
