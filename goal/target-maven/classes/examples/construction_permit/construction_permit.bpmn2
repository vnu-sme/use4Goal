// BPMN 2.0 Example — Construction Permit Approval
// Paired case study for i*/BPMN2 conformance checking (see doc/paper/conformance-istar-bpmn2.md)
// Single pool, two lanes; deliberately structured so gw_decision is a plain XOR
// (no loop-back), matching the Workflow-net shape used in Caballero-Villalobos et al. (2026).

model ConstructionPermitApproval {

  pool CityHall {
    name "City Hall"
    lane frontdesk_lane {
      name "Front Desk"
      start start1 { trigger none }      task submitApplication { name "Submit Application" }      task registerApplication { name "Register Application" }    }
    lane authority_lane {
      name "Authority"
      task assessApplication { name "Assess Application" }      gateway gw_decision { type xor }      task approve { name "Approve" }      task deny { name "Deny" }      end end_approved { trigger none }      end end_denied { trigger none }    }
    flow start1 -> submitApplication
    flow submitApplication -> registerApplication
    flow registerApplication -> assessApplication
    flow assessApplication -> gw_decision
    flow gw_decision -> approve { name "meets conditions" }    flow gw_decision -> deny { name "fails conditions" }    flow approve -> end_approved
    flow deny -> end_denied
  }
}
