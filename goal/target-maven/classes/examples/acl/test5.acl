acl v2.0 CrossTeamReleaseShadow {
  enum ReleaseState {planned, testing, approved, deployed}

  entity BuildArtifact {
    testsPassed : Boolean;
  }

  entity DeploymentRecord {
    productionUpdated : Boolean;
  }

  abstract role ReleaseRole {
    name : String;
  }

  role Developer specializes ReleaseRole {
    codeReady : Boolean;
  }

  role Tester specializes ReleaseRole {
    regressionDone : Boolean;
  }

  role ReleaseManager specializes ReleaseRole {
    approvalGiven : Boolean;
  }

  group BuildTeam {
    buildGreen : Boolean;

    Developer     [1..*];
    Tester        [1..*];
    BuildArtifact [1..*];
  }

  group ReleaseBoard {
    state : ReleaseState;

    ReleaseManager  [1..1];
    DeploymentRecord [0..*];
  }

  relationship ArtifactCreatesDeployment {
    BuildArtifact    [*] artifacts;
    DeploymentRecord [*] deployments;
  }

  link communication Developer -> Tester intra BuildTeam;
  link authority ReleaseManager -> Tester intra BuildTeam;
}
