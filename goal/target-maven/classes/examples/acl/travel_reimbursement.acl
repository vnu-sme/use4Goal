acl v2.0 TravelReimbursementShadow {
  enum ReimbursementStatus {draft, submitted, approved, paid, rejected}

  entity Receipt {
    verified : Boolean;
  }

  entity Itinerary {
    booked : Boolean;
  }

  abstract role TravelParty {
    name : String;
  }

  role Student specializes TravelParty {
    tripAuthorized : Boolean;
  }

  role TravelAgency specializes TravelParty {
    ticketIssued : Boolean;
  }

  role FinanceOfficer specializes TravelParty {
    reimbursementProcessed : Boolean;
  }

  relationship StudentSubmitsReceipt {
    Student [1] traveler;
    Receipt [*] receipts;
  }

  relationship AgencyBooksItinerary {
    TravelAgency [*] agencies;
    Itinerary    [*] itineraries;
  }

  group TravelClaim {
    authorized : Boolean;
    reimbursed : Boolean;
    status     : ReimbursementStatus;

    Student        [1..1];
    TravelAgency   [0..1];
    FinanceOfficer [1..1];
    Receipt        [1..*];
    Itinerary      [0..*];
  }

  link communication Student -> TravelAgency intra TravelClaim;
  link authority FinanceOfficer -> Student intra TravelClaim;
}
