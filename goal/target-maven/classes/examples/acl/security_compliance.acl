acl v2.0 SecurityComplianceShadow {
  enum RiskLevel {low, medium, high, critical}

  entity ITSystem {
    vulnerabilityPatched : Boolean;
    monitoringDeployed   : Boolean;
  }

  entity AuditFinding {
    remediated : Boolean;
  }

  abstract role SecurityRole {
    name : String;
  }

  role SystemOwner specializes SecurityRole {
    riskAccepted : Boolean;
  }

  role SecurityAnalyst specializes SecurityRole {
    assessmentCompleted : Boolean;
  }

  role ComplianceOfficer specializes SecurityRole {
    signoffDone : Boolean;
  }

  relationship AnalystFindsIssues {
    SecurityAnalyst [*] analysts;
    AuditFinding    [*] findings;
  }

  relationship OwnerAcceptsFinding {
    SystemOwner  [*] owners;
    AuditFinding [*] acceptedFindings;
  }

  group ComplianceCase {
    breachDetected : Boolean;
    riskLevel      : RiskLevel;
    caseClosed     : Boolean;

    SystemOwner       [1..1];
    SecurityAnalyst   [1..*];
    ComplianceOfficer [1..1];
    ITSystem          [1..*];
    AuditFinding      [0..*];
  }

  link authority ComplianceOfficer -> SecurityAnalyst intra ComplianceCase;
  link communication SecurityAnalyst -> SystemOwner intra ComplianceCase;
}
