acl v2.0 AirPassengerRightsClaimShadow {
  enum ClaimDecision {pending, approved, rejected}

  entity Flight {
    flightCode   : String;
    delayMinutes : Integer;
  }

  entity EvidenceBundle {
    delayMeasured           : Boolean;
    circumstancesDocumented : Boolean;
  }

  abstract role ClaimParty {
    name : String;
  }

  role Passenger specializes ClaimParty {
    ticketNumber : String;
    notified     : Boolean;
  }

  agent Airline {
    name : String;
    evaluationCompleted : Boolean;
  }

  relationship ClaimEvidence {
    Passenger      [*] claimants;
    EvidenceBundle [*] submittedEvidence;
  }

  relationship AirlineEvaluatesPassenger {
    Airline   [1] evaluator;
    Passenger [*] evaluatedPassengers;
  }

  group CompensationClaim {
    claimOpened          : Boolean;
    compensationApproved : Boolean;
    decision             : ClaimDecision;

    Passenger      [1..*];
    Airline        [1..1];
    Flight         [1..1];
    EvidenceBundle [0..*];
  }
}
