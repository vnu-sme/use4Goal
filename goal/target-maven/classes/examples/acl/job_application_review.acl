acl v2.0 JobApplicationReviewShadow {
  enum ApplicationOutcome {pending, shortlisted, rejected, offered}

  entity Resume {
    parsed : Boolean;
  }

  entity InterviewReport {
    completed : Boolean;
  }

  abstract role HiringParty {
    name : String;
  }

  role Candidate specializes HiringParty {
    profileSubmitted : Boolean;
  }

  role Recruiter specializes HiringParty {
    screeningDone : Boolean;
  }

  role HiringManager specializes HiringParty {
    decisionMade : Boolean;
  }

  relationship CandidateProvidesResume {
    Candidate [1] candidate;
    Resume    [*] resumes;
  }

  relationship ManagerReviewsReport {
    HiringManager   [*] managers;
    InterviewReport [*] reports;
  }

  group ApplicationReview {
    applicationReceived  : Boolean;
    interviewScheduled   : Boolean;
    outcomeCommunicated  : Boolean;
    outcome              : ApplicationOutcome;

    Candidate       [1..1];
    Recruiter       [1..1];
    HiringManager   [1..*];
    Resume          [1..*];
    InterviewReport [0..*];
  }

  link authority HiringManager -> Recruiter intra ApplicationReview;
  link communication Recruiter -> Candidate intra ApplicationReview;
}
