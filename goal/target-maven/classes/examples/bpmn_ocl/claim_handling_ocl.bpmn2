// BPMN state-predicate example.
//
// pre/post/guard are Boolean OCL expressions. They never mutate the USE state.
// An external action adapter changes the state between begin(task) and
// complete(task); the engine then verifies the task's postcondition.

model ClaimHandlingWithOcl {
  pool ClaimOffice {
    name "Claim Office"

    lane Intake {
      name "Intake"

      start claim_received {
        trigger message
        pre {[
          self.submitted = true
        ]}
      }

      task register_claim {
        name "Register Claim"
        post {[
          self.registered = true
        ]}
      }
    }

    lane Assessor {
      name "Assessor"

      task validate_claim {
        name "Validate Claim"
        post {[
          self.checked = true
        ]}
      }

      gateway eligibility_decision {
        name "Eligibility decision"
        type xor
        pre {[
          self.checked = true
        ]}
      }

      task approve_claim {
        name "Approve Claim"
        post {[
          self.status = #approved
        ]}
      }

      task reject_claim {
        name "Reject Claim"
        post {[
          self.status = #rejected
        ]}
      }

      end claim_closed {
        trigger none
        post {[
          self.status = #approved or self.status = #rejected
        ]}
      }
    }

    flow claim_received -> register_claim
    flow register_claim -> validate_claim
    flow validate_claim -> eligibility_decision

    flow eligibility_decision -> approve_claim {
      name "eligible"
      guard {[
        self.eligible = true
      ]}
    }

    flow eligibility_decision -> reject_claim {
      name "not eligible"
      guard {[
        self.eligible = false
      ]}
    }

    flow approve_claim -> claim_closed
    flow reject_claim -> claim_closed
  }
}
