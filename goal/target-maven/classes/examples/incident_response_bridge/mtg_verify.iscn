scenario IncidentResponseBridgeVerify for "mtg.istar" {
    instance coord : Coordinator;
    instance ann, bob : Analyst;
    instance tara, minh : Technician;
    instance audrey : Auditor;

    fire TriageIncident;
    fire ann.AnalyzeEvidence;
    fire bob.AnalyzeEvidence;
    fire tara.RepairService;
    fire audrey.AuditClosure;
}
