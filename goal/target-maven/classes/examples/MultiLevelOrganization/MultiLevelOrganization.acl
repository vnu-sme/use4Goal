acl v2.0 MultiLevelOrganization {
  // Every Role occurrence owns its attributes; Role specialization is a play chain.
  enum ResponseStatus { pending, accepted, declined }
  enum ReviewStatus { notStarted, reviewing, submitted }
  enum AttendanceStatus { unknown, attended, absent }

  entity Document {
    title : String;
    uri : String;
  }

  // Tầng 1: thuộc tính nhận dạng chung của Agent.
  role Person {
    name : String;
    phone : String;
  }

  // Tầng 2: thông tin ổn định khi Agent là thành viên tổ chức.
  role OrganizationMember extends Person {
    email : String;
    membershipActive : Boolean;
  }

  // Tầng 3: capability chung của người tham gia meeting.
  role MeetingParty extends OrganizationMember {
    hasCalendar : Boolean;
  }

  // Tầng 4: trạng thái riêng trong từng meeting.
  role Participant extends MeetingParty {
    invitationAccepted : Boolean;
    response : ResponseStatus;
    notified : Boolean;
    attendance : AttendanceStatus;
  }

  // Một chuyên môn hóa khác ở tầng 4.
  role Organizer extends MeetingParty {
    agendaPrepared : Boolean;
    meetingAnnounced : Boolean;
  }

  // Tầng 5: trạng thái riêng trong từng review panel.
  role TechnicalReviewer extends Participant {
    reviewStatus : ReviewStatus;
    conflictDeclared : Boolean;
  }

  group Organization {
    OrganizationMember [1..*];
    Department [1..*];

    OrganizationMember compatible MeetingParty;
  }

  group Department {
    MeetingParty [1..*];
    MeetingUnit [0..*];

  }

  group MeetingUnit {
    title : String;
    detailsDecided : Boolean;

    Organizer [1];
    Participant [2..*];
    ReviewPanel [0..*];

    Organizer compatible Participant;
  }

  group ReviewPanel {
    reviewClosed : Boolean;

    TechnicalReviewer [1..*];
  }

  composition reviewPanelDocuments {
    ReviewPanel [1] role panel;
    Document [1..*] role documents;
  }

  association reviewsDocument {
    TechnicalReviewer [0..*] role reviewers;
    Document [0..*] role reviewedDocuments;
  }
}
