istar MultiLevelOrganizationGoals {
  role TechnicalReviewer {
    // Every expression deliberately uses the short ACL form. Resolution is:
    //   name/phone       -> abstract Person profile on Agent
    //   email            -> OrganizationMember occurrence in containing Organization
    //   hasCalendar      -> MeetingParty occurrence in containing Department
    //   reviewStatus     -> this TechnicalReviewer occurrence
    goal ReviewerContextAvailable : Maintain activation {[
      true
    ]} satisfy {[
      self.name <> ''
      and self.phone <> ''
      and self.email <> ''
      and self.hasCalendar
      and self.reviewStatus = #submitted
    ]}
  }
}
