// Deliberately INVALID snapshot: alice plays both MeetingInitiator and
// MeetingScheduler. mtg.acl declares MeetingInitiator<->Participant
// compatible, but says nothing about MeetingScheduler -- so this must be
// rejected under the default (incompatible unless declared otherwise).

aol v1.0 MtgIncompatibleSnapshot for "../acl/mtg.acl" {
  agent alice, bob, carol, dave;

  group MeetingSchedulingUnit as unit1 {
    play MeetingInitiator as init1 by alice { name = "Alice"; }
    play MeetingScheduler as sched1 by alice { name = "Alice"; }
    play Participant as p1 by carol { name = "Carol"; }
    play Participant as p2 by dave { name = "Dave"; }

    entity Meeting as m1 { title = "Kickoff"; }
  }
}
