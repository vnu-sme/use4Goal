// Valid snapshot: alice plays Manager AND Employee at once inside company1 --
// allowed only because "compatibility Manager <-> Employee ... type compatible;"
// is declared in full_showcase_diagram_notations.acl.

aol v1.0 CompanySnapshot for "../acl/full_showcase_diagram_notations.acl" {
  agent alice, bob, carol, dave;

  group Company as company1 {
    play Manager as m1 by alice;
    play Employee as e1 by bob;
    play Employee as e2 by dave;
    play Employee as e3 by alice;

    entity Task as t1 { done = true; }
    entity Task as t2;

    group Team as team1 {
      play Employee as e4 by carol;
    }
  }
}
