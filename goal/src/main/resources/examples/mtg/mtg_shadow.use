-- USE/OCL structural shadow model for mtg.istar.
--
-- Design rule: every i* actor type is a first-class .use class, not a naming
-- convention on top of a generic Person. Each concrete actor role is an
-- associationclass linking the two things that make an actor instance
-- concrete: WHICH Meeting, and WHICH Person plays that role in it. This is
-- deliberate:
--   - self in a Task/Goal's OCL clause is always bound to an Actor instance,
--     never to Meeting directly. Because an Actor *is* an associationclass
--     over Meeting, self already knows exactly which Meeting it belongs to
--     via its own association end (self.organizedMeeting, self.participatingMeeting,
--     ...) -- no ambiguity even with several Meetings live at once.
--   - Role/Agent give i*'s own actorKind (role | agent) a real UML type, so
--     "is this class an Actor or a plain Entity" is answered by generalization,
--     not by a side mapping file.
--
-- Meeting and PhoneContact are plain Entities: they do not inherit Role/Agent.

model MeetingSchedulerShadow

enum TimetableStatus    {notRequested, requested, collected}
enum TimetableChannel   {none, calendar, phone}
enum NotificationStatus {notSent, sent}
enum AttendanceStatus   {unknown, attended, absent}

class Person
attributes
  name : String
end

class Meeting
attributes
  detailsDecided : Boolean
  timeChosen     : Boolean
end

class PhoneContact
attributes
  number : String
end

composition PersonPhoneContacts between
  Person       [1] role phoneOwner
  PhoneContact [*] role phoneContacts
end

-- Actor-kind roots, mirroring IStar.g4's actorKind : 'role' | 'agent'. Both
-- must themselves be associationclass, not class: USE rejects a plain class
-- as the superclass of an associationclass ("invalid inheritance relation
-- between meta elements"), so the marker root has to be the same meta-kind
-- as what inherits from it. Both carry the (Meeting, Person) ends every
-- concrete actor needs -- self.actorMeeting/self.actorPerson are inherited,
-- not redeclared, by every subclass below.
abstract associationclass Role between
  Meeting [*] role actorMeeting
  Person  [*] role actorPerson
end

abstract associationclass Agent between
  Meeting [*] role agentMeeting
  Person  [*] role agentPerson
end

associationclass Initiator < Role end

associationclass Organizer < Role end

associationclass Secretary < Role end

associationclass Participant < Role
attributes
  hasCalendar      : Boolean
  timetable        : TimetableStatus
  timetableChannel : TimetableChannel
  notified         : NotificationStatus
  attendance       : AttendanceStatus
end

-- Structural knowledge: a secretary knows how to call a participant only if
-- linked to one of that participant's phone contacts.
association SecretaryKnowsPhoneContact between
  Secretary    [*] role secretariesKnowingContact
  PhoneContact [*] role knownPhoneContacts
end
