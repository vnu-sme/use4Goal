// Migrated to the Class/Relationship-based ACL grammar. Behavioral role links
// from the old language have no structural equivalent and were removed:
// - link authority Organizer -> Secretary: authority/communication/
//   acquaintance links were removed from ACL (behavioral, not structural).
// Structural relations involving an Entity are represented explicitly by
// association, aggregation, or composition declarations.

acl v2.0 MeetingSchedulerShadow {
  enum TimetableStatus    { notRequested, requested, collected }
  enum TimetableChannel   { none, calendar, phone }
  enum NotificationStatus { notSent, sent }
  enum AttendanceStatus   { unknown, attended, absent }

  entity PhoneContact {
    number : String;
  }

  entity Meeting {
    detailsDecided : Boolean;
    timeChosen     : Boolean;
  }

  abstract role MeetingParty {
    name : String;
  }

  role Initiator   extends MeetingParty;
  role Organizer   extends MeetingParty;
  role Secretary   extends MeetingParty;
  role Participant extends MeetingParty {
    hasCalendar      : Boolean;
    timetable        : TimetableStatus;
    timetableChannel : TimetableChannel;
    notified         : NotificationStatus;
    attendance       : AttendanceStatus;
  }

  group MeetingUnit {
    role Initiator    [1..1];
    role Organizer    [1..1];
    role Secretary    [0..1];
    role Participant  [2..*];

    compatibility Initiator <-> Participant
      scope intra-group
      type compatible;

    compatibility Organizer <-> Secretary
      scope intra-group
      type compatible;

  }

  association know {
    MeetingParty [1];
    PhoneContact [*];
  }

  association meetingUnitMeetings {
    MeetingUnit [1];
    Meeting [*];
  }

  composition phoneContacts {
    MeetingParty [1];
    PhoneContact [*];
  }
}
