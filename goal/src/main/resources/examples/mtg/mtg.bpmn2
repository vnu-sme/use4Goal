// Meeting Scheduler. BPMN contains predicates only; there is no SOIL action.
// A caller performs each real action after begin(...) and before complete(...).

model MeetingScheduler {
  pool MeetingOrganization {
    name "Meeting Organization"

    lane Initiator {
      name "Initiator"

      start start_meeting {
        trigger none
      }

      task decideMeetingDetails {
        name "Decide Meeting Details"
        post {[
          Meeting.allInstances()->exists(m | m.detailsDecided)
        ]}
        effect {[
          for m in Meeting.allInstances() do
            m.detailsDecided := true;
          end
        ]}
      }
    }

    lane Organizer {
      name "Organizer"

      gateway gw_collect {
        type xor
        pre {[
          Meeting.allInstances()->exists(m | m.detailsDecided)
        ]}
        post {[
          Participant.allInstances()->notEmpty()
        ]}
      }

      task checkCalendar {
        name "Check Participant Calendar"
        pre {[
          Meeting.allInstances()->exists(m | m.detailsDecided)
        ]}
        post {[
          Participant.allInstances()
            ->select(p | p.hasCalendar)
            ->forAll(p | p.timetable = #collected and p.timetableChannel = #calendar)
        ]}
        effect {[
          for p in Participant.allInstances()->select(p | p.hasCalendar) do
            p.timetable := #collected;
            p.timetableChannel := #calendar;
          end
        ]}
      }

      task requestSecretaryCall {
        name "Request Secretary Call"
        pre {[
          Meeting.allInstances()->exists(m | m.detailsDecided)
          and Participant.allInstances()->exists(p | not p.hasCalendar)
        ]}
      }

      gateway gw_collect_join {
        type xor
        pre {[
          Participant.allInstances()->forAll(p | p.timetable = #collected)
        ]}
        post {[
          Participant.allInstances()->forAll(p | p.timetable = #collected)
        ]}
      }

      task chooseTimeAndDate {
        name "Choose Time And Date"
        pre {[
          Participant.allInstances()->forAll(p | p.timetable = #collected)
        ]}
        post {[
          Meeting.allInstances()->exists(m | m.timeChosen)
        ]}
        effect {[
          for m in Meeting.allInstances() do
            m.timeChosen := true;
          end
        ]}
      }

      task announceMeeting {
        name "Announce Meeting"
        pre {[
          Meeting.allInstances()->exists(m | m.timeChosen)
        ]}
        post {[
          Participant.allInstances()->forAll(p | p.notified = #sent)
        ]}
        effect {[
          for p in Participant.allInstances() do
            p.notified := #sent;
          end
        ]}
      }

      end end_meeting {
        trigger none
      }
    }

    lane Secretary {
      name "Secretary"

      task collectConstraintsByPhone {
        name "Collect Constraints By Phone"
        pre {[
          Participant.allInstances()->exists(p | not p.hasCalendar)
        ]}
        post {[
          Participant.allInstances()
            ->select(p | not p.hasCalendar)
            ->forAll(p | p.timetable = #collected and p.timetableChannel = #phone)
        ]}
        effect {[
          for p in Participant.allInstances()->select(p | not p.hasCalendar) do
            p.timetable := #collected;
            p.timetableChannel := #phone;
          end
        ]}
      }
    }

    lane Participant {
      name "Participant"

      task participate {
        name "Participate"
        pre {[
          Participant.allInstances()->forAll(p | p.notified = #sent)
        ]}
        post {[
          Participant.allInstances()->forAll(p | p.attendance = #attended)
        ]}
        effect {[
          for p in Participant.allInstances() do
            p.attendance := #attended;
          end
        ]}
      }
    }

    flow start_meeting -> decideMeetingDetails
    flow decideMeetingDetails -> gw_collect
    flow gw_collect -> checkCalendar {
      name "has calendar"
      guard {[
        Participant.allInstances()->forAll(p | p.hasCalendar)
      ]}
    }
    flow gw_collect -> requestSecretaryCall {
      name "no calendar"
      guard {[
        Participant.allInstances()->exists(p | not p.hasCalendar)
      ]}
    }
    flow requestSecretaryCall -> collectConstraintsByPhone
    flow collectConstraintsByPhone -> gw_collect_join
    flow checkCalendar -> gw_collect_join
    flow gw_collect_join -> chooseTimeAndDate
    flow chooseTimeAndDate -> announceMeeting
    flow announceMeeting -> participate
    flow participate -> end_meeting
  }
}
