// BPMN 2.0 Example — Meeting Scheduler
//
// One process represents the organization that owns/runs the workflow.
// Lanes represent roles inside that organization.

model MeetingScheduler {

  pool MeetingOrganization "Meeting Organization" {
    lane Initiator "Initiator" {
      start start_meeting : none
      task  decideMeetingDetails "Decide Meeting Details"
    }

    lane Organizer "Organizer" {
      gateway gw_collect      : xor
      task    checkCalendar        "Check Participant Calendar"
      task    requestSecretaryCall "Request Secretary Call"
      gateway gw_collect_join : xor
      task    chooseTimeAndDate    "Choose Time And Date"
      task    announceMeeting      "Announce Meeting"
      end     end_meeting : none
    }

    lane Secretary "Secretary" {
      task collectConstraintsByPhone "Collect Constraints By Phone"
    }

    lane Participant "Participant" {
      task participate "Participate"
    }

    flow start_meeting -> decideMeetingDetails
    flow decideMeetingDetails -> gw_collect
    flow gw_collect -> checkCalendar        : "has calendar"
    flow gw_collect -> requestSecretaryCall : "no calendar"
    flow requestSecretaryCall -> collectConstraintsByPhone
    flow collectConstraintsByPhone -> gw_collect_join
    flow checkCalendar -> gw_collect_join
    flow gw_collect_join -> chooseTimeAndDate
    flow chooseTimeAndDate -> announceMeeting
    flow announceMeeting -> participate
    flow participate -> end_meeting
  }
}
