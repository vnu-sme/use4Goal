// Partial i* scenario: scheduling input is complete, but the meeting has not been announced
// and nobody has participated yet. This should satisfy timetable/scheduling goals while
// leaving notification, attendance, and full organization unfulfilled.

scenario MeetingOrganization_FiveParticipants_PartialBeforeAnnounce for "mtg.istar" {
    instance abdul   : Initiator;
    instance matilda : Organizer;
    instance alex    : Secretary;
    instance xing, amr, naya, bao, chloe : Participant;

    fire DecideDetails;
    fire ChooseMeetingTime;

    fire xing.CollectFromCalendar;
    fire amr.CollectFromCalendar;
    fire alex.CollectByPhone for naya;
    fire alex.CollectByPhone for bao;
    fire alex.CollectByPhone for chloe;

    aggregate EveryTimetableCollected : all of Participant over TimetableCollected;
    aggregate EveryoneNotified        : all of Participant over NotifyParticipant;
    aggregate EveryoneAttended        : all of Participant over ParticipantAttended;
    aggregate MeetingFullyOrganized   : all of Participant over MeetingOrganized;
}
