// Deliberately incomplete solution used as a conformance counterexample.
// It reaches EndEvent but never performs Participant.participate, so the i* root
// goal concerning meeting attendance must remain unsatisfied.
model MeetingSchedulerGoalGap {
  pool MeetingOrganization for MeetingUnit {
    lane Initiator;
    lane Organizer;
  }

  start start_meeting {
    lane Initiator
    trigger none
    flow decideMeetingDetails
  }

  activity decideMeetingDetails {
    type task
    lane Initiator
    post {[
      self.detailsDecided
    ]}
    flow checkCalendar
  }

  activity checkCalendar {
    type task
    lane Organizer
    pre {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.source_Agent_plays_Participant.hasCalendar)
    ]}
    post {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.timetableCollected and p.timetableChannel = #calendar)
    ]}
    flow chooseTimeAndDate
  }

  activity chooseTimeAndDate {
    type task
    lane Organizer
    pre {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.timetableCollected)
    ]}
    post {[
      self.timeChosen
    ]}
    flow announceMeeting
  }

  activity announceMeeting {
    type task
    lane Organizer
    pre {[
      self.timeChosen
    ]}
    post {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.notified)
    ]}
    flow end_meeting
  }

  end end_meeting {
    lane Organizer
    trigger none
  }
}
