// Deliberately incomplete solution used as a conformance counterexample.
// It reaches EndEvent but never performs Participant.participate, so the i* root
// goal concerning meeting attendance must remain unsatisfied.
model MeetingSchedulerGoalGap {
  pool MeetingOrganization {
    lane Initiator {
      start start_meeting { trigger none }
      task decideMeetingDetails {
        post {[ Meeting.allInstances()->forAll(m | m.detailsDecided) ]}
        effect {[
          for m in Meeting.allInstances() do
            m.detailsDecided := true;
          end
        ]}
      }
    }

    lane Organizer {
      task checkCalendar {
        pre {[ Participant.allInstances()->forAll(p | p.hasCalendar) ]}
        post {[
          Participant.allInstances()->forAll(p |
            p.timetable = #collected and p.timetableChannel = #calendar)
        ]}
        effect {[
          for p in Participant.allInstances() do
            p.timetable := #collected;
            p.timetableChannel := #calendar;
          end
        ]}
      }
      task chooseTimeAndDate {
        pre {[ Participant.allInstances()->forAll(p | p.timetable = #collected) ]}
        post {[ Meeting.allInstances()->forAll(m | m.timeChosen) ]}
        effect {[
          for m in Meeting.allInstances() do
            m.timeChosen := true;
          end
        ]}
      }
      task announceMeeting {
        pre {[ Meeting.allInstances()->forAll(m | m.timeChosen) ]}
        post {[ Participant.allInstances()->forAll(p | p.notified = #sent) ]}
        effect {[
          for p in Participant.allInstances() do
            p.notified := #sent;
          end
        ]}
      }
      end end_meeting { trigger none }
    }

    flow start_meeting -> decideMeetingDetails
    flow decideMeetingDetails -> checkCalendar
    flow checkCalendar -> chooseTimeAndDate
    flow chooseTimeAndDate -> announceMeeting
    flow announceMeeting -> end_meeting
  }
}
