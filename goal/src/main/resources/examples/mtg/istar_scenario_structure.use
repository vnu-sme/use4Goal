-- USE/OCL structure model for i* scenario (.iscn) instance-level data.
--
-- Purpose: document the attributes carried by a scenario, its actor
-- instances, element occurrences, trace statements, and aggregate checks.
-- This is a structural companion to mtg.istar and mtg.iscn; it describes
-- the scenario layer, not the full type-level iStar metamodel.

model IStarScenarioStructure

enum ActorKind       {agent, role}
enum ElementKind     {goal, task, resource, quality, obstacle}
enum ScenarioStatus  {unknown, fulfilled, pending, trueValue, falseValue}
enum StatementKind   {fire, assign, aggregate}
enum AggregateMode   {all, any}

class IStarModel
attributes
  name      : String
  sourceUri : String
end

class ActorType
attributes
  name : String
  kind : ActorKind
end

class IntentionalElementType
attributes
  elementId : String
  kind      : ElementKind
end

class Scenario
attributes
  name      : String
  sourceUri : String
end

class ActorInstance
attributes
  name : String
end

class ElementOccurrence
attributes
  occurrenceId : String
  label        : String
  status       : ScenarioStatus
end

class ScenarioStatement
attributes
  orderNo : Integer
  kind    : StatementKind
end

class FireStatement < ScenarioStatement end

class AssignStatement < ScenarioStatement
attributes
  value : ScenarioStatus
end

class AggregateStatement < ScenarioStatement
attributes
  label : String
  mode  : AggregateMode
  holds : Boolean
end

association ModelActorTypes between
  IStarModel [1] role owningIStarModel
  ActorType  [*] role actorTypes
end

association ModelElementTypes between
  IStarModel             [1] role declaringModel
  IntentionalElementType [*] role elementTypes
end

association ActorOwnsElementTypes between
  ActorType              [1] role ownerType
  IntentionalElementType [*] role ownedElementTypes
end

association ScenarioUsesModel between
  Scenario  [*] role scenarios
  IStarModel [1] role referencedModel
end

composition ScenarioInstances between
  Scenario      [1] role scenario
  ActorInstance [*] role instances
end

association InstanceHasType between
  ActorInstance [*] role typedInstances
  ActorType     [1] role actorType
end

composition ScenarioOccurrences between
  Scenario          [1] role occurrenceScenario
  ElementOccurrence [*] role occurrences
end

association OccurrenceHasType between
  ElementOccurrence       [*] role typedOccurrences
  IntentionalElementType  [1] role elementType
end

association OccurrenceBelongsToInstance between
  ElementOccurrence [*] role instanceOccurrences
  ActorInstance     [0..1] role actorInstance
end

composition ScenarioStatements between
  Scenario          [1] role statementScenario
  ScenarioStatement [*] role statements
end

association StatementTargetOccurrence between
  ScenarioStatement [*] role targetingStatements
  ElementOccurrence [0..1] role targetOccurrence
end

association AggregateUniverseType between
  AggregateStatement [*] role aggregateStatements
  ActorType          [0..1] role universeActorType
end

association AggregateSatisfiedInstances between
  AggregateStatement [*] role satisfiedAggregates
  ActorInstance      [*] role satisfiedInstances
end

constraints

context IStarModel inv uniqueActorTypeNames:
  self.actorTypes->isUnique(name)

context IStarModel inv uniqueElementTypeIds:
  self.elementTypes->isUnique(elementId)

context Scenario inv uniqueActorInstanceNames:
  self.instances->isUnique(name)

context Scenario inv uniqueOccurrenceIds:
  self.occurrences->isUnique(occurrenceId)

context ElementOccurrence inv occurrenceTypeMatchesInstanceType:
  self.actorInstance->notEmpty() implies
    self.elementType.ownerType = self.actorInstance.actorType

context FireStatement inv fireTargetsGoalOrTask:
  self.targetOccurrence->notEmpty() and
  (self.targetOccurrence.elementType.kind = #goal or self.targetOccurrence.elementType.kind = #task)

context AssignStatement inv assignValueMatchesElementKind:
  self.targetOccurrence->notEmpty() and
  (
    ((self.targetOccurrence.elementType.kind = #goal or self.targetOccurrence.elementType.kind = #task)
      implies (self.value = #fulfilled or self.value = #pending))
    and
    (self.targetOccurrence.elementType.kind = #quality
      implies (self.value = #trueValue or self.value = #falseValue))
  )

context AggregateStatement inv aggregateHasUniverseOrWholeScenario:
  self.mode = #all or self.mode = #any
