// BPMN Scenario — partial Meeting Scheduler state.
//
// One meeting process instance has five participants and one initiator.
// Calendars were already found for two participants. The other three are
// currently waiting on the "request secretary call" branch.

scenario MeetingSchedulingPartial for "mtg.bpmn2" {
    process m1 : MeetingOrganization;

    actor abdul : Initiator;
    actor matilda : Organizer;
    actor alex : Secretary;
    actor xing, amr, naya, bao, chloe : Participant;

    bind m1.initiator = abdul;
    bind m1.organizer = matilda;
    bind m1.secretary = alex;
    bind m1.participants = [xing, amr, naya, bao, chloe];

    completed m1.checkCalendar for xing by matilda;
    completed m1.checkCalendar for amr by matilda;

    active m1.requestSecretaryCall for naya by matilda;
    active m1.requestSecretaryCall for bao by matilda;
    active m1.requestSecretaryCall for chloe by matilda;

    token m1.gw_collect::requestSecretaryCall for naya;
    token m1.gw_collect::requestSecretaryCall for bao;
    token m1.gw_collect::requestSecretaryCall for chloe;

    value xing.timetable = collected;
    value amr.timetable = collected;
    value naya.timetable = missing;
    value bao.timetable = missing;
    value chloe.timetable = missing;

    assert count(participants where timetable = collected) == 2;
    assert count(participants where timetable = missing) == 3;
}
