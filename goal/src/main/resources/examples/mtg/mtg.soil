-- One concrete execution over mtg_shadow.use, played against mtg.istar's OCL guards.
-- Each line below is one IStarUseTraceCompiler checkpoint (state-based, not
-- event-accumulation: a later line can just as well move a goal back to Pending).

meeting1 := new Meeting('meeting1');
meeting1.detailsDecided := false;
meeting1.timeChosen := false;

abdul := new Person('abdul');
matilda := new Person('matilda');
alex := new Person('alex');
hung := new Person('hung');
xing := new Person('xing');
amr := new Person('amr');
naya := new Person('naya');
bao := new Person('bao');
chloe := new Person('chloe');

init1 := new Initiator('init1') between (meeting1, abdul);
org1 := new Organizer('org1') between (meeting1, matilda);
sec1 := new Secretary('sec1') between (meeting1, alex);
sec2 := new Secretary('sec2') between (meeting1, hung);

px := new Participant('px') between (meeting1, xing);
pa := new Participant('pa') between (meeting1, amr);
pn := new Participant('pn') between (meeting1, naya);
pb := new Participant('pb') between (meeting1, bao);
pc := new Participant('pc') between (meeting1, chloe);

px.hasCalendar := true;
pa.hasCalendar := true;
pn.hasCalendar := false;
pb.hasCalendar := false;
pc.hasCalendar := false;

px.timetable := #notRequested;
pa.timetable := #notRequested;
pn.timetable := #notRequested;
pb.timetable := #notRequested;
pc.timetable := #notRequested;

px.timetableChannel := #none;
pa.timetableChannel := #none;
pn.timetableChannel := #none;
pb.timetableChannel := #none;
pc.timetableChannel := #none;

px.notified := #notSent;
pa.notified := #notSent;
pn.notified := #notSent;
pb.notified := #notSent;
pc.notified := #notSent;

px.attendance := #unknown;
pa.attendance := #unknown;
pn.attendance := #unknown;
pb.attendance := #unknown;
pc.attendance := #unknown;

nayaPhone := new PhoneContact('nayaPhone');
baoPhone := new PhoneContact('baoPhone');
chloePhone := new PhoneContact('chloePhone');
insert (naya, nayaPhone) into PersonPhoneContacts;
insert (bao, baoPhone) into PersonPhoneContacts;
insert (chloe, chloePhone) into PersonPhoneContacts;
insert (sec1, nayaPhone) into SecretaryKnowsPhoneContact;
insert (sec2, baoPhone) into SecretaryKnowsPhoneContact;
insert (sec2, chloePhone) into SecretaryKnowsPhoneContact;

meeting1.detailsDecided := true;

px.timetableChannel := #calendar;
px.timetable := #collected;

pa.timetableChannel := #calendar;
pa.timetable := #collected;

pn.timetableChannel := #phone;
pn.timetable := #collected;

pb.timetableChannel := #phone;
pb.timetable := #collected;

pc.timetableChannel := #phone;
pc.timetable := #collected;

meeting1.timeChosen := true;

px.notified := #sent;
pa.notified := #sent;
pn.notified := #sent;
pb.notified := #sent;
pc.notified := #sent;

px.attendance := #attended;
pa.attendance := #attended;
pn.attendance := #attended;
pb.attendance := #attended;
pc.attendance := #unknown;
