-- Initial object state for the Meeting Scheduler case study.
-- Process execution is not encoded here. BPMN is responsible for deciding which
-- activities run and how the state should evolve through their pre/post OCL.

meeting1 := new Meeting('meeting1');
meeting1.detailsDecided := false;
meeting1.timeChosen := false;

personAbdul := new Person('personAbdul');
personMatilda := new Person('personMatilda');
personAlex := new Person('personAlex');
personHung := new Person('personHung');
personXing := new Person('personXing');
personAmr := new Person('personAmr');
personNaya := new Person('personNaya');
personBao := new Person('personBao');
personChloe := new Person('personChloe');

abdul := new Initiator('abdul') between (meeting1, personAbdul);
matilda := new Organizer('matilda') between (meeting1, personMatilda);
alex := new Secretary('alex') between (meeting1, personAlex);
hung := new Secretary('hung') between (meeting1, personHung);

xing := new Participant('xing') between (meeting1, personXing);
amr := new Participant('amr') between (meeting1, personAmr);
naya := new Participant('naya') between (meeting1, personNaya);
bao := new Participant('bao') between (meeting1, personBao);
chloe := new Participant('chloe') between (meeting1, personChloe);

xing.hasCalendar := true;
amr.hasCalendar := true;
naya.hasCalendar := false;
bao.hasCalendar := false;
chloe.hasCalendar := false;

xing.timetable := #notRequested;
amr.timetable := #notRequested;
naya.timetable := #notRequested;
bao.timetable := #notRequested;
chloe.timetable := #notRequested;

xing.timetableChannel := #none;
amr.timetableChannel := #none;
naya.timetableChannel := #none;
bao.timetableChannel := #none;
chloe.timetableChannel := #none;

xing.notified := #notSent;
amr.notified := #notSent;
naya.notified := #notSent;
bao.notified := #notSent;
chloe.notified := #notSent;

xing.attendance := #unknown;
amr.attendance := #unknown;
naya.attendance := #unknown;
bao.attendance := #unknown;
chloe.attendance := #unknown;

nayaPhone := new PhoneContact('nayaPhone');
baoPhone := new PhoneContact('baoPhone');
chloePhone := new PhoneContact('chloePhone');
insert (personNaya, nayaPhone) into PersonPhoneContacts;
insert (personBao, baoPhone) into PersonPhoneContacts;
insert (personChloe, chloePhone) into PersonPhoneContacts;
insert (alex, nayaPhone) into SecretaryKnowsPhoneContact;
insert (hung, baoPhone) into SecretaryKnowsPhoneContact;
insert (hung, chloePhone) into SecretaryKnowsPhoneContact;
