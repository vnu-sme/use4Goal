// i* Scenario — same domain model as mtg.iscn (mtg.istar), new state: 5 Participant
// instances (xing, amr, naya + 2 more: charlie, bao) AND 2 Secretary instances (alex, hung).
// This is the first scenario in this project where a SECOND actor type (Secretary) also
// needs multiplicity, not just Participant — proving mtg.istar needed zero changes to
// support it: multiplicity is entirely a scenario-time concern (see
// doc/concept-domain-model-vs-scenario.md), never a domain-model concern.
//
// Facts of this state:
//   xing.hasCalendar = true,  amr.hasCalendar = true
//   naya.hasCalendar = false, charlie.hasCalendar = false, bao.hasCalendar = false
//   alex.canCall(naya) = true
//   alex.canCall(charlie) = false,  alex.canCall(bao) = false   -- alex doesn't have their numbers
//   hung.canCall(charlie) = true,   hung.canCall(bao) = true    -- hung does
//
// So naya is called by alex (as in mtg.iscn); charlie and bao are called by hung instead.
// The paired fire syntax mirrors mtg.pl's collectConstraintsByPhone(O,T,P): the task type is
// owned by Secretary, while the occurrence is distinguished by (Secretary instance, Participant).

scenario MeetingOrganization_FiveParticipants_TwoSecretaries for "mtg.istar" {
    instance abdul   : Initiator;
    instance matilda : Organizer;
    instance alex, hung : Secretary;
    instance xing, amr, naya, charlie, bao : Participant;

    fire DecideMeetingDetails;
    fire ChooseTimeAndDate;

    // xing, amr: hasCalendar = true -> organizer's own action, no secretary involved.
    fire xing.CollectFromCalendar;
    fire amr.CollectFromCalendar;

    // naya: no calendar, alex.canCall(naya) = true -> alex calls her.
    fire alex.CollectConstraintsByPhone for naya;

    // charlie, bao: no calendar, alex CANNOT call them -> hung calls them instead.
    fire hung.CollectConstraintsByPhone for charlie;
    fire hung.CollectConstraintsByPhone for bao;

    fire xing.AnnounceMeeting;
    fire amr.AnnounceMeeting;
    fire naya.AnnounceMeeting;
    fire charlie.AnnounceMeeting;
    fire bao.AnnounceMeeting;

    // Each participant's own action is fired; the initiator's delegated attendance goal is inferred.
    fire xing.Participate;
    fire amr.Participate;
    fire naya.Participate;
    fire charlie.Participate;
    fire bao.Participate;

    aggregate EveryTimetableCollected : all of Participant over TimetableCollected;
    aggregate EveryoneNotified        : all of Participant over AnnounceMeeting;
    aggregate EveryoneAttended        : all of Participant over MeetingAttendedByParticipant;
    aggregate MeetingFullyOrganized   : all of Participant over HaveMeetingOrganized;

    // 2 of 5 collected by calendar, 3 of 5 collected by a secretary phone call (split
    // across 2 different secretary instances — alex for naya, hung for charlie/bao):
    aggregate SomeInclusivityViaSecretary : any of Participant over Inclusivity;      // naya/charlie/bao -> holds
    aggregate UniversalQuickScheduling    : all of Participant over QuickScheduling;  // only xing/amr -> fails
}
