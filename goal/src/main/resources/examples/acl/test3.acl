acl v2.0 MultiGroupSupportShadow {
  entity SupportTicket {
    diagnosed : Boolean;
    resolved  : Boolean;
  }

  abstract role SupportRole {
    name : String;
  }

  role Customer specializes SupportRole {
    reachable : Boolean;
  }

  role FirstLineAgent specializes SupportRole {
    scriptedChecksDone : Boolean;
  }

  role Specialist specializes SupportRole {
    rootCauseFound : Boolean;
  }

  group SupportDesk {
    queueOpen : Boolean;

    Customer       [1..*];
    FirstLineAgent [1..*];
    SupportTicket  [0..*];
  }

  group EscalationCell specializes SupportDesk {
    escalationApproved : Boolean;

    Specialist [1..*];
  }

  relationship TicketEscalatedToSpecialist {
    SupportTicket [*] tickets;
    Specialist    [*] specialists;
  }

  link communication FirstLineAgent -> Specialist intra EscalationCell;
}
