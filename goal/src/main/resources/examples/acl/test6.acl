acl v2.0 ProcurementApprovalShadow {
  enum ApprovalState {requested, quoted, approved, ordered, rejected}

  entity Quote {
    valid : Boolean;
  }

  entity PurchaseOrder {
    issued : Boolean;
  }

  abstract role ProcurementParty {
    name : String;
  }

  role Requester specializes ProcurementParty {
    needConfirmed : Boolean;
  }

  role Buyer specializes ProcurementParty {
    quoteCollected : Boolean;
  }

  role Approver specializes ProcurementParty {
    budgetChecked : Boolean;
  }

  role Supplier specializes ProcurementParty {
    canDeliver : Boolean;
  }

  relationship BuyerRequestsQuote {
    Buyer    [*] buyers;
    Supplier [*] suppliers;
  }

  relationship SupplierProvidesQuote {
    Supplier [*] suppliers;
    Quote    [*] quotes;
  }

  relationship QuoteConvertedToPurchaseOrder {
    Quote         [1] acceptedQuote;
    PurchaseOrder [0..1] order;
  }

  group ProcurementCase {
    state         : ApprovalState;
    budgetReserved : Boolean;

    Requester     [1..1];
    Buyer         [1..1];
    Approver      [1..*];
    Supplier      [1..*];
    Quote         [0..*];
    PurchaseOrder [0..1];
  }

  link authority Approver -> Buyer intra ProcurementCase;
  link communication Buyer -> Supplier intra ProcurementCase;
}
