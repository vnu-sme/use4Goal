acl v2.0 MultiChannelFlightBookingShadow {
  enum BookingStatus {draft, reserved, issued, cancelled}
  enum PaymentStatus {unpaid, authorized, captured, failed}

  entity Flight {
    code           : String;
    seatsAvailable : Integer;
  }

  entity PaymentTransaction {
    status : PaymentStatus;
  }

  abstract role BookingParty {
    name : String;
  }

  role Customer specializes BookingParty {
    emailVerified : Boolean;
  }

  role SupportAgent specializes BookingParty {
    canOverridePayment : Boolean;
  }

  agent BookingSystem {
    inventoryLocked : Boolean;
  }

  agent PaymentGateway {
    online : Boolean;
  }

  relationship CustomerContactsSupport {
    Customer     [*] customers;
    SupportAgent [*] supportAgents;
  }

  relationship GatewayProcessesPayment {
    PaymentGateway     [1] gateway;
    PaymentTransaction [*] transactions;
  }

  group BookingCase {
    bookingCreated : Boolean;
    ticketIssued   : Boolean;
    status         : BookingStatus;

    Customer           [1..*];
    SupportAgent       [0..*];
    BookingSystem      [1..1];
    PaymentGateway     [1..1];
    Flight             [1..*];
    PaymentTransaction [0..*];
  }

  link communication Customer -> SupportAgent intra BookingCase;
  link authority SupportAgent -> Customer intra BookingCase;
}
