acl v2.0 Showcase {

  enum Status { A, B }

  abstract role Parent {
    attribute name : String;
  }

  role Manager extends Parent;
  role Employee;

  entity Task {
    attribute done : Boolean default false;
  }

  group Company {

    role Manager [1..1];
    role Employee [1..*];

    entity Task [0..*];

    subgroup Team [1..2] {
      role Employee [1..*];
    }

    link authority Manager -> Employee
      scope intra-group;

    link communication Manager <-> Employee
      scope intra-group;

    link acquaintance Manager <-> Employee
      scope inter-group
      extends-subgroups true;

    compatibility Manager <-> Employee
      scope intra-group;

    relation Assign creates Manager -> Task
      scope intra-group;

    cardinality role Employee [2..10];
    cardinality entity Task [0..*];
    cardinality subgroup Team [1..2];
  }
}