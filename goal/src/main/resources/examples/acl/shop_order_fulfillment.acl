acl v2.0 ShopOrderFulfillmentShadow {
  enum DeliveryStatus {notPacked, packed, shipped, delivered}

  entity Package {
    labelPrinted : Boolean;
  }

  entity PaymentRecord {
    captured : Boolean;
  }

  abstract role OrderParty {
    name : String;
  }

  role Customer specializes OrderParty {
    addressConfirmed : Boolean;
  }

  role WarehousePicker specializes OrderParty {
    picked : Boolean;
  }

  role Courier specializes OrderParty {
    shipmentAccepted : Boolean;
  }

  agent OrderSystem {
    stockReserved : Boolean;
  }

  relationship CustomerReceivesCourierUpdates {
    Courier  [*] couriers;
    Customer [*] notifiedCustomers;
  }

  relationship PackagePaidByRecord {
    Package       [*] packages;
    PaymentRecord [1] paymentRecord;
  }

  group OrderFulfillment {
    orderPlaced    : Boolean;
    inventoryReady : Boolean;
    deliveryStatus : DeliveryStatus;

    Customer        [1..1];
    WarehousePicker [1..*];
    Courier         [0..1];
    OrderSystem     [1..1];
    Package         [1..*];
    PaymentRecord   [1..1];
  }

  link communication Customer -> Courier intra OrderFulfillment;
  link authority WarehousePicker -> Courier intra OrderFulfillment;
}
