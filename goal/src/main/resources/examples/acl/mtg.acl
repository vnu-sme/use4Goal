acl v2.0 MeetingScheduler {

  enum AvailabilityStatus {
    notRequested,
    requested,
    collected
  }

  enum AvailabilityChannel {
    none,
    calendar,
    phone
  }

  enum NotificationStatus {
    notSent,
    sent
  }

  enum AttendanceStatus {
    unknown,
    attended,
    absent
  }

  enum MeetingStatus {
    preparing,
    scheduled,
    completed,
    cancelled
  }

  enum ProposedDateStatus {
    pending,
    accepted,
    rejected
  }

  enum AgreementStatus {
    pending,
    reached,
    rejected
  }

  /*
   * Role cha dùng để khai báo các thuộc tính chung.
   * Không được thêm trực tiếp vào group.
   */
  abstract role MeetingParty {
    attribute name  : String required;
    attribute email : String;
    attribute phone : String;
  }

  role MeetingInitiator extends MeetingParty;

  role MeetingScheduler extends MeetingParty;

  role Participant extends MeetingParty {
    attribute hasCalendar        : Boolean required mutable default false;
    attribute availabilityStatus : AvailabilityStatus required mutable default notRequested;
    attribute availabilityChannel: AvailabilityChannel required mutable default none;
    attribute notificationStatus : NotificationStatus required mutable default notSent;
    attribute attendanceStatus   : AttendanceStatus required mutable default unknown;
  }

  /*
   * Đối tượng nghiệp vụ trung tâm của quá trình scheduling.
   */
  entity Meeting {
    attribute title          : String required;
    attribute detailsDecided : Boolean required mutable default false;
    attribute selectedDate   : String mutable;
    attribute status         : MeetingStatus required mutable default preparing;
  }

  /*
   * Resource "Proposed Date" trong mô hình i*.
   */
  entity ProposedDate {
    attribute value  : String required;
    attribute status : ProposedDateStatus required mutable default pending;
  }

  /*
   * Resource "Agreement" trong mô hình i*.
   */
  entity Agreement {
    attribute status : AgreementStatus required mutable default pending;
  }

  group MeetingSchedulingUnit {

    role MeetingInitiator [1..1];
    role MeetingScheduler [1..1];
    role Participant      [2..*];

    entity Meeting      [1..1];
    entity ProposedDate [0..*];
    entity Agreement    [0..1];

    link communication MeetingInitiator <-> MeetingScheduler
      scope intra-group;

    link communication MeetingScheduler <-> Participant
      scope intra-group;

    link communication MeetingInitiator <-> Participant
      scope intra-group;

    compatibility MeetingInitiator <-> Participant
      scope intra-group;

    relation CreatesMeeting creates MeetingInitiator -> Meeting
      scope intra-group;
    cardinality role Participant [2..*];
  }
}
