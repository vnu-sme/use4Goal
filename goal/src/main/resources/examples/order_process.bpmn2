// BPMN 2.0 Collaboration Example — Order Fulfilment
// Two pools: Customer and Supplier
// Demonstrates: pools, lanes, events, gateways, message flows

collaboration OrderFulfilment {

  pool Customer "Customer" {
    lane order_lane "Order Management" {
      start  start1 : none
      task   placeOrder "Place Order"
      gateway gw_approved : xor
      task   makePayment "Make Payment"
      task   receiveGoods "Receive Goods"
      end    end_ok : none
      end    end_rejected : none
    }
    flow start1 -> placeOrder
    flow placeOrder -> gw_approved
    flow gw_approved -> makePayment : "approved"
    flow gw_approved -> end_rejected : "rejected"
    flow makePayment -> receiveGoods
    flow receiveGoods -> end_ok
  }

  pool Supplier "Supplier" {
    lane process_lane "Order Processing" {
      start  start2 : message
      gateway gw_stock : xor
      task   processOrder "Process Order"
      task   shipGoods "Ship Goods"
      end    end_ship : none
    }
    lane fulfil_lane "Fulfilment" {
      task   checkInventory "Check Inventory"
      task   rejectOrder "Reject Order"
      end    end_reject : none
    }
    flow start2 -> checkInventory
    flow checkInventory -> gw_stock
    flow gw_stock -> processOrder : "in stock"
    flow gw_stock -> rejectOrder  : "out of stock"
    flow processOrder -> shipGoods
    flow shipGoods -> end_ship
    flow rejectOrder -> end_reject
  }

  message-flow placeOrder -> start2 : "Order Request"
  message-flow gw_approved -> placeOrder : "Approval Notification"
  message-flow shipGoods -> receiveGoods : "Shipment Notification"
  message-flow rejectOrder -> gw_approved : "Rejection Notice"
}
