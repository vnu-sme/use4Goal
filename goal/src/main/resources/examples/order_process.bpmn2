// BPMN 2.0 Collaboration Example — Order Fulfilment
// Two pools: Customer and Supplier
// Demonstrates: pools, lanes, events, gateways, message flows

model OrderFulfilment {

  pool Customer {
    name "Customer"
    lane order_lane {
      name "Order Management"
      start start1 { trigger none }      task placeOrder { name "Place Order" }      gateway gw_approved { type xor }      task makePayment { name "Make Payment" }      task receiveGoods { name "Receive Goods" }      end end_ok { trigger none }      end end_rejected { trigger none }    }
    flow start1 -> placeOrder
    flow placeOrder -> gw_approved
    flow gw_approved -> makePayment { name "approved" }    flow gw_approved -> end_rejected { name "rejected" }    flow makePayment -> receiveGoods
    flow receiveGoods -> end_ok
  }

  pool Supplier {
    name "Supplier"
    lane process_lane {
      name "Order Processing"
      start start2 { trigger message }      gateway gw_stock { type xor }      task processOrder { name "Process Order" }      task shipGoods { name "Ship Goods" }      end end_ship { trigger none }    }
    lane fulfil_lane {
      name "Fulfilment"
      task checkInventory { name "Check Inventory" }      task rejectOrder { name "Reject Order" }      end end_reject { trigger none }    }
    flow start2 -> checkInventory
    flow checkInventory -> gw_stock
    flow gw_stock -> processOrder { name "in stock" }    flow gw_stock -> rejectOrder { name "out of stock" }    flow processOrder -> shipGoods
    flow shipGoods -> end_ship
    flow rejectOrder -> end_reject
  }

  message-flow placeOrder -> start2  message-flow gw_approved -> placeOrder  message-flow shipGoods -> receiveGoods  message-flow rejectOrder -> gw_approved}
