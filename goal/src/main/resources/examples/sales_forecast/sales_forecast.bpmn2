// Executable abstraction of Process 1: Sales Forecast.
model SalesForecastProcess {
  pool SalesForecastHandling for SalesCase {
    name "Sales Forecast Management"
    lane CustomerManager;
    lane Approver;
  }

  start salesCaseStarted {
    lane CustomerManager
    trigger none
    pre {[
      not self.proposal.created
      and not self.proposal.sent
    ]}
    flow prepareProposal
  }

  activity prepareProposal {
    name "Preparing sales proposal"
    type task
    lane CustomerManager
    post {[
      self.proposal.created
    ]}
    flow requestApproval
  }

  activity requestApproval {
    name "Requesting proposal approval"
    type task
    lane CustomerManager
    pre {[
      self.proposal.created
    ]}
    post {[
      self.proposal.approvalRequested
    ]}
    flow reviewDecision
  }

  gateway reviewDecision {
    lane Approver
    type xor
    flow reviewProposal post {[
      self.proposal.reviewCompleted
    ]}
    flow directSendWorkaround post {[
      not self.proposal.reviewCompleted
      and not self.proposal.approved
    ]}
  }

  activity reviewProposal {
    name "Reviewing proposal and assessing profitability"
    type task
    lane Approver
    pre {[
      self.proposal.approvalRequested
    ]}
    post {[
      self.proposal.reviewCompleted
      and self.proposal.approved
    ]}
    flow responseWindowCheck
  }

  activity directSendWorkaround {
    name "Bypassing formal approval workaround"
    type task
    lane CustomerManager
    post {[
      self.proposal.sent
    ]}
    flow forecastCompleted
  }

  gateway responseWindowCheck {
    lane CustomerManager
    type xor
    flow sendOnTime post {[
      self.proposal.sentWithinWindow
      and self.proposal.responseWindowOpen
    ]}
    flow sendDelayed post {[
      not self.proposal.sentWithinWindow
      and not self.proposal.responseWindowOpen
    ]}
  }

  activity sendOnTime {
    name "Sending proposal to customer on time"
    type task
    lane CustomerManager
    pre {[
      self.proposal.approved
    ]}
    post {[
      self.proposal.sent
      and self.proposal.sentWithinWindow
    ]}
    flow forecastCompleted
  }

  activity sendDelayed {
    name "Sending proposal after response window expired"
    type task
    lane CustomerManager
    pre {[
      self.proposal.approved
    ]}
    post {[
      self.proposal.sent
      and not self.proposal.sentWithinWindow
    ]}
    flow forecastCompleted
  }

  end forecastCompleted {
    lane CustomerManager
    trigger none
  }
}
