// Intentional view corresponding to Sales Forecast Process 1.
istar SalesForecastGoals {
  role CustomerManager {
    goal ProposalHandled : Achieve
    condition {[
      self.orgContext.proposal.sent
    ]}

    goal ProposalSentOnTime : Achieve
    condition {[
      self.orgContext.proposal.sentWithinWindow
    ]}

    task PrepareProposal
    post {[
      self.orgContext.proposal.created
    ]}

    task RequestApproval
    post {[
      self.orgContext.proposal.approvalRequested
    ]}

    task SendOnTime
    post {[
      self.orgContext.proposal.sent
      and self.orgContext.proposal.sentWithinWindow
    ]}

    task SendDelayed
    post {[
      self.orgContext.proposal.sent
    ]}
  }

  role Approver {
    goal ApprovalHandled : Achieve
    condition {[
      self.orgContext.proposal.approved
    ]}

    // Safety goal: Sent proposals must be formally reviewed and approved
    goal ProposalApprovalIntegrity : Maintain
    condition {[
      not self.orgContext.proposal.sent
      or (self.orgContext.proposal.reviewCompleted
        and self.orgContext.proposal.approved)
    ]}

    task ReviewProposal
    post {[
      self.orgContext.proposal.reviewCompleted
      and self.orgContext.proposal.approved
    ]}
  }
}
