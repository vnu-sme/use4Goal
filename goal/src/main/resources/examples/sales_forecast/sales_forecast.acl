// Shared organizational and domain state for Process 1: Sales Forecast.
acl v3.0 SalesForecastState {
  orgContext SalesCase {
    role Management;

    role CustomerManager {
      salesTargetCount : Integer mutable default 0;
    }

    role Approver {
      authorised : Boolean default true;
    }

    role Customer;

    entity Proposal {
      created : Boolean mutable default false;
      approvalRequested : Boolean mutable default false;
      reviewCompleted : Boolean mutable default false;
      approved : Boolean mutable default false;
      sent : Boolean mutable default false;
      sentWithinWindow : Boolean mutable default false;
      responseWindowOpen : Boolean mutable default true;
    }
  }

  context CustomerManager inv NonNegativeSalesTarget:
    self.salesTargetCount >= 0;

  context Proposal inv SentRequiresCreation:
    self.sent implies self.created;

  context Proposal inv SentRequiresApproval:
    self.sent implies self.approved;
}
