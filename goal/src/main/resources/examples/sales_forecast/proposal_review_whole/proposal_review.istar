// Intentional view reconstructed from the ProposalReview iStar diagram.
// The diagram labels the main boundary "Proposal"; ProposalManager is used
// as the executable actor identifier because it is the ACL Role responsible
// for the corresponding BPMN lane.
istar ProposalReviewGoals {
  role ProposalManager {
    goal ProposalCompleted : Achieve

    goal ProposalReadyForFinalization : Achieve
      > ProposalCompleted

    goal ProposalFinalizedAndSent : Achieve
      > ProposalCompleted

    // A Sustain condition records that validation was once established and
    // detects when Update proposal advances the current revision without
    // validating that new revision.
    goal CurrentProposalPreparedAndValidated : Sustain
      > ProposalReadyForFinalization
    condition {[
      self.orgContext.proposal.prepared
      and self.orgContext.proposal.validationRevision > 0
      and self.orgContext.proposal.validationRevision =
        self.orgContext.proposal.currentRevision
    ]}

    goal CustomerReviewReceived : Achieve
      > ProposalReadyForFinalization
    condition {[
      self.orgContext.customer.reviewCompleted
    ]}

    goal CustomerFeedbackResolved : Achieve
      > ProposalReadyForFinalization

    task PrepareProposal
      > CurrentProposalPreparedAndValidated
    post {[
      self.orgContext.proposal.prepared
      and self.orgContext.proposal.currentRevision > 0
    ]}

    task ValidateProposal
      > CurrentProposalPreparedAndValidated
    pre {[
      self.orgContext.proposal.prepared
      and self.authorityLevel >=
        self.orgContext.proposal.requiredAuthorityLevel
    ]}
    post {[
      self.orgContext.proposal.validationRevision =
        self.orgContext.proposal.currentRevision
    ]}

    goal ProposalAcceptedWithoutChanges : Achieve
      > or CustomerFeedbackResolved
    condition {[
      self.orgContext.customer.reviewCompleted
      and self.orgContext.customer.requestedChangeCount = 0
    ]}

    goal RequestedChangesIncorporated : Achieve
      > or CustomerFeedbackResolved
    condition {[
      self.orgContext.customer.reviewCompleted
      and self.orgContext.customer.requestedChangeCount > 0
      and self.orgContext.proposal.incorporatedChangeCount =
        self.orgContext.customer.requestedChangeCount
    ]}

    task UpdateProposal
      > or RequestedChangesIncorporated
    pre {[
      self.orgContext.customer.reviewCompleted
      and self.orgContext.customer.requestedChangeCount > 0
    ]}
    post {[
      self.orgContext.proposal.currentRevision >
        self.orgContext.proposal.validationRevision
      and self.orgContext.proposal.incorporatedChangeCount =
        self.orgContext.customer.requestedChangeCount
    ]}

    task FinalizeProposal
      > ProposalFinalizedAndSent
    pre {[
      self.authorityLevel >=
        self.orgContext.proposal.requiredAuthorityLevel
    ]}
    post {[
      self.orgContext.proposal.finalized
    ]}

    task SendProposal
      > ProposalFinalizedAndSent
    pre {[
      self.orgContext.proposal.finalized
    ]}
    post {[
      self.orgContext.proposal.sent
      and self.orgContext.proposal.sentRevision =
        self.orgContext.proposal.currentRevision
    ]}
  }

  role Customer {
    task ReviewProposal
    pre {[
      self.orgContext.proposal.prepared
      and self.orgContext.proposal.validationRevision =
        self.orgContext.proposal.currentRevision
    ]}
    post {[
      self.reviewCompleted
      and self.requestedChangeCount >= 0
    ]}
  }

  depend ProposalManager.CustomerReviewReceived
    -> goal ProposalReviewedByCustomer
    -> Customer.ReviewProposal
}
