-- Valid input scenario. No response activity has run yet.
!create incident1 : IncidentCase
!set incident1.reported := true
!set incident1.severity := #high
!set incident1.closed := false

!create service1 : Service
!set service1.restored := false
!insert (incident1, service1) into member_IncidentCase_Service
!create evidence1 : EvidencePacket
!set evidence1.complete := false
!insert (incident1, evidence1) into member_IncidentCase_EvidencePacket
!create change1 : ChangeRequest
!set change1.deployed := false
!insert (incident1, change1) into member_IncidentCase_ChangeRequest
!insert (change1, service1) into ChangeRestoresService
!create audit1 : AuditTrail
!set audit1.signed := false
!insert (incident1, audit1) into member_IncidentCase_AuditTrail

!create agentCoordinator : Agent
!create agentAnalyst : Agent
!create agentTechnician : Agent
!create agentAuditor : Agent
!set agentCoordinator.name := 'Coordinator'
!set agentAnalyst.name := 'Analyst'
!set agentTechnician.name := 'Technician'
!set agentAuditor.name := 'Auditor'
!create coordinator : Coordinator
!set coordinator.triaged := false
!insert (agentCoordinator, coordinator) into Agent_plays_Coordinator
!insert (incident1, coordinator) into Coordinator_in_IncidentCase
!create analyst : Analyst
!set analyst.reportReady := false
!insert (agentAnalyst, analyst) into Agent_plays_Analyst
!insert (incident1, analyst) into Analyst_in_IncidentCase
!create technician : Technician
!set technician.fixApplied := false
!insert (agentTechnician, technician) into Agent_plays_Technician
!insert (incident1, technician) into Technician_in_IncidentCase
!create auditor : Auditor
!set auditor.auditApproved := false
!insert (agentAuditor, auditor) into Agent_plays_Auditor
!insert (incident1, auditor) into Auditor_in_IncidentCase
