// iStar 2.0 Model — Hệ thống đặt vé máy bay đa kênh
// Thể hiện nhiều lựa chọn: kênh đặt vé, phương thức thanh toán, kênh nhận vé, ưu đãi VIP

istar DatVeMayBayDaKenh {

  // ==========================================
  // Vai trò: Khách hàng
  // ==========================================
  role KhachHang {
    goal      VeDuocDat                                              // Mục tiêu gốc: Vé được đặt thành công
    goal      ChuyenBayDuocChon > VeDuocDat                          // Mục tiêu con: Chọn được chuyến bay
    goal      DatVeQuaKenh      > VeDuocDat                          // Mục tiêu con: Đặt vé qua một kênh nào đó
    goal      ThanhToanHoanTat  > VeDuocDat                          // Mục tiêu con: Thanh toán hoàn tất
    goal      VeDuocNhan        > VeDuocDat                          // Mục tiêu con: Vé được nhận

    // Đặt vé qua kênh: tự nhập online HOẶC gọi tổng đài
    task      TuNhapThongTin > or DatVeQuaKenh > help KetQuaChinhXac // Tự nhập thông tin chính xác -> kết quả chính xác
    task      GoiTongDai     > or DatVeQuaKenh > help TienLoi        // Gọi tổng đài giúp tiện lợi hơn

    // Thanh toán: thẻ tín dụng, chuyển khoản, HOẶC ví điện tử
    task      ThanhToanTheTinDung  > or ThanhToanHoanTat > help ThanhToanAnToan
    task      ThanhToanChuyenKhoan > or ThanhToanHoanTat
    task      ThanhToanViDienTu    > or ThanhToanHoanTat > help ThanhToanAnToan

    // Nhận vé: qua email HOẶC SMS
    task      NhanVeQuaEmail > or VeDuocNhan
    task      NhanVeQuaSMS   > or VeDuocNhan

    // Ưu đãi VIP: chọn ghế và tích điểm thưởng góp phần vào ưu đãi VIP
    task      ChonGheUuThich > help UuDaiVIP
    task      TichDiemThuong > help UuDaiVIP

    resource  VeMayBay   > qualifies NhanVeQuaEmail > qualifies NhanVeQuaSMS
    resource  DiemThuong > qualifies TichDiemThuong
    quality   KetQuaChinhXac  > qualifies TuNhapThongTin
    quality   ThanhToanAnToan > qualifies ThanhToanTheTinDung > qualifies ThanhToanViDienTu
    quality   TienLoi         > qualifies GoiTongDai
    quality   UuDaiVIP        > qualifies ChonGheUuThich > qualifies TichDiemThuong
  }

  // ==========================================
  // Tác nhân: Hệ thống đặt vé (Website)
  // ==========================================
  agent HeThongDatVe {
    task      TraCuuChuyenBay  > help TocDoPhanHoiNhanh
    task      XacNhanThanhToan > help HeThongOnDinh
    task      GuiVeEmail
    task      GuiVeSMS
    resource  DanhSachChuyenBay > qualifies TraCuuChuyenBay
    resource  VeDienTu          > qualifies GuiVeEmail > qualifies GuiVeSMS
    resource  LichSuGiaoDich    > qualifies XacNhanThanhToan
    quality   TocDoPhanHoiNhanh > qualifies TraCuuChuyenBay
    quality   HeThongOnDinh     > qualifies XacNhanThanhToan
  }

  // ==========================================
  // Tác nhân: Tổng đài viên
  // ==========================================
  agent TongDaiVien {
    task      NhapThongTinHoKhach
    task      TuVanChuyenBay      > help DichVuChuDao
    resource  PhieuYeuCauDatVe > qualifies NhapThongTinHoKhach
    quality   DichVuChuDao     > qualifies TuVanChuyenBay
  }

  // ==========================================
  // Tác nhân: Cổng thanh toán
  // ==========================================
  agent CongThanhToan {
    task      XuLyTheTinDung  > help BaoMatCao
    task      XuLyChuyenKhoan > help BaoMatCao
    task      XuLyViDienTu    > help BaoMatCao
    resource  BienBanGiaoDich > qualifies XuLyTheTinDung > qualifies XuLyChuyenKhoan > qualifies XuLyViDienTu
    quality   BaoMatCao       > qualifies XuLyTheTinDung > qualifies XuLyChuyenKhoan > qualifies XuLyViDienTu
  }

  // ==========================================
  // Tác nhân: Ngân hàng
  // ==========================================
  agent NganHang {
    task      XacThucTaiKhoan
    task      PhoDuyetGiaoDich > help ChongGianLan
    resource  SaoKeGiaoDich > qualifies PhoDuyetGiaoDich
    quality   ChongGianLan  > qualifies PhoDuyetGiaoDich
  }

  // ==========================================
  // QUAN HỆ PHỤ THUỘC
  // ==========================================

  // ——— Khách hàng → Hệ thống đặt vé ———
  // Khi khách tự nhập thông tin, Hệ thống phải tra cứu chuyến bay
  depend KhachHang -> task TuNhapThongTin -> HeThongDatVe

  // Khi khách thanh toán bằng thẻ, Hệ thống phải xác nhận thanh toán
  depend KhachHang -> task ThanhToanTheTinDung -> HeThongDatVe

  // Khi khách thanh toán bằng chuyển khoản, Hệ thống phải xác nhận
  depend KhachHang -> task ThanhToanChuyenKhoan -> HeThongDatVe

  // Khi khách thanh toán bằng ví, Hệ thống phải xác nhận
  depend KhachHang -> task ThanhToanViDienTu -> HeThongDatVe

  // Khi khách muốn nhận vé qua email, Hệ thống phải gửi vé email
  depend KhachHang -> task NhanVeQuaEmail -> HeThongDatVe

  // Khi khách muốn nhận vé qua SMS, Hệ thống phải gửi vé SMS
  depend KhachHang -> task NhanVeQuaSMS -> HeThongDatVe

  // ——— Khách hàng → Tổng đài viên ———
  // Khi khách gọi tổng đài, tổng đài viên phải nhập thông tin hộ
  depend KhachHang -> task GoiTongDai -> TongDaiVien

  // ——— Hệ thống đặt vé → Cổng thanh toán ———
  // Khi hệ thống xác nhận thanh toán thẻ, cổng phải xử lý thẻ
  depend HeThongDatVe -> task XacNhanThanhToan -> CongThanhToan

  // ——— Cổng thanh toán → Ngân hàng ———
  // Khi cổng xử lý chuyển khoản, ngân hàng phải phê duyệt giao dịch
  depend CongThanhToan -> task XuLyChuyenKhoan -> NganHang

  // Khi cổng xử lý thẻ tín dụng, ngân hàng phải xác thực tài khoản
  depend CongThanhToan -> task XuLyTheTinDung -> NganHang
}
