// iStar 2.0 Example — Travel Reimbursement Scenario
// Based on iStar 2.0 Language Guide (Figure 2)

istar TravelReimbursement {

  role Student {
    goal   TravelOrganized
    goal   AuthorizationObtained > TravelOrganized
    goal   TripBooked            > TravelOrganized
    task   FillInOnlineForm > help NoErrors
    task   BuyFlightTickets > or TripBooked
    resource FlightReceipt > needed-by BuyFlightTickets
    quality  NoErrors > qualifies FillInOnlineForm
  }

  agent UnivOfWonderLand {
    task   ProcessReimbursement
    resource ReimbursementForm
    quality  InTime > qualifies ProcessReimbursement
  }

  role TravelAgency {
    task   IssueTicket > help LowCost
    resource Ticket > needed-by IssueTicket
    quality  LowCost
  }

  depend Student -> task BuyFlightTickets -> TravelAgency
  depend Student -> goal AuthorizationObtained -> UnivOfWonderLand
  depend Student -> task ProcessReimbursement -> UnivOfWonderLand
}
