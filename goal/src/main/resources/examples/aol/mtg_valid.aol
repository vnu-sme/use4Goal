// Valid snapshot: alice plays both MeetingInitiator and Participant, which
// mtg.acl explicitly declares compatible ("compatibility MeetingInitiator
// <-> Participant ... type compatible;").

aol v1.0 MtgValidSnapshot for "../acl/mtg.acl" {
  agent alice, bob, carol, dave;

  group MeetingSchedulingUnit as unit1 {
    play MeetingInitiator as init1 by alice { name = "Alice"; }
    play MeetingScheduler as sched1 by bob { name = "Bob"; }
    play Participant as p1 by carol { name = "Carol"; }
    play Participant as p2 by dave { name = "Dave"; }
    play Participant as p3 by alice { name = "Alice"; }

    entity Meeting as m1 { title = "Kickoff"; }
  }
}
