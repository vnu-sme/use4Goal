-- Execution trace for the iStar Execution Trace Stepper.
-- Open monitoring.acl + monitoring.istar + this file.

!create monitoringService : MonitoringService
!set monitoringService.monitoringEnabled := false
!set monitoringService.healthCheckCompleted := false

!create alice : Agent
!set alice.name := 'Alice'
!create monitorAlice : Monitor
!insert (alice, monitorAlice) into Agent_plays_Monitor
!insert (monitoringService, monitorAlice) into Monitor_in_MonitoringService

-- Activation becomes true: Recur is Pending because its condition is false.
!set monitoringService.monitoringEnabled := true

-- One successful recurrence occurrence.
!set monitoringService.healthCheckCompleted := true

-- Recur is not sticky: it returns to Pending and waits for the next occurrence.
!set monitoringService.healthCheckCompleted := false

-- A second successful occurrence.
!set monitoringService.healthCheckCompleted := true
