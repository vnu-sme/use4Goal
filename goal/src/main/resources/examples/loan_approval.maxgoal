/*
 * MAXGoal Example — Loan Approval Process
 *
 * Flowchart:
 *   Customer submits → LoanOfficer reviews (ITER until complete)
 *   → CreditBureau checks score
 *   → Underwriter decides (XOR: reject | finalize)
 *   → Customer confirms (XOR: cancel | sign)
 *   → LoanOfficer disburses
 */

model LoanApproval {

  // ── LOAN OFFICER ──────────────────────────────────────────────────────
  LoanOfficer : role {

    goal G_ProcessLoan {
      achieve: loan.status = "closed"
      refine:  SEQ [G_SubmitApp, G_Verify, G_CreditCheck, G_Underwrite]
    }

    goal G_Verify {
      achieve: application.complete = true
      refine:  ITER [G_ReviewDocs] until application.complete = true
    }

    goal G_ReviewDocs {
      achieve: docs.reviewed = true
    }

    goal G_Disburse {
      achieve: loan.disbursed = true
    }

    task T_PrelimCheck {
      pre:  application.submitted = true
      post: docs.reviewed = true
    }

    task T_RequestDocs {
      pre:  application.complete = false
      post: application.supplemented = true
    }

    task T_SendCreditQuery {
      pre:  application.complete = true
      post: creditQuery.sent = true
    }

    task T_Disburse {
      pre:  contract.signed = true
      post: loan.disbursed = true
      needby: disbursementFund
    }

    resource loanFile        : virtual
    resource disbursementFund : physical
  }

  // ── CUSTOMER ──────────────────────────────────────────────────────────
  Customer : agent {

    goal G_SubmitApp {
      achieve: application.submitted = true
    }

    goal G_CustomerConfirm {
      achieve: customer.responded = true
      refine:  XOR [(customer.agrees = false, G_CancelLoan),
                    (customer.agrees = true,  G_SignContract)]
    }

    goal G_CancelLoan {
      avoid: contract.signed = true
    }

    goal G_SignContract {
      achieve: contract.signed = true
    }

    task T_SubmitForm {
      pre:  form.filled = true
      post: application.submitted = true
    }

    task T_SignElectronically {
      pre:  customer.agrees = true
      post: contract.signed = true
      needby: loanContract
    }
  }

  // ── CREDIT BUREAU ─────────────────────────────────────────────────────
  CreditBureau : role {

    goal G_CreditCheck {
      achieve: creditScore.obtained = true
      refine:  SEQ [G_LookupScore, G_ReturnResult]
    }

    goal G_LookupScore {
      achieve: creditScore.retrieved = true
    }

    goal G_ReturnResult {
      achieve: creditResult.attached = true
    }

    task T_LookupCreditScore {
      pre:  creditQuery.sent = true
      post: creditScore.retrieved = true
    }

    task T_ReturnCreditResult {
      pre:  creditScore.retrieved = true
      post: creditResult.attached = true
    }

    resource creditReport : virtual
  }

  // ── UNDERWRITER ───────────────────────────────────────────────────────
  Underwriter : role {

    goal G_Underwrite {
      achieve: loan.decision <> ""
      refine:  XOR [(loan.risk = "high",       G_Reject),
                    (loan.risk = "acceptable",  G_FinalizeApproval)]
    }

    goal G_Reject {
      achieve: customer.notifiedRejection = true
    }

    goal G_FinalizeApproval {
      achieve: loan.finalized = true
      refine:  SEQ [G_ProposeTerms, G_CustomerConfirm, G_Disburse]
    }

    goal G_ProposeTerms {
      achieve: loanTerms.proposed = true
    }

    task T_AssessRisk {
      pre:  creditResult.attached = true
      post: loan.risk <> ""
    }

    task T_NotifyRejection {
      pre:  loan.risk = "high"
      post: customer.notifiedRejection = true
    }

    task T_ProposeTerms {
      pre:  loan.risk = "acceptable"
      post: loanTerms.proposed = true
    }

    resource loanContract : virtual
  }

  // ── CROSS-ACTOR DEPENDENCIES ──────────────────────────────────────────
  depend {
    G_SubmitApp    -> T_PrelimCheck          // customer submit → officer check
    G_ReviewDocs   -> T_LookupCreditScore   // officer review → bureau lookup
    G_LookupScore  -> T_ReturnCreditResult  // bureau lookup → bureau return
    G_ReturnResult -> T_AssessRisk          // bureau return → underwriter assess
    G_ProposeTerms -> T_SignElectronically  // underwriter propose → customer sign
    G_SignContract -> T_Disburse            // customer sign → officer disburse
  }
}
