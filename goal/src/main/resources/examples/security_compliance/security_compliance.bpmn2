// BPMN 2.0 Example — Security Compliance
// Transcribed from example/Data/security/bpmn.bpmn (real bpmn.io-exported BPMN XML).
// Flow (verified against the source XML's sourceRef/targetRef pairs):
//   start -> AND-split(updateEncryptionStandards, reviseAccessControls) -> AND-join
//   -> XOR-split(deployOneTrust | deployDataGrail) -> XOR-join -> performPenetrationTest
//   -> [end | flagSuspiciousActivity -> applyVulnerabilityTest -> back to performPenetrationTest]
// The last part is a genuine loop in the source (back-edge sequence flow) — kept as-is;
// performPenetrationTest has two outgoing flows directly (no gateway node), matching the
// source XML exactly (it draws the branch without an explicit gateway symbol there too).

collaboration SecurityCompliance {

  pool SecurityComplianceProcess "Security Compliance Process" {
    lane main_lane "Main" {
      start   start1 : none
      gateway gw_split : and
      task    updateEncryptionStandards "Update Encryption Standards"
      task    reviseAccessControls      "Revise Access Control"
      gateway gw_join   : and
      gateway gw_choice : xor
      task    deployOneTrust  "Deploy One Trust"
      task    deployDataGrail "Deploy Data Grail"
      gateway gw_merge  : xor
      task    performPenetrationTest "Perform Penetration Test"
      task    flagSuspiciousActivity "Flag Suspicious Activity"
      task    applyVulnerabilityTest "Apply Vulnerability Test"
      end     end1 : none
    }

    flow start1 -> gw_split
    flow gw_split -> updateEncryptionStandards
    flow gw_split -> reviseAccessControls
    flow updateEncryptionStandards -> gw_join
    flow reviseAccessControls      -> gw_join
    flow gw_join -> gw_choice
    flow gw_choice -> deployOneTrust
    flow gw_choice -> deployDataGrail
    flow deployOneTrust  -> gw_merge
    flow deployDataGrail -> gw_merge
    flow gw_merge -> performPenetrationTest
    flow performPenetrationTest -> end1
    flow performPenetrationTest -> flagSuspiciousActivity
    flow flagSuspiciousActivity -> applyVulnerabilityTest
    flow applyVulnerabilityTest -> performPenetrationTest
  }
}
