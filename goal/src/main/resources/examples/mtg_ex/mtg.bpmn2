// Meeting Scheduler. BPMN contains predicates only, no separate imperative
// effect: `post` is the sole state-changing clause. Where it is a plain
// conjunction of `self.attr = Expr` / `Coll->forAll(v | v.attr = Expr)`
// atoms, the runtime mechanically synthesizes the SOIL action that makes it
// true (Bpmn2PostEffect) between begin(...) and complete(...).
//
// `for MeetingUnit` scopes this pool to one MeetingUnit instance per run:
// every `self` below is that one group, never all groups in the system, so
// two MeetingUnit instances execute as two independent processes instead
// of being conflated through MeetingUnit.allInstances()/Participant.allInstances().

model MeetingScheduler {
  pool MeetingOrganization for MeetingUnit {
    name "Meeting Organization"
    lane Initiator;
    lane Organizer;
    lane Secretary;
    lane Participant;
  }

  start start_meeting {
    lane Initiator
    trigger none
    // Complete lifecycle entry condition. Profile data such as phone and
    // hasCalendar deliberately remains unconstrained input data.
    pre {[
      not self.detailsDecided
      and not self.timeChosen
      and self.target_Participant_in_MeetingUnit->forAll(p |
        not p.timetableCollected
        and p.timetableChannel = #none
        and not p.notified
        and not p.attended)
    ]}
    flow decideMeetingDetails
  }

  activity decideMeetingDetails {
    name "Decide Meeting Details"
    type task
    lane Initiator
    post {[
      self.detailsDecided
    ]}
    flow checkCalendar
  }

  activity checkCalendar {
    name "Check Participant Calendar"
    type task
    lane Organizer
    pre {[
      self.detailsDecided
    ]}
    post {[
      self.target_Participant_in_MeetingUnit
        ->select(p | p.source_Agent_plays_Participant.hasCalendar)
        ->forAll(p | p.timetableCollected and p.timetableChannel = #calendar)
    ]}
    flow phoneCollectionRequired
  }

  // Decides only whether the phone sub-path is ALSO needed for the
  // participants checkCalendar above could not cover; the default flow
  // skips straight to the join when every participant already has a
  // calendar.
  gateway phoneCollectionRequired {
    lane Organizer
    type xor
    pre {[
      self.target_Participant_in_MeetingUnit
        ->select(p | p.source_Agent_plays_Participant.hasCalendar)
        ->forAll(p | p.timetableCollected)
    ]}
    flow requestSecretaryCall when {[
      self.target_Participant_in_MeetingUnit->exists(p | not p.source_Agent_plays_Participant.hasCalendar)
    ]}
    flow timetableCollectionComplete default
  }

  activity requestSecretaryCall {
    name "Request Secretary Call"
    type task
    lane Organizer
    pre {[
      self.detailsDecided
      and self.target_Participant_in_MeetingUnit->exists(p | not p.source_Agent_plays_Participant.hasCalendar)
      and not self.target_Secretary_in_MeetingUnit.oclIsUndefined()
      and self.target_Participant_in_MeetingUnit->select(p | not p.source_Agent_plays_Participant.hasCalendar)->forAll(p |
        p.source_Agent_plays_Participant.phone <> ''
        and self.target_Secretary_in_MeetingUnit.source_Agent_plays_Secretary.knownContact
          ->includes(p.source_Agent_plays_Participant))
    ]}
    flow collectConstraintsByPhone
  }

  activity collectConstraintsByPhone {
    name "Collect Constraints By Phone"
    type task
    lane Secretary
    pre {[
      self.target_Participant_in_MeetingUnit->exists(p | not p.source_Agent_plays_Participant.hasCalendar)
      and not self.target_Secretary_in_MeetingUnit.oclIsUndefined()
      and self.target_Participant_in_MeetingUnit->select(p | not p.source_Agent_plays_Participant.hasCalendar)->forAll(p |
        p.source_Agent_plays_Participant.phone <> ''
        and self.target_Secretary_in_MeetingUnit.source_Agent_plays_Secretary.knownContact
          ->includes(p.source_Agent_plays_Participant))
    ]}
    post {[
      self.target_Participant_in_MeetingUnit
        ->select(p | not p.source_Agent_plays_Participant.hasCalendar)
        ->forAll(p | p.timetableCollected and p.timetableChannel = #phone)
    ]}
    flow timetableCollectionComplete
  }

  gateway timetableCollectionComplete {
    lane Organizer
    type xor
    pre {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.timetableCollected)
    ]}
    flow chooseTimeAndDate
  }

  activity chooseTimeAndDate {
    name "Choose Time And Date"
    type task
    lane Organizer
    pre {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.timetableCollected)
    ]}
    post {[
      self.timeChosen
    ]}
    flow announceMeeting
  }

  activity announceMeeting {
    name "Announce Meeting"
    type task
    lane Organizer
    pre {[
      self.timeChosen
    ]}
    post {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.notified)
    ]}
    flow participate
  }

  activity participate {
    name "Attend Scheduled Meeting"
    type task
    lane Participant
    pre {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.notified)
    ]}
    post {[
      self.target_Participant_in_MeetingUnit->forAll(p | p.attended)
    ]}
    flow end_meeting
  }

  end end_meeting {
    lane Organizer
    trigger none
  }
}
