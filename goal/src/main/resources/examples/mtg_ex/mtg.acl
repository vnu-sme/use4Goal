acl v2.0 MeetingSchedulerShadow {
  // Root Role state belongs to the MeetingParty occurrence shared by its play chain.
  role MeetingParty {
    name : String;
    phone : String;
    hasCalendar : Boolean;
  }

  // Child roles contain state acquired in one MeetingUnit.
  role Initiator extends MeetingParty;
  

  // Role-to-Role associations keep their Role endpoints.
  //association knowsPhoneOf {
  //  MeetingParty [*] role knower;
   // MeetingParty [*] role knownContact;
  //}

  group MeetingUnit {
    detailsDecided : Boolean;
    timeChosen : Boolean;

    Initiator [1];

  }

}
