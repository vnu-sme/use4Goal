-- Create two classrooms.
!create classroom1 : Classroom
!create classroom2 : Classroom

-- Create and assign one teacher to each classroom.
!create teacherMath : Teacher
!set teacherMath.name := 'Nguyen Minh'
!set teacherMath.specialty := 'Mathematics'
!insert (classroom1, teacherMath) into ClassroomTeacher

!create teacherPhysics : Teacher
!set teacherPhysics.name := 'Tran Lan'
!set teacherPhysics.specialty := 'Physics'
!insert (classroom2, teacherPhysics) into ClassroomTeacher

-- Add ten students to classroom1.
