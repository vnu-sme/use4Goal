istar CACCPlatoon {
  // Transcribed from: Daun, M., Brings, J., Krajinski, L., Stenkova, V.,
  // Bandyszak, T. (2021). "A GRL-compliant iStar extension for collaborative
  // cyber-physical systems." Requirements Engineering, 26(3), 325-370.
  // Sect. 5.1.5.1/5.2.1, the Cooperative Adaptive Cruise Control (CACC)
  // platoon case example (Fig. 22/23/28/30).
  //
  // The paper's own point is that PLAIN i* cannot express this domain well --
  // that is exactly why they built an extension. This project's own '.istar'
  // dialect confirms it in two concrete, compiler-enforced ways discovered
  // while validating this file:
  //   1. Element ids must be GLOBALLY unique across the whole model, not just
  //      per actor. LeadVehicle and FollowingVehicle share several element
  //      names in the paper (JoinPlatoon, RegulateSpeed, CollisionAvoidance,
  //      ...) since they are two roles of the same kind of thing (a CACC).
  //      Every shared name below had to be suffixed (*Lead / *Following) to
  //      compile -- the paper's own actor-multiplicity mechanism (letting
  //      one actor box stand for many identically-shaped CACCs) is exactly
  //      what would have avoided this duplication, and plain i* has nothing
  //      equivalent.
  //   2. Self-actor dependency (depender == dependee) is REJECTED outright by
  //      this dialect's validator. The paper's Fig. 30 self-dependency
  //      ("a following vehicle depends on another following vehicle to
  //      follow the previous vehicle") is therefore not just imprecise but
  //      STRUCTURALLY INEXPRESSIBLE here -- the line was removed rather than
  //      worked around; see the comment where it would have gone.
  // Further constructs with no equivalent at all in this dialect (silently
  // dropped, not approximated): CPS-network/CPS/role as three distinct actor
  // kinds (only role/agent exist -> Platoon = agent, Lead/Following vehicle =
  // role); actor and dependency multiplicities (e.g. Following vehicle
  // [1..19]); coordination task / is-assigned semantics (organize platoon
  // structure assigning the Following-vehicle role -- kept as a bare task);
  // bidirectional dependency (written as two ordinary 'depend' statements).
  //
  // Confidence note: actors, element names, and the relations below are taken
  // directly from the paper's running text (Sect. 5.2.1/5.3.2/5.3.3, Figs.
  // 28/30) -- high confidence. The CollisionAvoidance AND-refinement is
  // inferred from figure adjacency + domain semantics, not an explicit
  // sentence -- flagged inline. Softgoal contribution links ("+") crossing
  // the original Fig. 22/23 diagram could not be reliably read from the
  // extracted text (that density is the paper's own motivating example of
  // why plain iStar doesn't scale) and were intentionally omitted rather
  // than guessed; qualities are declared but left as un-contributed leaves.

  agent Platoon {
    task ExecuteRoleDistribution
    goal AllowChangeOrder
    goal AllowChangeLeader
    goal AllowFusion
    goal AllowSplitting
    goal AllowCreating
    goal AllowDissolving
    goal AllowLeaving
    goal AllowNewVehiclesToJoin
    goal AllowChangeLane
    goal AllowCommunication
    goal CommonDrivingSpeed
    goal ReducedOverallTime
    quality LessTrafficJam
    quality EcoFriendly
    quality HigherOverallFuelEfficiency
    quality NetworkSecurity
    task EncryptionOfInformation
  }

  // A CACC is never itself modelled as an actor in the paper (Sect. 5.2.1:
  // "the CACC itself is not directly represented by an actor") -- only the
  // two roles it can take are.
  role LeadVehicle {
    goal JoinPlatoonLead
    goal LeavePlatoonLead
    goal ReducedIndividualTimeLead
    goal DriveCommonSpeedLead
    goal CollisionAvoidanceLead
    goal LeadPlatoon
    quality HigherIndividualFuelEfficiencyLead
    task RegulateSpeedLead
      > CollisionAvoidanceLead   // inferred (see confidence note above)
    task PerformCommunicationLead
      > CollisionAvoidanceLead   // inferred
    task ChangeLaneLead
    task GuidePlatoon
    // Coordination task (Fig. 28): performed by the CACC in the Lead-vehicle
    // role; in the paper it ASSIGNS the Following-vehicle role to a CACC
    // joining the platoon -- that assignment semantics has no equivalent
    // relation in this dialect, so it is left as a bare task.
    task OrganizePlatoonStructure
    resource ReliableSensorsLead
      > needed-by RegulateSpeedLead
    resource VehicleInformationLead
  }

  role FollowingVehicle {
    goal JoinPlatoonFollowing
    goal LeavePlatoonFollowing
    goal ReducedIndividualTimeFollowing
    goal DriveCommonSpeedFollowing
    goal CollisionAvoidanceFollowing
    quality HigherIndividualFuelEfficiencyFollowing
    task RegulateSpeedFollowing
      > CollisionAvoidanceFollowing   // inferred
    task PerformCommunicationFollowing
      > CollisionAvoidanceFollowing   // inferred
    task ChangeLaneFollowing
    task OpenGap
    task CloseGap
    task FollowPreviousVehicle
    resource ReliableSensorsFollowing
      > needed-by RegulateSpeedFollowing
    resource VehicleInformationFollowing
  }

  // Sect. 5.2.1: "the goal allow new vehicles to join of the platoon depends
  // on the CACC task open gap."
  depend Platoon.AllowNewVehiclesToJoin -> task OpenGap -> FollowingVehicle

  // Sect. 5.2.1: "the goal reduced individual (driving) time of the CACC
  // depends on the goal reduced overall (driving) time of the platoon and
  // vice versa" -- bidirectional, so written both ways, for both roles a
  // CACC can take.
  depend LeadVehicle.ReducedIndividualTimeLead -> goal ReducedOverallTime -> Platoon
  depend Platoon.ReducedOverallTime -> goal ReducedIndividualTimeLead -> LeadVehicle
  depend FollowingVehicle.ReducedIndividualTimeFollowing -> goal ReducedOverallTime -> Platoon
  depend Platoon.ReducedOverallTime -> goal ReducedIndividualTimeFollowing -> FollowingVehicle

  // Sect. 5.2.1/5.3.4/Fig. 30: "a following vehicle must be able to execute
  // the task follow previous vehicle. Therefore, it depends on other CACCs
  // (either in the role following vehicle or lead vehicle)". Only the
  // cross-actor half survives in this dialect:
  depend FollowingVehicle -> task FollowPreviousVehicle -> LeadVehicle
  // The paper's other half -- "in cases where the vehicle ahead is also a
  // following vehicle, a self-dependency is used to show that a following
  // vehicle depends on another following vehicle" (Fig. 30) -- cannot be
  // written here at all: this dialect's validator rejects any dependency
  // whose depender and dependee are the same actor. There is no workaround
  // within plain i*; this is a genuine expressiveness gap, not a modelling
  // choice.
}
