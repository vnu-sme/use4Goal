-- Role 'extends' is a play chain (Owner[1]--Role[mult] association), not USE
-- generalization: no two Role classes are ever related by '<'. Every generated
-- class has a technical id : Integer used to preserve object identity in filmstrips.
-- Every play association is parent[1]--child[0..*].
-- Compatibility is 'inv NoConflict_<R1>_<R2>' on the nearest shared play-chain
-- ancestor; every Owner-target Role also gets 'inv NoSelfConflict_<R>'.

model ClassroomState

enum AttendanceMethod {none, manual, electronic}

class Agent
attributes
  id : Integer
end

class Person
attributes
  id : Integer
end

class Teacher
attributes
  id : Integer
  attendanceStarted : Boolean
end

class Student
attributes
  id : Integer
  present : Boolean
  attendanceMarked : Boolean
end

class Classroom
attributes
  id : Integer
  lessonStarted : Boolean
  attendanceRecorded : Boolean
  attendanceMethod : AttendanceMethod
  lessonDelivered : Boolean
end

association Agent_plays_Person between
  Agent[1] role agent
  Person[0..*] role play_person
end

association Person_plays_Teacher between
  Person[1] role person
  Teacher[0..*] role play_teacher
end

association Person_plays_Student between
  Person[1] role person
  Student[0..*] role play_student
end

composition Teacher_in_Classroom between
  Classroom[1] role classroom
  Teacher[1] role teacher
end

composition Student_in_Classroom between
  Classroom[1] role classroom
  Student[1..*] role student
end

constraints

context Person inv NoSelfConflict_Teacher:
  self.play_teacher->forAll(r1, r2 : Teacher |
    r1 <> r2 implies r1.classroom <> r2.classroom)

context Person inv NoSelfConflict_Student:
  self.play_student->forAll(r1, r2 : Student |
    r1 <> r2 implies r1.classroom <> r2.classroom)

context Person inv NoConflict_Teacher_Student:
self.play_teacher->forAll(r1 : Teacher |
self.play_student->forAll(r2 : Student |
      not (r1.classroom = r2.classroom)))

