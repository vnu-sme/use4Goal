-- Raw SOIL initial population for the generated ClassroomState USE model:
-- one Teacher and two Students, each played through the Agent -> Person ->
-- (Teacher | Student) chain, all owned by one Classroom group occurrence.
--
-- Written by hand rather than derived from a .aol snapshot: AclAol2SoilTranslator
-- (goal/src/main/java/.../translate/aclaol2soil) only generates a direct
-- "Agent_plays_<Role>" insert for a group-owned role and has no logic to walk
-- a role's own extends-chain (Person -> Teacher/Student here), so an .aol file
-- using `agent Person as ...; play Teacher as ... by ...;` currently fails to
-- translate for any role hierarchy deeper than one level -- a pre-existing gap
-- in that translator, unrelated to this example, left unfixed here.

!create classroom : Classroom

!create teacherAgent : Agent
!create teacherPerson : Person
!create teacher : Teacher
!insert (teacherAgent, teacherPerson) into Agent_plays_Person
!insert (teacherPerson, teacher) into Person_plays_Teacher
!insert (classroom, teacher) into Teacher_in_Classroom

!create student1Agent : Agent
!create student1Person : Person
!create student1 : Student
!insert (student1Agent, student1Person) into Agent_plays_Person
!insert (student1Person, student1) into Person_plays_Student
!insert (classroom, student1) into Student_in_Classroom

!create student2Agent : Agent
!create student2Person : Person
!create student2 : Student
!insert (student2Agent, student2Person) into Agent_plays_Person
!insert (student2Person, student2) into Person_plays_Student
!insert (classroom, student2) into Student_in_Classroom
