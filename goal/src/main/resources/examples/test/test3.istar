// iStar 2.0 — Harder example 3: a single deep nested chain
// G1 <-AND- G3 <-forall- G3F <-pick- G3FP <-AND- {K3,K4}
// (the other AND-branch, G2, is a plain OR — kept shallow for contrast)
// Combine: K3 carries two rel clauses at once (AND-refine + contribute)

istar Example3 {

  role C {
    quality Q1
    task    K5
    goal    G9
  }

  agent A {
    goal G1                       // root goal

    goal G2 > G1
    goal G3 > G1                  // AND: G1 needs both G2 and G3

    task K1 > or G2
    task K2 > or G2               // OR: G2 satisfied by K1 or K2

    goal G3F  > forall C G3       // forall: G3 needs G3F to hold for every actor of type C
    goal G3FP > pick C G3F        // pick: G3F needs G3FP to hold for (at least) one actor of type C

    task K3 > G3FP > make Q2      // combine: refines G3FP AND contributes to Q2 in one line
    task K4 > G3FP                // AND: G3FP needs both K3 and K4

    quality Q2
  }

  agent B {
    task K6
  }

  depend A.G3F  -> goal G9 -> C.G9
  depend A.G3FP -> task K5 -> C.K5
  depend A      -> task K6 -> B
}
