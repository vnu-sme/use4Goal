<?xml version="1.0" encoding="UTF-8" ?>
<?use version="7.1.1" ?>
<plugin name="GoalModel Plugin" version="3.0">
    <actions>
        <action label="Formal Verification Workspace"
                icon="images/conformance.png"
                class="org.vnu.sme.goal.feature.conformance.ActionOpenFormalVerification"
                tooltip="Validate ACL, iStar and BPMN; generate and inspect an Event-B project"
                menu="GoalModel Plugin"
                menuitem="Formal Verification Workspace"
                toolbaritem="Formal Verification"
                id="org.vnu.sme.goal.feature.conformance.ActionOpenFormalVerification">
        </action>
        <action label="iStar Model Viewer"
                icon="images/istar.png"
                class="org.vnu.sme.goal.feature.openistar.ActionOpenIStar"
                tooltip="iStar 2.0 Strategic Rationale Diagram Viewer"
                menu="GoalModel Plugin"
                menuitem="iStar Model Viewer"
                toolbaritem="iStar Viewer"
                id="org.vnu.sme.goal.feature.openistar.ActionOpenIStar">
        </action>
        <action label="iStar BPMN Trace Verifier"
                icon="images/istar.png"
                class="org.vnu.sme.goal.feature.istartrace.ActionOpenIStarTraceStepper"
                tooltip="Verify an existing .bpmntrace directly against ACL and iStar markings"
                menu="GoalModel Plugin"
                menuitem="iStar BPMN Trace Verifier"
                toolbaritem="iStar Trace Verifier"
                id="org.vnu.sme.goal.feature.istartrace.ActionOpenIStarTraceStepper">
        </action>
        <action label="ACL Model Viewer"
                icon="images/acl.png"
                class="org.vnu.sme.goal.feature.openacl.ActionOpenAcl"
                tooltip="Open an ACL v2.0 multi-agent state model"
                menu="GoalModel Plugin"
                menuitem="ACL Model Viewer"
                toolbaritem="ACL Viewer"
                id="org.vnu.sme.goal.feature.openacl.ActionOpenAcl">
        </action>
        <action label="AOL Object Model Viewer"
                icon="images/acl.png"
                class="org.vnu.sme.goal.feature.openaol.ActionOpenAol"
                tooltip="Validate and inspect an AOL object model against its ACL structural model"
                menu="GoalModel Plugin"
                menuitem="AOL Object Model Viewer"
                toolbaritem="AOL Viewer"
                id="org.vnu.sme.goal.feature.openaol.ActionOpenAol">
        </action>
        <action label="BPMN Model Viewer"
                icon="images/bpmn2.png"
                class="org.vnu.sme.goal.feature.openbpmn.ActionOpenBpmn"
                tooltip="BPMN 2.0 Collaboration Diagram Viewer"
                menu="GoalModel Plugin"
                menuitem="BPMN Model Viewer"
                toolbaritem="BPMN Viewer"
                id="org.vnu.sme.goal.feature.openbpmn.ActionOpenBpmn">
        </action>
        <action label="BPMN Scenario from AOL"
                icon="images/bpmn2-scenario.png"
                class="org.vnu.sme.goal.feature.bpmnscenario.ActionOpenBpmnScenario"
                tooltip="Run a BPMN 2.0 process seeded by a concrete AOL population and save the execution trace to a file"
                menu="GoalModel Plugin"
                menuitem="BPMN Scenario from AOL"
                toolbaritem="BPMN Scenario"
                id="org.vnu.sme.goal.feature.bpmnscenario.ActionOpenBpmnScenario">
        </action>
        <action label="BPMN Trace Viewer"
                icon="images/bpmn2-scenario.png"
                class="org.vnu.sme.goal.feature.bpmnscenario.ActionOpenBpmnAolTraceViewer"
                tooltip="Open a .bpmntrace file and step through it (diagram or table view)"
                menu="GoalModel Plugin"
                menuitem="BPMN Trace Viewer"
                toolbaritem="BPMN Trace Viewer"
                id="org.vnu.sme.goal.feature.bpmnscenario.ActionOpenBpmnAolTraceViewer">
        </action>
        <action label="iStar + ACL → USE/TOCL Generator"
                icon="images/istar.png"
                class="org.vnu.sme.goal.feature.istaruseocl.ActionOpenIStarUseOcl"
                tooltip="Translate an ACL structural model + iStar goal model into a unified USE class diagram and TOCL goal properties"
                menu="GoalModel Plugin"
                menuitem="iStar + ACL → USE/TOCL Generator"
                toolbaritem="iStar→USE/TOCL"
                id="org.vnu.sme.goal.feature.istaruseocl.ActionOpenIStarUseOcl">
        </action>
        <action label="iStar + ACL → USE/OCL (Folder)"
                icon="images/istar.png"
                class="org.vnu.sme.goal.feature.istaruseocl.ActionOpenIStarUseOclFolder"
                tooltip="Translate an ACL structural model + iStar goal model into USE/OCL, written into a chosen output folder"
                menu="GoalModel Plugin"
                menuitem="iStar + ACL → USE/OCL (Folder)"
                toolbaritem="iStar→USE/OCL (Folder)"
                id="org.vnu.sme.goal.feature.istaruseocl.ActionOpenIStarUseOclFolder">
        </action>
        <action label="BPMN + ACL → USE/OCL (Folder)"
                icon="images/bpmn2.png"
                class="org.vnu.sme.goal.feature.bpmnuseocl.ActionOpenBpmnUseOcl"
                tooltip="Translate an ACL structural model + BPMN process model into USE/OCL, written into a chosen output folder"
                menu="GoalModel Plugin"
                menuitem="BPMN + ACL → USE/OCL (Folder)"
                toolbaritem="BPMN→USE/OCL (Folder)"
                id="org.vnu.sme.goal.feature.bpmnuseocl.ActionOpenBpmnUseOcl">
        </action>

        <!-- The actions below exist in source and compile, but are not yet ready to
             show up in the tool menu: kept commented out on purpose. Uncomment an
             entry once its feature is ready to expose. -->
        <action label="Export ACL to USE"
                icon="images/acl.png"
                class="org.vnu.sme.goal.feature.exportacltouse.ActionExportAclToUse"
                tooltip="Validate an ACL structural model and export it as a USE class model"
                menu="GoalModel Plugin"
                menuitem="Export ACL to USE"
                toolbaritem="ACL→USE"
                id="org.vnu.sme.goal.feature.exportacltouse.ActionExportAclToUse">
        </action>
        <action label="acl2eventB"
                icon="images/conformance.png"
                class="org.vnu.sme.goal.feature.exportacltoeventb.ActionAcl2EventB"
                tooltip="Translate one ACL structural model into a UML-B-style Rodin Event-B project"
                menu="GoalModel Plugin"
                menuitem="acl2eventB"
                toolbaritem="acl2eventB"
                id="org.vnu.sme.goal.feature.exportacltoeventb.ActionAcl2EventB">
        </action>
        <action label="aclBpmn2eventB"
                icon="images/conformance.png"
                class="org.vnu.sme.goal.feature.exportaclbpmntoeventb.ActionAclBpmn2EventB"
                tooltip="Extend the UML-B-style ACL Event-B project with BPMN process state and events"
                menu="GoalModel Plugin"
                menuitem="aclBpmn2eventB"
                toolbaritem="aclBpmn2eventB"
                id="org.vnu.sme.goal.feature.exportaclbpmntoeventb.ActionAclBpmn2EventB">
        </action>
        <action label="aclIstar2eventB"
                icon="images/conformance.png"
                class="org.vnu.sme.goal.feature.exportaclistartoeventb.ActionAclIStar2EventB"
                tooltip="Extend the UML-B-style ACL Event-B project with iStar intentional and Quality state"
                menu="GoalModel Plugin"
                menuitem="aclIstar2eventB"
                toolbaritem="aclIstar2eventB"
                id="org.vnu.sme.goal.feature.exportaclistartoeventb.ActionAclIStar2EventB">
        </action>
