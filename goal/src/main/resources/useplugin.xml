        <action label="iStar Scenario Viewer"
                icon="images/istar-scenario.png"
                class="org.vnu.sme.goal.feature.openistarscenario.ActionOpenIStarScenario"
                tooltip="Open an .iscn instance-level scenario against its .istar goal model"
                menu="GoalModel Plugin"
