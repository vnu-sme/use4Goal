<?xml version="1.0" encoding="UTF-8" ?>
<?use version="7.1.1" ?>
<plugin name="Conformance of Processes and Goals" version="4.0">
    <actions>
        <action label="Process View Model"
                icon="images/bpmn2.png"
                class="org.vnu.sme.goal.feature.openbpmn.ActionOpenBpmn"
                tooltip="Open and inspect a BPMN process model"
                menu="Conformance of Processes and Goals"
                menuitem="1. Process View Model"
                toolbaritem="Process View"
                id="org.vnu.sme.goal.feature.openbpmn.ActionOpenBpmn">
        </action>

        <action label="Goal View Model"
                icon="images/istar.png"
                class="org.vnu.sme.goal.feature.openistar.ActionOpenIStar"
                tooltip="Open and inspect an iStar goal model"
                menu="Conformance of Processes and Goals"
                menuitem="2. Goal View Model"
                toolbaritem="Goal View"
                id="org.vnu.sme.goal.feature.openistar.ActionOpenIStar">
        </action>

        <action label="State View Model"
                icon="images/csl.png"
                class="org.vnu.sme.goal.feature.openacl.ActionOpenAcl"
                tooltip="Open and inspect a CSL state model"
                menu="Conformance of Processes and Goals"
                menuitem="3. State View Model"
                toolbaritem="State View"
                id="org.vnu.sme.goal.feature.openacl.ActionOpenAcl">
        </action>

        <action label="Conformance Checking"
                icon="images/conformance.png"
                class="org.vnu.sme.goal.feature.aclstate.ActionOpenAclStateEvaluator"
                tooltip="Check bounded conformance and risk across CSL, BPMN and iStar models"
                menu="Conformance of Processes and Goals"
                menuitem="4. Conformance Checking"
                toolbaritem="Conformance Checking"
                id="org.vnu.sme.goal.feature.aclstate.ActionOpenAclStateEvaluator">
        </action>

        <action label="Generate Process Scenarios"
                icon="images/bpmn2-scenario.png"
                class="org.vnu.sme.goal.feature.bpmnscenario.ActionOpenBpmnScenario"
                tooltip="Generate execution scenarios from a BPMN process and an initial CSL state"
                menu="Conformance of Processes and Goals"
                menuitem="5. Generate Process Scenarios"
                toolbaritem="Generate Scenarios"
                id="org.vnu.sme.goal.feature.bpmnscenario.ActionOpenBpmnScenario">
        </action>
    </actions>
</plugin>
