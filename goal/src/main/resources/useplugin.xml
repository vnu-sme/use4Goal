                icon="images/conformance.png"
                class="org.vnu.sme.goal.feature.exporteventb.ActionExportEventB"
                tooltip="Translate ACL + BPMN + iStar into one synchronized Rodin Event-B project"
                menu="GoalModel Plugin"
