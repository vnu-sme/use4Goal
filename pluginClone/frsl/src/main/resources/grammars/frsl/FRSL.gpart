/* $Id$ */

////////////////////////////////////////////////////////////////////////////////
// FRSL grammar
////////////////////////////////////////////////////////////////////////////////


/* Note
Idea note: ActorTable, UsecaseTable, ObjVarTable... seperated (and joined table if needed).
Operators should be through self-written functions (i.e. add to actortable should add to joined table as well).
*/

/*---------------FrslModelCS#FRSL.xtext---------------
FrslModelCS:
    domainModel = TopLevelCS
    (assocs += AssociationCS)*
    (actors += ActorCS)*
    (usecases += UsecaseCS)*
    (ucExtends += UcExtendCS)*
;

Note: 
    - `domainModel` and `assocs` are handled in the .use specification.
    - `actors`, `usecases`, and `ucExtends` are handled in the .uc specification (this grammar file).
--------------------------------------------------*/

frslModelCS returns [FrslModelCS f]
/*@init { Token t = null; }*/
:    
    'usecase' t = IDENT { $f = new FrslModelCS(t); }
    (   actorCS
        { 
            $f.addActorCS($actorCS.a); 
        }
    )*
    (   usecaseCS
        {
            $f.addUsecaseCS($usecaseCS.u);
        } 
    )*
    (
        ucExtendCS
        {
            $f.addUcExtendCS($ucExtendCS.e);
        }
    )*
    EOF
;

/*---------------ActorCS#FRSL.xtext---------------
ActorCS:
    'actor' name = UnrestrictedName
    ('description' '=' description = StringLiteral)?
    'end'
;

--------------------------------------------------*/
actorCS returns [ActorCS a]
:
    'actor' fName = IDENT { $a = new ActorCS($fName); }
    ( 'description' EQUAL description = STRING { $a.setDescription($description.text); } )?
    'end'
;

/*---------------UsecaseCS#FRSL.xtext---------------
UsecaseCS: 
    'usecase' name = UnrestrictedName
        ('description' '=' description = StringLiteral)?
        'primaryActor' '=' primaryActor = ActorRefCS
        ('secondaryActors' '=' '{' secondaryActors += ActorRefCS (',' secondaryActors += ActorRefCS)* '}')?
        (precondition = UsecasePreconditionCS)?
        (postcondition = UsecasePostconditionCS)?
        firstStep = StepCS
        (extPoints += ExtensionPointCS)*
    'end'        
;
--------------------------------------------------*/
usecaseCS returns [UsecaseCS u]
:
    'usecase' fName = IDENT { $u = new UsecaseCS($fName); }
    ( 'description' EQUAL description = STRING { $u.setDescription($description.text); } )?
    'primaryActor' EQUAL pa = actorRefCS { $u.setfPrimaryActorCS($pa.ref); }
    ('secondaryActors' EQUAL LBRACE sa = listActorRefCS { $u.setfSecondaryActorsCS($sa.refList); } RBRACE)?
    ( precondCS = usecasePreconditionCS { $u.setPreconditionCS($precondCS.cond); } )?
    ( postcondCS = usecasePostconditionCS { $u.setPostconditionCS($postcondCS.cond); } )?
    (firstStepCS = stepCS { $u.setFirstStepCS($firstStepCS.s); })?
    (
        extPointCS = extensionPointCS { $u.addExtPointCS($extPointCS.e); }
    )*
    'end'
;

/*---------------ActorRefCS#FRSL.xtext---------------
ActorRefCS returns base::ModelElementRefCS:
    ownedPathName = PathNameCS
;
--------------------------------------------------*/
actorRefCS returns [Token ref]
: 
    r = IDENT { $ref = $r; }
;

listActorRefCS returns [ArrayList<Token> refList]
@init{ $refList = new ArrayList<>(); }
:
    r0 = actorRefCS { $refList.add($r0.ref); }
    ( COMMA rN = actorRefCS { $refList.add($rN.ref); } )*
;


/*---------------UsecasePreconditionCS#FRSL.xtext---------------
UsecasePreconditionCS:
    'ucPrecondition'
        ('description' '=' description = StringLiteral)?
        snapshot = SnapshotPatternCS
    'end'
;
--------------------------------------------------*/
usecasePreconditionCS returns [UsecasePreconditionCS cond]
:
    ( 'ucPrecondition' 'description' EQUAL description = STRING { 
        $cond = new UsecasePreconditionCS(); 
        $cond.setDescription($description.text); 
    } )
    | ( 'ucPrecondition' { $cond = new UsecasePreconditionCS(); } )
    snapshotCS = snapshotPatternCS { $cond.setSnapshotCS($snapshotCS.ss); }
    'end'
;

/*---------------UsecasePostconditionCS#FRSL.xtext---------------
UsecasePostconditionCS:
    'ucPostcondition'
        ('description' '=' description = StringLiteral)?
        snapshot = SnapshotPatternCS
    'end'
;
--------------------------------------------------*/
usecasePostconditionCS returns [UsecasePostconditionCS cond]
:
    ( 'ucPostcondition' 'description' EQUAL description = STRING { 
        $cond = new UsecasePostconditionCS(); 
        $cond.setDescription($description.text); 
    } )
    | ( 'ucPostcondition' { $cond = new UsecasePostconditionCS(); } )
    snapshotCS = snapshotPatternCS { $cond.setSnapshotCS($snapshotCS.ss); }
    'end'
;

/*---------------SnapshotPatternCS#FRSL.xtext---------------
// IDK what {SnapshotPatternCS} means. 
// According to Gemini: The {...} construct ensures that these elements are encapsulated 
//                      as a SnapshotPatternCS object within the AST.

SnapshotPatternCS:
    {SnapshotPatternCS} ('snapshotID' '=' name = UnrestrictedName)?
    ('description' '=' description = StringLiteral)?
    ( ( objects += ObjVarCS | negObjects += NegObjVarCS ) ';')*
    (links += VarLinkCS ';')*
    (constraints += ConstraintCS)*
;

Note: NegObjVarCS need to be reviewed. Currently it is considered as a "remove object" rule.
--------------------------------------------------*/
snapshotPatternCS returns [SnapshotPatternCS ss]
:  
    { $ss = new SnapshotPatternCS(); }
    ('snapshotID' EQUAL fName = IDENT { $ss.setfName($fName); } )?
    ( 'description' EQUAL description = STRING { $ss.setDescription($description.text); } )?
    ( 
        ( 
            objectCS = objVarCS { $ss.addObjectCS($objectCS.o); }
            | negObjectCS = negObjVarCS { $ss.removeObjectCS($negObjectCS.ref); }
        ) 
        SEMI 
    )*
    (
        linkCS = varLinkCS { $ss.addLinkCS($linkCS.v); }
        SEMI
    )*
    (
        consCS = constraintCS { $ss.addConstraintCS($consCS.c); }
    )*
;

/*---------------ObjVarCS#FRSL.xtext---------------
ObjVarCS:
    (isMatched ?= '$')?name = UnrestrictedName ':' type = TypedRefCS
;
--------------------------------------------------*/
objVarCS returns [ObjVarCS o]
@init {
o = new ObjVarCS();
}
:
    fName = IDENT { 
        if ($fName.getText().charAt(0) == '$') {
            $o.setMatched(true);
            $fName.setText($fName.getText().substring(1));
            $o.setfName($fName);
        }
        else {
            $o.setfName($fName);
        }
    } 
    COLON fType = type { $o.setfType($fType.n); }
;

/*---------------NegObjVarCS#FRSL.xtext---------------
NegObjVarCS returns base::ModelElementRefCS:
    '!' ObjVarRefCS
;
      
TODO: Check if the rule need to be fixed again.
--------------------------------------------------*/
negObjVarCS returns [Token ref]
:
    '!' objVarRefCS
;

/*---------------ObjVarRefCS#FRSL.xtext---------------
ObjVarRefCS returns base::ModelElementRefCS:
    ownedPathName = PathNameCS
;
--------------------------------------------------*/
objVarRefCS returns [Token ref]
:
    r = IDENT { $ref = $r; }
;

/*---------------VarLink#FRSL.xtext---------------
VarLinkCS:
    (isNeg ?= '!')? '(' objVars += ObjVarRefCS ',' objVars += ObjVarRefCS ')' ':' assoc = AssocRefCS
;
--------------------------------------------------*/
varLinkCS returns [VarLinkCS v]
:
    { $v = new VarLinkCS(); }
    ('!'  { $v.setNeg(true); } )? 
    LPAREN 
        ( lhs = objVarRefCS { $v.setLhsfObjVarsCS($lhs.ref); } ) 
        COMMA 
        ( rhs = objVarRefCS { $v.setRhsfObjVarsCS($rhs.ref); } ) 
    RPAREN 
    COLON assoc = assocRefCS { $v.setfAssocCS($assoc.ref); }
;

/*---------------AssocRefCS#FRSL.xtext---------------
AssocRefCS returns base::ModelElementRefCS:
    ownedPathName = PathNameCS
;
--------------------------------------------------*/
assocRefCS returns [Token ref]
:
    r = IDENT { $ref = $r; }
;

/*---------------AssociationCS#FRSL.xtext---------------
AssociationCS:
    'association' name = UnrestrictedName 
        assocEnds += AssocEndCS
        assocEnds += AssocEndCS 
    'end'    
;

Note: This part is handled in the .use specification, hence using USE's rule.

    associationDefinition returns [ASTAssociation n]
    @init{ Token t = null; }
    :
        as = annotationSet
        { t = input.LT(1); }
        ( keyAssociation | keyAggregation | keyComposition )
        name = IDENT { 
            $n = new ASTAssociation(t, $name); 
            $n.setAnnotations($as.annotations); 
        }
        'between'
        ae = associationEnd { $n.addEnd($ae.n); }
        ( ae = associationEnd { $n.addEnd($ae.n); } )+
        'end'
    ;

--------------------------------------------------*/

/*---------------AssocEndCS#FRSL.xtext---------------
AssocEndCS returns base::ReferenceCS:
    name=UnrestrictedName ':' ownedType=TypedTupeMultiplicityRefCS  
;

Note: This part is handled in the .use specification, hence using USE's rule.

    associationEnd returns [ASTAssociationEnd n]
    :
    as = annotationSet
    name=IDENT LBRACK m=multiplicity RBRACK { $n = new ASTAssociationEnd($name, $m.n); $n.setAnnotations($as.annotations); } 
    ( keyRole rn=IDENT { $n.setRolename($rn); } )?
    (
        'ordered' { $n.setOrdered(); }
      | 'subsets' sr=IDENT { $n.addSubsetsRolename($sr); }
      | keyUnion { $n.setUnion(true); }
      | 'redefines' rd=IDENT { $n.addRedefinesRolename($rd); }
      | (keyDerived|keyDerive) ( LPAREN parameter = elemVarsDeclaration RPAREN)? EQUAL exp=expression { $n.setDerived($exp.n, $parameter.n); }
      | keyQualifier qualifiers = paramList {$n.setQualifiers($qualifiers.paramList); }
    )*
    ( SEMI )?
    ;
--------------------------------------------------*/

/*---------------TypedTupeMultiplicityRefCS#FRSL.xtext---------------
TypedTupeMultiplicityRefCS returns base::TypedRefCS:
    TypedTypeRefCS (ownedMultiplicity=MultiplicityCS)?
;

Note: This part is handled in the .use specification, hence using USE's rule.

    multiplicity returns [ASTMultiplicity n]
    :
    { 
        Token t = input.LT(1); // remember start position of expression
        $n = new ASTMultiplicity(t);
    }
        mr=multiplicityRange { $n.addRange($mr.n); }
        ( COMMA mr=multiplicityRange  { $n.addRange($mr.n); } )*
    ;

    multiplicityRange returns [ASTMultiplicityRange n]
    :
        ms1=multiplicitySpec { $n = new ASTMultiplicityRange($ms1.m); }
        ( DOTDOT ms2=multiplicitySpec { $n.setHigh($ms2.m); } )?
    ;

    multiplicitySpec returns [int m]
    @init{ $m = -1; }
    :
        i=INT { $m = Integer.parseInt($i.text); }
        | STAR  { $m = -1; }
    ;
--------------------------------------------------*/

/*---------------ConstraintCS#FRSL.xtext---------------
ConstraintCS:
    '[' constrExpr = SpecificationCS ']'
;

Note: specificationCS is refered from RTL.
--------------------------------------------------*/
constraintCS returns [ConstraintCS c]
:
    constrExpr = specificationCS { $c = new ConstraintCS($constrExpr.text); }
;

specificationCS
:
    COND_EXPR | EQUAL_COND_EXPR
;

EQUAL_COND_EXPR
:
    LBRACK
        ( ~(RBRACK|EQUAL|SEMI) )* EQUAL ( ~(RBRACK|EQUAL) )*  
    RBRACK
    { setText(getText().substring(1, getText().length()-1)); }
;

COND_EXPR
:
    LBRACK
        ( ~(RBRACK|SEMI) )*
    RBRACK
    { setText(getText().substring(1, getText().length()-1)); }
;

/*---------------StepCS#FRSL.xtext---------------
StepCS:
    (ActStepCS | RejoinStepCS | UCStepCS)
    (altFlows += AltFlowCS)*
    (nextStep = StepCS)?
;
--------------------------------------------------*/
stepCS returns [StepCS s]
:
    (
        ( actStepCS { $s = $actStepCS.a; } )
        | ( rejoinStepCS { $s = $rejoinStepCS.r; } )
        | ( ucStepCS { $s = $ucStepCS.u; } )
    )
    (alt = altFlowCS {$s.addListAltFlowCS($alt.a);})*
    ( nextStepCS = stepCS { 
        $s.setNextStepCS($nextStepCS.s); 
        $s.moveAltFlow($nextStepCS.s);
    } )?
;

/*---------------ActStepCS#FRSL.xtext---------------
ActStepCS:
    ActorStepCS | SystemStepCS
;
--------------------------------------------------*/
actStepCS returns [ActStepCS a]
:
    actorStepCS { $a = $actorStepCS.a; }
    | systemStepCS { $a = $systemStepCS.s; }
;

/*---------------ActorStepCS#FRSL.xtext---------------
ActorStepCS returns ActStepCS:
    (isActorStep ?= 'actStep') (name = UnrestrictedName)? 
    ('description' '=' description = StringLiteral)?
    'from'
        preSnapshot = SnapshotPatternCS    
    'to'
        postSnapshot = SnapshotPatternCS
    ( 'actions' (actions += ActorActionCS)* )?
    'end'
;
--------------------------------------------------*/
actorStepCS returns [ActorStepCS a]
:
    'actStep' { $a = new ActorStepCS(); }
    ( fName = IDENT { $a.setfName($fName); } )?
    ( 'description' EQUAL description = STRING { $a.setDescription($description.text); } )?

    'from' preSnapshotCS = snapshotPatternCS { $a.setPreSnapshotCS($preSnapshotCS.ss); }
    'to' postSnapshotCS = snapshotPatternCS { $a.setPostSnapshotCS($postSnapshotCS.ss); }
    ( 'actions' ( actionCS = actorActionCS { $a.addActionCS($actionCS.a); } )* )?
    'end'
;

/*---------------SystemStepCS#FRSL.xtext---------------
SystemStepCS returns ActStepCS:
    'sysStep' (name = UnrestrictedName)? 
    ('description' '=' description = StringLiteral)?
    'from'
        preSnapshot = SnapshotPatternCS    
    'to'
        postSnapshot = SnapshotPatternCS
    ( 'actions' (actions += SystemActionCS)* )?
    'end'
;
--------------------------------------------------*/
systemStepCS returns [SystemStepCS s]
:
    'sysStep' { $s = new SystemStepCS(); }
    ( fName = IDENT { $s.setfName($fName); } )?
    ( 'description' EQUAL description = STRING { $s.setDescription($description.text); } )?

    'from' preSnapshotCS = snapshotPatternCS { $s.setPreSnapshotCS($preSnapshotCS.ss); }
    'to' postSnapshotCS = snapshotPatternCS { $s.setPostSnapshotCS($postSnapshotCS.ss); }
    ( 'actions' ( actionCS = systemActionCS { $s.addActionCS($actionCS.a); } )* )?
    'end'
;

/*---------------ActorActionCS#FRSL.xtext---------------
ActorActionCS:
    InputActionCS
;
--------------------------------------------------*/
actorActionCS returns [ActorActionCS a]
:
    inputActionCS { $a = $inputActionCS.a; }
;

/*---------------InputActionCS#FRSL.xtext---------------
InputActionCS returns ActorActionCS:
    (actor = ActorRefCS)? '->' (objVars += ObjVarCS ';')+
;

Note: Why `actor` is optional? It's quite confusing.
--------------------------------------------------*/
inputActionCS returns [ActorActionCS a]
:
    { $a = new ActorActionCS(); }
    ( actor = actorRefCS { $a.setfActorCS($actor.ref); } )?
    '->'
    ( 
        objVCS = objVarCS { $a.addObjVarCS($objVCS.o); } 
        SEMI 
    )+
;

/*---------------SystemActionCS#FRSL.xtext---------------
SystemActionCS:
    OutputActionCS
;
--------------------------------------------------*/
systemActionCS returns [SystemActionCS a]
:
    outputActionCS { $a = $outputActionCS.a; }
;

/*---------------OutputActionCS#FRSL.xtext---------------
OutputActionCS returns SystemActionCS:
    actor = ActorRefCS '<-' ( objVars += ObjVarCS '=' values += SpecificationCS ';' )+
;

Note: values += SpecificationCS refers to an OCLInEcore rule, 
      and should be replaced with "normal" OCL constraints.
--------------------------------------------------*/
outputActionCS returns [SystemActionCS a]
:
    { $a = new SystemActionCS(); }
    actor = actorRefCS { $a.setfActorCS($actor.ref); } 
    '<-' 
    ( 
        objVCS = objVarCS { $a.addObjVarCS($objVCS.o); } 
        EQUAL 
        fValuesCS = specificationCS { $a.addfValueCS($fValuesCS.text); } 
        SEMI 
    )+
;

/*---------------AltFlowCS#FRSL.xtext---------------
AltFlowCS:
	'altStep' (name = UnrestrictedName)? 'at' baseStep = StepRefCS
		('description' '=' description = StringLiteral)?
		'when'
			condition = SnapshotPatternCS
		'end'
		altStep = StepCS
	'end'
;
--------------------------------------------------*/
altFlowCS returns [AltFlowCS a]
:
    { $a = new AltFlowCS(); }
    'altStep' ( fName = IDENT { $a.setfName($fName); } )?
    'at' baseStep = stepRefCS { $a.setfBaseStepCS($baseStep.ref); }
        ( 'description' EQUAL description = 
        STRING { $a.setDescription($description.text); } )?
        'when' 
            conditionCS = snapshotPatternCS { $a.setConditionCS($conditionCS.ss); }
        'end'
        altStepCS = stepCS { $a.setAltStepCS($altStepCS.s); }
    'end'
;

/*---------------StepRefCS#FRSL.xtext---------------
StepRefCS returns base::ModelElementRefCS:
    ownedPathName=PathNameCS
;
--------------------------------------------------*/
stepRefCS returns [Token ref]
:
    r = IDENT { $ref = $r; }
;

/*---------------RejoinStepCS#FRSL.xtext---------------
RejoinStepCS:
    'rejoinStep' rejoinTo = StepRefCS 
    ('description' '=' description = StringLiteral)?
    ('when'
        condition = SnapshotPatternCS)?
    'end'
;
--------------------------------------------------*/
rejoinStepCS returns [RejoinStepCS r]
:
    'rejoinStep' rejion = IDENT
    '>' rejoinTo = stepRefCS { 
        $r = new RejoinStepCS($rejoinTo.ref); 
        $r.setfName($rejion);
    }
    ( 'description' EQUAL description = STRING { $r.setDescription($description.text); } )?
    ( 'when' conditionCS = snapshotPatternCS { $r.setConditionCS($conditionCS.ss); } )?
    'end'
;

/*---------------UCStepCS#FRSL.xtext---------------
UCStepCS:
    'inclStep' (name = UnrestrictedName)?
    ('description' '=' description = StringLiteral)?
    includedUC = UsecaseRefCS
    'end'
;
--------------------------------------------------*/
ucStepCS returns [UCStepCS u]
:
    { $u = new UCStepCS(); }
    'inclStep' ( fName = IDENT { $u.setfName($fName); } )?
    ( 'description' EQUAL description = STRING { $u.setDescription($description.text); } )?
    includedUC = usecaseRefCS { $u.setfIncludedUC($includedUC.ref); }
    'end'
;

/*---------------UsecaseRefCS#FRSL.xtext---------------
UsecaseRefCS returns base::ModelElementRefCS:
    ownedPathName=PathNameCS
;
--------------------------------------------------*/
usecaseRefCS returns [Token ref]
:
    r = IDENT { $ref = $r; }
;

/*---------------ExtensionPointCS#FRSL.xtext---------------
ExtensionPointCS:
    {ExtensionPointCS} 'extensionPoint' (name = UnrestrictedName)? 
            ('at' '{' locations += StepRefCS ('|' locations += StepRefCS)* '}')? 
    ('description' '=' description = StringLiteral)?
    'when'
            (condition = SnapshotPatternCS)?
    'end'
;
--------------------------------------------------*/
extensionPointCS returns [ExtensionPointCS e]
:
    { $e = new ExtensionPointCS(); }
    'extensionPoint' ( fName = IDENT { $e.setfName($fName); } )?
    ( 'at' 
        LBRACE
            locationCS0 = stepRefCS { $e.addfLocationCS($locationCS0.ref); }
            ( '|' locationCSn = stepRefCS { $e.addfLocationCS($locationCSn.ref); } )*
        RBRACE
    )?
    ( 'description' EQUAL description = STRING { $e.setDescription($description.text); } )?
    
    ( 'when' conditionCS = snapshotPatternCS { $e.setConditionCS($conditionCS.ss); } 'end') 
    | ('when' 'end')
;

/*---------------UcExtendCS#FRSL.xtext---------------
UcExtendCS returns ExtendCS:     
    extension = UsecaseRefCS 'extends' extendedUC = UsecaseRefCS 
        'at' '{' extPoints += ExtensionPointRefCS ('|' extPoints += ExtensionPointRefCS)* '}'
;
--------------------------------------------------*/
ucExtendCS returns [ExtendCS e]
:
    extension = usecaseRefCS { $e = new ExtendCS($extension.ref); }
    'extends' extendedUC = usecaseRefCS { $e.setfExtendedUCCS($extendedUC.ref); }
    'at' 
    LBRACE 
        extPoint0 = extensionPointRefCS { $e.addfExtPointCS($extPoint0.ref); } 
        ( '|' extPointn = extensionPointRefCS { $e.addfExtPointCS($extPointn.ref); } )* 
    RBRACE
;

/*---------------ExtensionPointRefCS#FRSL.xtext---------------
ExtensionPointRefCS returns base::ModelElementRefCS:
    ownedPathName = PathNameCS
;
--------------------------------------------------*/
extensionPointRefCS returns [Token ref]
:
    r = IDENT { $ref = $r; }
;
  
/* -----------------------------------------------------------------------------
-------------------------- end of file FRSLBase.gpart --------------------------
----------------------------------------------------------------------------- */