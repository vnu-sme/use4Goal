model SoftwareSystem

enum State { None, Loaded, Installed, Running }

-- Classes
class System
attributes
    id : Integer
    freeMemory : Integer
operations
    load(app : Application)
    install(app : Application)
    run(app : Application)
end

class Application
attributes
    id : Integer
    size : Integer
    state : State
end

-- Associations
association SystemApplication between
    System[1] role system
    Application[0..*] role apps
end

-- Invariants
constraints
context System
    inv memoryConstraint: self.freeMemory >= 0

context Application
    inv sizeConstraint: self.size > 0

context System::load(app: Application)
    pre appExists: not self.apps->includes(app)
    pre notLoaded: app.state = #None
    post appLoaded: app.state = #Loaded
    post addAssociation: self.apps = self.apps@pre->including(app)
    post unchanged: self.apps->forAll(app | app.size = app.size@pre)

context System::install(app : Application)
    pre appExists: self.apps->includes(app)
    pre isLoaded: app.state = #Loaded
    pre enoughMemory: self.freeMemory >= app.size
    post reducedMem: self.freeMemory = self.freeMemory@pre - app.size
    post appInstalled: app.state = #Installed
    post unchanged: self.apps->forAll(app | app.size = app.size@pre)

context System::run(app : Application)
    pre isInstalled: app.state = #Installed
    post unchanged: self.apps->forAll(app | app.size = app.size@pre)