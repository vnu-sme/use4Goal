model ElevatorSystem

enum DoorState {
  Open, Closed
 };

class addTargetFloor_ElevatorOpC < ElevatorOpC
attributes
  newTargetFloor : Integer
end

composition SnapshotElevator between
  Snapshot[1] role snapshotElevator
  Elevator[*]
end

class move_ElevatorOpC < ElevatorOpC
end

association Filmstrip between
  Snapshot[0..1] role pred
  Snapshot[0..1] role succ
  OperationCall[0..1]
end

class closeDoor_ElevatorOpC < ElevatorOpC
end

aggregation PredSuccFloorButton between
  FloorButton[0..1] role predFloorButton
  FloorButton[0..1] role succFloorButton
end

composition SnapshotFloorButton between
  Snapshot[1] role snapshotFloorButton
  FloorButton[*]
end

class press_FloorButtonOpC < FloorButtonOpC
end

class Snapshot
operations
  pred() : Snapshot = 
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot = 
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

class openDoor_ElevatorOpC < ElevatorOpC
end

abstract class FloorButtonOpC < OperationCall
attributes
  aSelf : FloorButton
end

abstract class OperationCall
operations
  pred() : Snapshot = 
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot = 
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

aggregation PredSuccElevator between
  Elevator[0..1] role predElevator
  Elevator[0..1] role succElevator
end

abstract class ElevatorOpC < OperationCall
attributes
  aSelf : Elevator
end

class Elevator
attributes
  id : Integer
  currentFloor : Integer
  targetFloor : Integer
  doorState : DoorState
  waitingQueue : Sequence(Integer)
  queue : Sequence(Integer)
operations
  move()
  openDoor()
  closeDoor()
  addTargetFloor(newTargetFloor : Integer)
end

class FloorButton
attributes
  id : Integer
  floor : Integer
operations
  press()
end

association ElevatorButton between
  Elevator[1]
  FloorButton[*] role buttons
end

constraints
context Elevator inv validLinkingElevatorButton:
  self.buttons->forAll( c:FloorButton | (c.snapshotFloorButton = self.snapshotElevator) )

context Elevator inv validSnapshotLinking:
  (self.succElevator.isDefined() implies (self.succElevator.snapshotElevator = self.snapshotElevator.succ()))

context ElevatorOpC inv aSelfDefined:
  self.aSelf.isDefined()

context ElevatorOpC inv aSelfInPred:
  (self.aSelf.snapshotElevator = self.pred())

context FloorButton inv validSnapshotLinking:
  (self.succFloorButton.isDefined() implies (self.succFloorButton.snapshotFloorButton = self.snapshotFloorButton.succ()))

context FloorButtonOpC inv aSelfDefined:
  self.aSelf.isDefined()

context FloorButtonOpC inv aSelfInPred:
  (self.aSelf.snapshotFloorButton = self.pred())

context OperationCall inv assocClassBehavior:
  (((self.pred->size() = 1) and (self.succ->size() = 1)) and OperationCall.allInstances()->forAll( op:OperationCall | (((self.pred = op.pred) and (self.succ = op.succ)) implies (self = op)) ))

context Snapshot inv cycleFree:
  Set{self.succ()}->closure( s:Snapshot | s.succ() )->excludes(self)

context Snapshot inv oneFilmstrip:
  ((Snapshot.allInstances()->select( s:Snapshot | s.pred().isUndefined() )->size() = 1) and (Snapshot.allInstances()->select( s:Snapshot | s.succ().isUndefined() )->size() = 1))

context addTargetFloor_ElevatorOpC inv post_targetFloorAdded:
  if aSelf.succElevator.predElevator.waitingQueue->includes(newTargetFloor) then ((aSelf.succElevator.waitingQueue = aSelf.succElevator.predElevator.waitingQueue) and aSelf.succElevator.queue->exists( p:Integer | (p.floor() = newTargetFloor) )) else (aSelf.succElevator.waitingQueue = aSelf.succElevator.predElevator.waitingQueue->including(newTargetFloor)) endif

context addTargetFloor_ElevatorOpC inv pre_newTargetFloorValid:
  (newTargetFloor > 0)

context closeDoor_ElevatorOpC inv post_doorClosed:
  (aSelf.succElevator.doorState = DoorState::Closed)

context closeDoor_ElevatorOpC inv pre_doorOpened:
  (aSelf.doorState = DoorState::Open)

context move_ElevatorOpC inv pre_doorClosed:
  (aSelf.doorState = DoorState::Closed)

context move_ElevatorOpC inv pre_hasRequests:
  aSelf.waitingQueue->notEmpty()

context move_ElevatorOpC inv pre_hasTargetFloor:
  (aSelf.targetFloor = aSelf.queue->any( $elem0:Integer | true ))

context openDoor_ElevatorOpC inv post_doorOpened:
  (aSelf.succElevator.doorState = DoorState::Open)

context openDoor_ElevatorOpC inv pre_atRequestedFloor:
  (aSelf.currentFloor = aSelf.targetFloor)

context openDoor_ElevatorOpC inv pre_doorClosed:
  (aSelf.doorState = DoorState::Closed)

context press_FloorButtonOpC inv post_floorAdded:
  if aSelf.succFloorButton.elevator.predElevator.waitingQueue->excludes(aSelf.succFloorButton.floor) then (aSelf.succFloorButton.elevator.waitingQueue = aSelf.succFloorButton.elevator.predElevator.waitingQueue->including(aSelf.succFloorButton.floor)) else (aSelf.succFloorButton.elevator.waitingQueue = aSelf.succFloorButton.elevator.predElevator.waitingQueue) endif

context self : Elevator inv targetFloorValid:
  (self.targetFloor > 0)

context self : Elevator inv currentFloorValid:
  (self.currentFloor > 0)

context self : FloorButton inv floorValid:
  (self.floor > 0)

