model ElevatorSystem

enum DoorState {
  Open, Closed
 };

class addTargetFloor_ElevatorOpC < ElevatorOpC
attributes
  newTargetFloor : Integer
end

composition SnapshotElevator between
  Snapshot[1] role snapshotElevator
  Elevator[*]
end

class move_ElevatorOpC < ElevatorOpC
end

association Filmstrip between
  Snapshot[0..1] role pred
  Snapshot[0..1] role succ
  OperationCall[0..1]
end

class closeDoor_ElevatorOpC < ElevatorOpC
end

aggregation PredSuccFloorButton between
  FloorButton[0..1] role predFloorButton
  FloorButton[0..1] role succFloorButton
end

composition SnapshotFloorButton between
  Snapshot[1] role snapshotFloorButton
  FloorButton[*]
end

class press_FloorButtonOpC < FloorButtonOpC
end

class Snapshot
operations
  pred() : Snapshot =
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot =
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

class openDoor_ElevatorOpC < ElevatorOpC
end

abstract class FloorButtonOpC < OperationCall
attributes
  aSelf : FloorButton
end

abstract class OperationCall
operations
  pred() : Snapshot =
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot =
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

aggregation PredSuccElevator between
  Elevator[0..1] role predElevator
  Elevator[0..1] role succElevator
end

abstract class ElevatorOpC < OperationCall
attributes
  aSelf : Elevator
end

class Elevator
attributes
  id : Integer
  currentFloor : Integer
  targetFloor : Integer
  doorState : DoorState
  waitingQueue : Sequence(Integer)
operations
  move()
  openDoor()
  closeDoor()
  addTargetFloor(newTargetFloor : Integer)
end

class FloorButton
attributes
  id : Integer
  floor : Integer
operations
  press()
end

association ElevatorButton between
  Elevator[1]
  FloorButton[*] role buttons
end

constraints
context Elevator inv validLinkingElevatorButton:
  self.buttons->forAll( c:FloorButton | (c.snapshotFloorButton = self.snapshotElevator) )

context Elevator inv validSnapshotLinking:
  (self.succElevator.isDefined() implies (self.succElevator.snapshotElevator = self.snapshotElevator.succ()))

context ElevatorOpC inv aSelfDefined:
  self.aSelf.isDefined()

context ElevatorOpC inv aSelfInPred:
  (self.aSelf.snapshotElevator = self.pred())

context FloorButton inv validSnapshotLinking:
  (self.succFloorButton.isDefined() implies (self.succFloorButton.snapshotFloorButton = self.snapshotFloorButton.succ()))

context FloorButtonOpC inv aSelfDefined:
  self.aSelf.isDefined()

context FloorButtonOpC inv aSelfInPred:
  (self.aSelf.snapshotFloorButton = self.pred())

context OperationCall inv assocClassBehavior:
  (((self.pred->size() = 1) and (self.succ->size() = 1)) and OperationCall.allInstances()->forAll( op:OperationCall | (((self.pred = op.pred) and (self.succ = op.succ)) implies (self = op)) ))

context Snapshot inv cycleFree:
  Set{self.succ()}->closure( s:Snapshot | s.succ() )->excludes(self)

context Snapshot inv oneFilmstrip:
  ((Snapshot.allInstances()->select( s:Snapshot | s.pred().isUndefined() )->size() = 1) and (Snapshot.allInstances()->select( s:Snapshot | s.succ().isUndefined() )->size() = 1))

context addTargetFloor_ElevatorOpC inv post_targetFloorAdded:
  (aSelf.succElevator.waitingQueue = aSelf.succElevator.predElevator.waitingQueue->including(newTargetFloor))

context addTargetFloor_ElevatorOpC inv pre_newTargetFloorValid:
  (newTargetFloor > 0)

context closeDoor_ElevatorOpC inv post_doorClosed:
  (aSelf.succElevator.doorState = DoorState::Closed)

context closeDoor_ElevatorOpC inv pre_doorOpened:
  (aSelf.doorState = DoorState::Open)

context move_ElevatorOpC inv post_queueUpdated:
  (aSelf.succElevator.waitingQueue = aSelf.succElevator.predElevator.waitingQueue->excluding(aSelf.succElevator.predElevator.waitingQueue->first()))

context move_ElevatorOpC inv post_targetReached:
  ((aSelf.succElevator.currentFloor = aSelf.succElevator.targetFloor) and (aSelf.succElevator.targetFloor = aSelf.succElevator.predElevator.waitingQueue->first()))

context move_ElevatorOpC inv pre_doorClosed:
  (aSelf.doorState = DoorState::Closed)

context move_ElevatorOpC inv pre_hasRequests:
  aSelf.waitingQueue->notEmpty()

context move_ElevatorOpC inv pre_hasTargetFloor:
  (aSelf.targetFloor = aSelf.waitingQueue->first())

context openDoor_ElevatorOpC inv post_doorOpened:
  (aSelf.succElevator.doorState = DoorState::Open)

context openDoor_ElevatorOpC inv pre_atRequestedFloor:
  (aSelf.currentFloor = aSelf.targetFloor)

context openDoor_ElevatorOpC inv pre_doorClosed:
  (aSelf.doorState = DoorState::Closed)

context press_FloorButtonOpC inv post_floorAdded:
  if aSelf.succFloorButton.elevator.predElevator.waitingQueue->excludes(aSelf.succFloorButton.floor) then (aSelf.succFloorButton.elevator.waitingQueue = aSelf.succFloorButton.elevator.predElevator.waitingQueue->including(aSelf.succFloorButton.floor)) else (aSelf.succFloorButton.elevator.waitingQueue = aSelf.succFloorButton.elevator.predElevator.waitingQueue) endif

context self : Elevator inv targetFloorValid:
  (self.targetFloor > 0)

context self : Elevator inv currentFloorValid:
  (self.currentFloor > 0)

context self : Elevator inv exactlyTwoFloorButtons:
  (self.buttons->size() = 3)

context self : Elevator inv uniqueFloorNumbers:
  (self.buttons->collect( $elem0:FloorButton | $elem0.floor )->asSet() = Set{1, 2, 3})

context self : FloorButton inv floorValid:
  (self.floor > 0)


context Elevator
inv ElevatorSameId: self.succElevator.isDefined() implies self.id = self.succElevator.id
context FloorButton
inv FloorButtonSameId: self.succFloorButton.isDefined() implies self.id = self.succFloorButton.id

context Elevator
inv ElevatorDiffId: self.snapshotElevator.elevator->forAll(o | o <> self implies o.id <> self.id)
context FloorButton
inv FloorButtonDiffId: self.snapshotFloorButton.floorButton->forAll(o | o <> self implies o.id <> self.id)

---------Additional constraints added manually
context FloorButton
inv sameFloor: self.succFloorButton.isDefined() implies self.floor = self.succFloorButton.floor
inv diffFloor: self.snapshotFloorButton.floorButton->forAll(c:FloorButton | c <> self implies c.floor <> self.floor)


---------- Temporal Constraints ----------
---------- Next operator
---(ok)
---if the elevator is requested, then the move() method is called in the next snapshot
--context Elevator
--inv requestedMove: self.isRequested = true implies OperationCall.allInstances()->exists(op | op.pred() = self.snapshotElevator.succ() and op.oclIsTypeOf(move_ElevatorOpC))

---(ok)
---if move() is called, then openDoor() is called in the next snapshot
--context Elevator
--inv moveNextOpen: OperationCall.allInstances()->exists(op | op.pred() = self.snapshotElevator and op.oclIsTypeOf(move_ElevatorOpC)) implies OperationCall.allInstances()->exists(op | op.pred() = self.snapshotElevator.succ() and op.oclIsTypeOf(openDoor_ElevatorOpC))

---(ok)
---if openDoor() is called, then closeDoor() is called in the next snapshot
--context Elevator
--inv openNextClose: OperationCall.allInstances()->exists(op | op.pred() = self.snapshotElevator and op.oclIsTypeOf(openDoor_ElevatorOpC)) implies OperationCall.allInstances()->exists(op | op.pred() = self.snapshotElevator.succ() and op.oclIsTypeOf(closeDoor_ElevatorOpC))

---(ok)
---if move() is called, then closeDoor() is called in the next next snapshot
--context Elevator
--inv moveNextNextClose: OperationCall.allInstances()->exists(op | op.pred() = self.snapshotElevator and op.oclIsTypeOf(move_ElevatorOpC)) implies OperationCall.allInstances()->exists(op | op.pred() = self.snapshotElevator.succ().elevator->any(o | self.id = o.id).snapshotElevator.succ() and op.oclIsTypeOf(closeDoor_ElevatorOpC))


-------- Previous operator
---(ok)
---if doorState is #Open, then openDoor() is called in the previous snapshot
--context Elevator
--inv openPreviousMove: self.doorState = #Open implies OperationCall.allInstances()->exists(op | op.pred() = self.snapshotElevator.pred() and op.oclIsTypeOf(openDoor_ElevatorOpC))


-------- Sometime operator
---(ok)
---if the tocl 'sometime' is called alone, then the scope is 'global'
---here is the translation of 'sometime isCalled(closeDoor())' operator with global scope
--context Elevator
--inv sometimeClose: Snapshot.allInstances()->exists(s | OperationCall.allInstances()->exists(op | op.pred() = s and op.oclIsTypeOf(closeDoor_ElevatorOpC)))

---(ok)
---if move() is called, then openDoor() is called in one of the future snapshots
---here the tocl is derive from a 'implies' expression -> the scope is from the current snapshot onward
--context Elevator
--inv sometimeOpenIsCalled: OperationCall.allInstances()->exists(op | op.succ() = self.snapshotElevator and op.oclIsTypeOf(move_ElevatorOpC)) implies (let CS:Snapshot = self.snapshotElevator in Set{CS}->closure(s | s.succ())->excluding(null)->exists(s | OperationCall.allInstances()->exists(op | op.succ() = s and op.oclIsTypeOf(openDoor_ElevatorOpC))))


-------- Sometime before operator
---(ok)
---between ... and ... pattern
---if move() is called, then openDoor() is called between move() and closeDoor()
--context Elevator
--inv moveImpliesSometimeOpenBeforeClose: OperationCall.allInstances()->exists(op | op.succ() = self.snapshotElevator and op.oclIsTypeOf(move_ElevatorOpC)) implies ((let FS:Set(Snapshot) = Set{self.snapshotElevator}->closure(s | s.succ())->excluding(null) in let PreS:Set(Snapshot) = Set{self.snapshotElevator}->closure(s | s.pred())->excluding(null) in let FSQ:Snapshot = FS->select(s | OperationCall.allInstances()->exists(op | op.succ() = s and op.oclIsTypeOf(closeDoor_ElevatorOpC)))->any(true) in let FSP:Set(Snapshot) = FS->select(s | OperationCall.allInstances()->exists(op | op.succ() = s and op.oclIsTypeOf(openDoor_ElevatorOpC))) in if FSQ.isDefined() then (if (FSP->size() > 0) then ((Set{FSQ.pred()}->closure(s | s.pred())-PreS)->exists(s_1 | FSP->includes(s_1))) else false endif) else false endif))


-------- Always operator
---(ok)
---After ... Until ... pattern?
---if openDoor() is called, then the doorState is always #Close until openDoor() is called again
--context Elevator
--inv openImpliesAlwaysCloseUntilOpen: OperationCall.allInstances()->exists(op | op.succ() = self.snapshotElevator and op.oclIsTypeOf(openDoor_ElevatorOpC)) implies (let CS:Snapshot = self.snapshotElevator in let FS:Set(Snapshot) = Set{CS.succ()}->closure(s | s.succ())->excluding(null) in let FSQ:Snapshot = FS->select(s | OperationCall.allInstances()->exists(op | op.succ() = s and op.oclIsTypeOf(openDoor_ElevatorOpC)))->any(true) in let afterQ:Set(Snapshot) = Set{FSQ}->closure(s | s.succ()) in let FSP:Set(Snapshot) = FS->select(s | s.elevator->any(true).doorState = #Closed) in if FSQ.isDefined() then (if (FSP->size() > 0) then (FS-afterQ = FSP-afterQ) else false endif) else (FS = FSP) endif)

