--context Elevator
--inv moveNextNextClose: OperationCall.allInstances()->select(op | op.pred->any(true) = self.snapshotElevator)->exists(op | op.oclIsTypeOf(move_ElevatorOpC)) implies OperationCall.allInstances()->select(op | op.pred->any(true) = self.snapshotElevator.succ().elevator->any(o | self.id = o.id).snapshotElevator.succ())->exists(op | op.oclIsTypeOf(closeDoor_ElevatorOpC))
