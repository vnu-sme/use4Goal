<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
    <uml:Model xmi:type="uml:Model" xmi:id="BankAccount" name="BankAccount">
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="BankAccount_Integer" name="Integer"/>
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="BankAccount_UnlimitedNatural" name="UnlimitedNatural"/>
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="BankAccount_Real" name="Real"/>
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="BankAccount_Boolean" name="Boolean"/>
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="BankAccount_String" name="String"/>
    <packagedElement xmi:type="uml:Class" xmi:id="BankAccount_BankAccount" name="BankAccount">
      <ownedAttribute xmi:id="BankAccount_BankAccount_accountNumber" name="accountNumber" type="BankAccount_Integer"/>
      <ownedAttribute xmi:id="BankAccount_BankAccount_balance" name="balance" type="BankAccount_Integer"/>
      <ownedOperation xmi:id="BankAccount_BankAccount_assignNewCard" name="assignNewCard" isQuery="false" postcondition="BankAccount_BankAccount_assignNewCard_post4 BankAccount_BankAccount_assignNewCard_post5">
        <ownedRule xmi:id="BankAccount_BankAccount_assignNewCard_post4" name="post4">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="BankAccount_BankAccount_assignNewCard_post4_specification">
            <body>(DebitCard.allInstances-&gt;select($elem2 : DebitCard | $elem2.oclIsNew)-&gt;size = 1)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="BankAccount_BankAccount_assignNewCard_post5" name="post5">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="BankAccount_BankAccount_assignNewCard_post5_specification">
            <body>self.card-&gt;includes(DebitCard.allInstances-&gt;select($elem3 : DebitCard | $elem3.oclIsNew)-&gt;any($elem4 : DebitCard | true))</body>
          </specification>
        </ownedRule>
      </ownedOperation>
      <ownedOperation xmi:id="BankAccount_BankAccount_deposit" name="deposit" isQuery="false" postcondition="BankAccount_BankAccount_deposit_post2">
        <ownedParameter xmi:id="BankAccount_BankAccount_deposit_amount" name = "amount" type="BankAccount_Integer" direction="in">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="BankAccount_BankAccount_deposit_amount" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="BankAccount_BankAccount_deposit_amount" value="1"/>
        </ownedParameter>
        <ownedRule xmi:id="BankAccount_BankAccount_deposit_post2" name="post2">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="BankAccount_BankAccount_deposit_post2_specification">
            <body>(self.balance = (self.balance@pre + amount))</body>
          </specification>
        </ownedRule>
      </ownedOperation>
      <ownedOperation xmi:id="BankAccount_BankAccount_withdraw" name="withdraw" isQuery="false" postcondition="BankAccount_BankAccount_withdraw_post1">
        <ownedParameter xmi:id="BankAccount_BankAccount_withdraw_amount" name = "amount" type="BankAccount_Integer" direction="in">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="BankAccount_BankAccount_withdraw_amount" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="BankAccount_BankAccount_withdraw_amount" value="1"/>
        </ownedParameter>
        <ownedRule xmi:id="BankAccount_BankAccount_withdraw_post1" name="post1">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="BankAccount_BankAccount_withdraw_post1_specification">
            <body>(self.balance = (self.balance@pre - amount))</body>
          </specification>
        </ownedRule>
      </ownedOperation>
      <ownedRule xmi:id="BankAccount_BankAccount_inv1" name="inv1">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="BankAccount_BankAccount_inv1_specification">
          <body>(not self.card-&gt;isEmpty implies self.card-&gt;forAll($elem0 : DebitCard | ($elem0.limit &lt;= self.balance)))</body>
        </specification>
      </ownedRule>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="BankAccount_DebitCard" name="DebitCard">
      <ownedAttribute xmi:id="BankAccount_DebitCard_cardNumber" name="cardNumber" type="BankAccount_Integer"/>
      <ownedAttribute xmi:id="BankAccount_DebitCard_limit" name="limit" type="BankAccount_Integer"/>
      <ownedOperation xmi:id="BankAccount_DebitCard_pay" name="pay" isQuery="false" precondition="BankAccount_DebitCard_pay_pre1"  postcondition="BankAccount_DebitCard_pay_post3">
        <ownedParameter xmi:id="BankAccount_DebitCard_pay_amount" name = "amount" type="BankAccount_Integer" direction="in">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="BankAccount_DebitCard_pay_amount" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="BankAccount_DebitCard_pay_amount" value="1"/>
        </ownedParameter>
        <ownedRule xmi:id="BankAccount_DebitCard_pay_pre1" name="pre1">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="BankAccount_DebitCard_pay_pre1_specification">
            <body>(amount &lt; self.limit)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="BankAccount_DebitCard_pay_post3" name="post3">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="BankAccount_DebitCard_pay_post3_specification">
            <body>(self.account.balance = (self.account.balance@pre - amount))</body>
          </specification>
        </ownedRule>
      </ownedOperation>
      <ownedRule xmi:id="BankAccount_DebitCard_inv2" name="inv2">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="BankAccount_DebitCard_inv2_specification">
          <body>(self.limit &gt; 0)</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="BankAccount_DebitCard_inv3" name="inv3">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="BankAccount_DebitCard_inv3_specification">
          <body>DebitCard.allInstances-&gt;isUnique($elem1 : DebitCard | $elem1.cardNumber)</body>
        </specification>
      </ownedRule>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="BankAccount_AccountCard" name="AccountCard" memberEnd="BankAccount_AccountCard_account BankAccount_AccountCard_card">
      <ownedEnd xmi:id="BankAccount_AccountCard_account" name="account" type="BankAccount_BankAccount" association="BankAccount_AccountCard">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="BankAccount_AccountCard_account_lower" value="1"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="BankAccount_AccountCard_account_upper" value="1"/>
      </ownedEnd>
      <ownedEnd xmi:id="BankAccount_AccountCard_card" name="card" type="BankAccount_DebitCard" association="BankAccount_AccountCard">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="BankAccount_AccountCard_card_lower" value="0"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="BankAccount_AccountCard_card_upper" value="*"/>
      </ownedEnd>
    </packagedElement>
    </uml:Model></xmi:XMI>