model BankAccountSTM

class Snapshot
operations
getNext() : Snapshot = self.nextT.nextS

getPost() : Set(Snapshot) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : Snapshot = self.beforeT.beforeS

getPre() : Set(Snapshot) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

sat(e : OclAny) : Boolean = true

end

class DebitCard
attributes
cardNumber : Integer
limit : Integer
snapshotObjectId : Integer
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : DebitCard = self.snapshot.getNext().debitcard->any(d | self.snapshotObjectId = d.snapshotObjectId)

getPost() : Set(DebitCard) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : DebitCard = self.snapshot.getPrevious().debitcard->any(d | self.snapshotObjectId = d.snapshotObjectId)

getPre() : Set(DebitCard) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : DebitCard = refSnap.debitcard->any(d | self.snapshotObjectId = d.snapshotObjectId)

end

class BankAccount
attributes
accountNumber : Integer
balance : Integer
snapshotObjectId : Integer
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : BankAccount = self.snapshot.getNext().bankaccount->any(b | self.snapshotObjectId = b.snapshotObjectId)

getPost() : Set(BankAccount) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : BankAccount = self.snapshot.getPrevious().bankaccount->any(b | self.snapshotObjectId = b.snapshotObjectId)

getPre() : Set(BankAccount) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : BankAccount = refSnap.bankaccount->any(b | self.snapshotObjectId = b.snapshotObjectId)

end

class FirstSnapshot < Snapshot
end

class LastSnapshot < Snapshot
end

association AccountCard between
BankAccount[1] role account
DebitCard[0..*] role card
end
abstract class Transition
end

class BankAccount_assignNewCard < Transition
attributes
transitionContext : BankAccount
end

class BankAccount_deposit < Transition
attributes
amount : Integer
transitionContext : BankAccount
end

class BankAccount_withdraw < Transition
attributes
amount : Integer
transitionContext : BankAccount
end

class DebitCard_pay < Transition
attributes
amount : Integer
transitionContext : DebitCard
end

composition SnapshotDebitCard between
Snapshot[1] role snapshot
DebitCard[0..*] role debitcard
end
composition SnapshotBankAccount between
Snapshot[1] role snapshot
BankAccount[0..*] role bankaccount
end
association beforeTransition between
Snapshot[1] role beforeS
Transition[0..1] role nextT
end
association afterTransition between
Snapshot[1] role nextS
Transition[0..1] role beforeT
end

constraints
context Snapshot
inv acyclicScenareo: self.getPost()->excludes(self) and self.getPre()->excludes(self)

context Snapshot
inv sameSnapshot: Snapshot.allInstances()->forAll(s | (self.nextT = s.nextT and self.beforeT = s.beforeT) implies self = s)

context Snapshot
inv oneScenareo: Snapshot.allInstances()->select(oclIsTypeOf(FirstSnapshot))->size() <= 1 and Snapshot.allInstances()->select(oclIsTypeOf(LastSnapshot))->size() <= 1 and Snapshot.allInstances()->select(not (oclIsTypeOf(FirstSnapshot) or oclIsTypeOf(LastSnapshot)))->forAll(getPre()->exists(oclIsTypeOf(FirstSnapshot)) and getPost()->exists(oclIsTypeOf(LastSnapshot)))

context Snapshot
inv firstLast: Snapshot.allInstances()->size() > 1 implies ((self.beforeT.oclIsUndefined() implies self.oclIsTypeOf(FirstSnapshot)) and (self.nextT.oclIsUndefined() implies self.oclIsTypeOf(LastSnapshot)))

context DebitCard
inv uniqueIds: DebitCard.allInstances()->forAll(d : DebitCard | (d.snapshot = self.snapshot and d.snapshotObjectId = self.snapshotObjectId) implies d = self)

context DebitCard
inv inv3: DebitCard.allInstances->isUnique($elem1 : DebitCard | $elem1.cardNumber)

context DebitCard
inv inv2: (self.limit > 0)


context BankAccount
inv inv1: (not self.card->isEmpty implies self.card->forAll($elem0 : DebitCard | ($elem0.limit <= self.balance)))

context BankAccount
inv uniqueIds: BankAccount.allInstances()->forAll(b : BankAccount | (b.snapshot = self.snapshot and b.snapshotObjectId = self.snapshotObjectId) implies b = self)

context BankAccount
inv validLinking_AccountCard: Set{self.snapshot.debitcard}->flatten()->includesAll(Set{self.card}->flatten()->excluding(null))


context Transition
inv sameTransition: Transition.allInstances()->forAll(t : Transition | (self.nextS = t.nextS and self.beforeS = t.beforeS) implies self = t)

context BankAccount_assignNewCard
inv post4: (DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->select( $elem2:DebitCard | $elem2.getPrevious().oclIsUndefined() )->size() = 1)

context BankAccount_assignNewCard
inv frameSus_DebitCard: let DebitCard_C : Set(DebitCard) = Set{self.transitionContext.getNext().card->asSet()->select(getNext().account.snapshotObjectId <> account.snapshotObjectId)}->flatten() in (self.transitionContext.card->asSet()->select(getNext().account.snapshotObjectId <> account.snapshotObjectId) <> null and Set{self.transitionContext.card->asSet()->select(getNext().account.snapshotObjectId <> account.snapshotObjectId)}->flatten() <> Set{} implies (self.transitionContext.card->asSet()->select(getNext().account.snapshotObjectId <> account.snapshotObjectId).getNext().cardNumber = self.transitionContext.card->asSet()->select(getNext().account.snapshotObjectId <> account.snapshotObjectId).cardNumber and self.transitionContext.card->asSet()->select(getNext().account.snapshotObjectId <> account.snapshotObjectId).getNext().limit = self.transitionContext.card->asSet()->select(getNext().account.snapshotObjectId <> account.snapshotObjectId).limit)) and (DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.debitcard->any(o | o.snapshotObjectId = id))->asSet()-DebitCard_C)->forAll(getNext().cardNumber = cardNumber and getNext().limit = limit and getNext().account.snapshotObjectId = account.snapshotObjectId and true)

context BankAccount_assignNewCard
inv frameDel_BankAccount: (BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_assignNewCard
inv frameAdd_BankAccount: (BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_assignNewCard
inv validContext: self.transitionContext.snapshot = self.beforeS

context BankAccount_assignNewCard
inv post5: self.transitionContext.getNext().card->includes(DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->select( $elem3:DebitCard | $elem3.getPrevious().oclIsUndefined() )->any( $elem4:DebitCard | true ))

context BankAccount_assignNewCard
inv frameSus_BankAccount: let BankAccount_C : Set(BankAccount) = Set{Set{self.transitionContext.getNext().getPrevious()}->flatten()}->flatten() in (self.transitionContext <> null and Set{self.transitionContext}->flatten() <> Set{} implies (self.transitionContext.getNext().accountNumber = self.transitionContext.accountNumber and self.transitionContext.getNext().balance = self.transitionContext.balance)) and (BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.bankaccount->any(o | o.snapshotObjectId = id))->asSet()-BankAccount_C)->forAll(getNext().accountNumber = accountNumber and getNext().balance = balance and getNext().card->collect(snapshotObjectId)->asSet() = card->collect(snapshotObjectId)->asSet() and true)

context BankAccount_assignNewCard
inv frameDel_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_deposit
inv frameAdd_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_deposit
inv post2: (self.transitionContext.getNext().balance = (self.transitionContext.balance + amount))

context BankAccount_deposit
inv validContext: self.transitionContext.snapshot = self.beforeS

context BankAccount_deposit
inv frameSus_BankAccount: let BankAccount_C : Set(BankAccount) = Set{Set{self.transitionContext.getNext().getPrevious()}->flatten()}->flatten() in (self.transitionContext <> null and Set{self.transitionContext}->flatten() <> Set{} implies (self.transitionContext.getNext().accountNumber = self.transitionContext.accountNumber and self.transitionContext.getNext().card->collect(snapshotObjectId)->asSet() = self.transitionContext.card->collect(snapshotObjectId)->asSet())) and (BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.bankaccount->any(o | o.snapshotObjectId = id))->asSet()-BankAccount_C)->forAll(getNext().accountNumber = accountNumber and getNext().balance = balance and getNext().card->collect(snapshotObjectId)->asSet() = card->collect(snapshotObjectId)->asSet() and true)

context BankAccount_deposit
inv frameSus_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.debitcard->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().cardNumber = cardNumber and getNext().limit = limit and getNext().account.snapshotObjectId = account.snapshotObjectId and true)

context BankAccount_deposit
inv frameDel_BankAccount: (BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_deposit
inv frameAdd_BankAccount: (BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_deposit
inv frameDel_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_withdraw
inv frameSus_BankAccount: let BankAccount_C : Set(BankAccount) = Set{Set{self.transitionContext.getNext().getPrevious()}->flatten()}->flatten() in (self.transitionContext <> null and Set{self.transitionContext}->flatten() <> Set{} implies (self.transitionContext.getNext().accountNumber = self.transitionContext.accountNumber and self.transitionContext.getNext().card->collect(snapshotObjectId)->asSet() = self.transitionContext.card->collect(snapshotObjectId)->asSet())) and (BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.bankaccount->any(o | o.snapshotObjectId = id))->asSet()-BankAccount_C)->forAll(getNext().accountNumber = accountNumber and getNext().balance = balance and getNext().card->collect(snapshotObjectId)->asSet() = card->collect(snapshotObjectId)->asSet() and true)

context BankAccount_withdraw
inv frameDel_BankAccount: (BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_withdraw
inv frameDel_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_withdraw
inv frameAdd_BankAccount: (BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context BankAccount_withdraw
inv post1: (self.transitionContext.getNext().balance = (self.transitionContext.balance - amount))

context BankAccount_withdraw
inv validContext: self.transitionContext.snapshot = self.beforeS

context BankAccount_withdraw
inv frameSus_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.debitcard->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().cardNumber = cardNumber and getNext().limit = limit and getNext().account.snapshotObjectId = account.snapshotObjectId and true)

context BankAccount_withdraw
inv frameAdd_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context DebitCard_pay
inv frameDel_BankAccount: (BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context DebitCard_pay
inv frameDel_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context DebitCard_pay
inv pre1: (amount < self.transitionContext.limit)

context DebitCard_pay
inv frameSus_BankAccount: let BankAccount_C : Set(BankAccount) = Set{Set{self.transitionContext.getNext().account.getPrevious()}->flatten()}->flatten() in (self.transitionContext.account <> null and Set{self.transitionContext.account}->flatten() <> Set{} implies (self.transitionContext.account.getNext().accountNumber = self.transitionContext.account.accountNumber and self.transitionContext.account.getNext().card->collect(snapshotObjectId)->asSet() = self.transitionContext.account.card->collect(snapshotObjectId)->asSet())) and (BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.bankaccount->any(o | o.snapshotObjectId = id))->asSet()-BankAccount_C)->forAll(getNext().accountNumber = accountNumber and getNext().balance = balance and getNext().card->collect(snapshotObjectId)->asSet() = card->collect(snapshotObjectId)->asSet() and true)

context DebitCard_pay
inv post3: (self.transitionContext.getNext().account.balance = (self.transitionContext.getNext().account.getPrevious().balance - amount))

context DebitCard_pay
inv frameSus_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.debitcard->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().cardNumber = cardNumber and getNext().limit = limit and getNext().account.snapshotObjectId = account.snapshotObjectId and true)

context DebitCard_pay
inv frameAdd_BankAccount: (BankAccount.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-BankAccount.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context DebitCard_pay
inv validContext: self.transitionContext.snapshot = self.beforeS

context DebitCard_pay
inv frameAdd_DebitCard: (DebitCard.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-DebitCard.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0


context BankAccount inv BA1: not((let CS:Snapshot = self.getCurrentSnapshot() in CS.getPost()->including(CS)->exists(s | self.atSnapshot(s).balance > 0)))
