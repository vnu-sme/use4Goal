model BankAccount


aggregation PredSuccBankAccount between
  BankAccount[0..1] role predBankAccount
  BankAccount[0..1] role succBankAccount
end

composition SnapshotDebitCard between
  Snapshot[1] role snapshotDebitCard
  DebitCard[*]
end

composition SnapshotBankAccount between
  Snapshot[1] role snapshotBankAccount
  BankAccount[*]
end

class assignNewCard_BankAccountOpC < BankAccountOpC
end

class withdraw_BankAccountOpC < BankAccountOpC
attributes
  amount : Integer
end

association Filmstrip between
  Snapshot[0..1] role pred
  Snapshot[0..1] role succ
  OperationCall[0..1]
end

aggregation PredSuccDebitCard between
  DebitCard[0..1] role predDebitCard
  DebitCard[0..1] role succDebitCard
end

class Snapshot
operations
  pred() : Snapshot = 
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot = 
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

abstract class OperationCall
operations
  pred() : Snapshot = 
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot = 
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

abstract class DebitCardOpC < OperationCall
attributes
  aSelf : DebitCard
end

class pay_DebitCardOpC < DebitCardOpC
attributes
  amount : Integer
end

class deposit_BankAccountOpC < BankAccountOpC
attributes
  amount : Integer
end

abstract class BankAccountOpC < OperationCall
attributes
  aSelf : BankAccount
end

class BankAccount
attributes
  id : Integer
  balance : Integer
  accountNumber : Integer
operations
  deposit(amount : Integer)
  withdraw(amount : Integer)
  assignNewCard()
end

class DebitCard
attributes
  id : Integer
  cardNumber : Integer
  limit : Integer
operations
  pay(amount : Integer)
end

association AccountCard between
  BankAccount[1] role account
  DebitCard[*] role card
end

constraints
context BankAccount inv validLinkingAccountCard:
  self.card->forAll( c:DebitCard | (c.snapshotDebitCard = self.snapshotBankAccount) )

context BankAccount inv validSnapshotLinking:
  (self.succBankAccount.isDefined() implies (self.succBankAccount.snapshotBankAccount = self.snapshotBankAccount.succ()))

context BankAccountOpC inv aSelfDefined:
  self.aSelf.isDefined()

context BankAccountOpC inv aSelfInPred:
  (self.aSelf.snapshotBankAccount = self.pred())

context DebitCard inv validSnapshotLinking:
  (self.succDebitCard.isDefined() implies (self.succDebitCard.snapshotDebitCard = self.snapshotDebitCard.succ()))

context DebitCardOpC inv aSelfDefined:
  self.aSelf.isDefined()

context DebitCardOpC inv aSelfInPred:
  (self.aSelf.snapshotDebitCard = self.pred())

context OperationCall inv assocClassBehavior:
  (((self.pred->size() = 1) and (self.succ->size() = 1)) and OperationCall.allInstances()->forAll( op:OperationCall | (((self.pred = op.pred) and (self.succ = op.succ)) implies (self = op)) ))

context Snapshot inv cycleFree:
  Set{self.succ()}->closure( s:Snapshot | s.succ() )->excludes(self)

context Snapshot inv oneFilmstrip:
  ((Snapshot.allInstances()->select( s:Snapshot | s.pred().isUndefined() )->size() = 1) and (Snapshot.allInstances()->select( s:Snapshot | s.succ().isUndefined() )->size() = 1))

context assignNewCard_BankAccountOpC inv post_post4:
  (self.succ().debitCard->select( $elem1:DebitCard | $elem1.predDebitCard.isUndefined() )->size() = 1)

context assignNewCard_BankAccountOpC inv post_post5:
  aSelf.succBankAccount.card->includes(self.succ().debitCard->select( $elem2:DebitCard | $elem2.predDebitCard.isUndefined() )->any( $elem3:DebitCard | true ))

context deposit_BankAccountOpC inv post_post2:
  (aSelf.succBankAccount.balance = (aSelf.succBankAccount.predBankAccount.balance + amount))

context pay_DebitCardOpC inv post_post3:
  (aSelf.succDebitCard.account.balance = (aSelf.succDebitCard.account.predBankAccount.balance - amount))

context pay_DebitCardOpC inv pre_pre1:
  (amount < aSelf.limit)

context withdraw_BankAccountOpC inv post_post1:
  (aSelf.succBankAccount.balance = (aSelf.succBankAccount.predBankAccount.balance - amount))

context self : BankAccount inv inv1:
  (not self.card->isEmpty() implies self.card->forAll( $elem0:DebitCard | ($elem0.limit <= self.balance) ))

context self : DebitCard inv inv2:
  (self.limit > 0)

context BankAccount
inv BankAccountSameId: self.succBankAccount.isDefined() implies self.id = self.succBankAccount.id
context DebitCard
inv DebitCardSameId: self.succDebitCard.isDefined() implies self.id = self.succDebitCard.id

context BankAccount
inv BankAccountDiffId: self.snapshotBankAccount.bankAccount->forAll(o | o <> self implies o.id <> self.id)
context DebitCard
inv DebitCardDiffId: self.snapshotDebitCard.debitCard->forAll(o | o <> self implies o.id <> self.id)

context BankAccount
    -- If the account balance falls below zero (debt), it must eventually return to a positive state at some future point.
    inv Recovery: self.balance < 0 implies (let CS:Snapshot = self.snapshotBankAccount in Set{CS}->closure(s | s.succ())->excluding(null)->exists(s | (s.bankAccount->any(o | self.id = o.id).balance > 0)))

    -- The operation to assign a new card is restricted to occur at most three times throughout the system's execution.
    inv MaxCardIssuance: assignNewCard_BankAccountOpC.allInstances()->select(op | op.succ() = self.snapshotBankAccount)->size() <= 3

    -- Immediate Response: Whenever the account balance transitions to a negative value (overdraft), a withdrawal operation (representing a penalty fee) must be invoked in the immediate next state.
    inv OverdraftPenalty: (let currentObject = self.snapshotBankAccount.bankAccount->any(o | o.id = self.id) in let previousObject = self.snapshotBankAccount.pred().bankAccount->any(o | o.id = self.id) in not (previousObject.balance < 0) and (currentObject.balance < 0)) implies (let CS:Snapshot = self.snapshotBankAccount in withdraw_BankAccountOpC.allInstances()->exists(op | op.succ() = self.snapshotBankAccount.succ()))

    inv Effect_Deposit: 
        deposit_BankAccountOpC.allInstances()->exists(op | op.succ() = self.snapshotBankAccount) implies (self.snapshotBankAccount.succ().bankAccount->any(o | self.id = o.id).balance > previous(self.snapshotBankAccount.succ().bankAccount->any(o | self.id = o.id).balance))

context DebitCard
    -- Causality: A payment operation can only be executed if the card assignment operation has successfully occurred at some point in the past.
    -- inv PayRequiresAssignment: isCalled(pay()) implies sometimePast isCalled(account.assignNewCard())
