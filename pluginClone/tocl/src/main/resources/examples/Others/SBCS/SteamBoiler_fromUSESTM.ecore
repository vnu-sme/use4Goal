    <ownedElements xsi:type="sTM:TransitionClass" name="SteamMeasurementDevice_getSteam"
        transitionParent="#/1/@ownedElements.15">
      <generalization general="#/1/@ownedElements.15"/>
      <attributes name="result" type="#/1/@ownedElements.22" upper="1"/>
      <constraints name="pre1">
        <specification xsi:type="sTM:OpaqueExpression">
          <body>(self.transitionContext.program.mode = Mode::Normal)</body>
          <language>OCL</language>
        </specification>
      </constraints>
      <constraints name="post1">
        <specification xsi:type="sTM:OpaqueExpression">
          <body>(self.evaporationRate = result)</body>
          <language>OCL</language>
        </specification>
      </constraints>
      <context name="transitionContext" type="#/1/@ownedElements.0/@snapshotObjects.4"
          upper="1"/>
    </ownedElements>
    <ownedElements xsi:type="sTM:TransitionClass" name="ControlProgram_startOperation"
        transitionParent="#/1/@ownedElements.15">
      <generalization general="#/1/@ownedElements.15"/>
      <constraints name="pre1">
        <specification xsi:type="sTM:OpaqueExpression">
          <body>(self.transitionContext.ready = false)</body>
          <language>OCL</language>
