        enumerationLiteral="#/1/@ownedElements.13/@ownedLiteral.0 #/1/@ownedElements.13/@ownedLiteral.1 #/1/@ownedElements.13/@ownedLiteral.2 #/1/@ownedElements.13/@ownedLiteral.3 #/1/@ownedElements.13/@ownedLiteral.4">
      <ownedLiteral name="Normal" enumeration="#/1/@ownedElements.13"/>
      <ownedLiteral name="Initialization" enumeration="#/1/@ownedElements.13"/>
      <ownedLiteral name="Degraded" enumeration="#/1/@ownedElements.13"/>
      <ownedLiteral name="Rescue" enumeration="#/1/@ownedElements.13"/>
