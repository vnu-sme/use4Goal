  <sTM:Model name="SteamBoilerSTM">
    <ownedElements xsi:type="sTM:SnapshotClassifier" name="Snapshot">
      <snapshotObjects name="WaterLevelMeasurementDevice" typedElement="#/1/@ownedElements.18/@context #/1/@ownedElements.4/@ownedEnd.1 #/1/@ownedElements.10/@ownedEnd.1">
        <attributes name="waterLevel" type="#/1/@ownedElements.22" lower="1" upper="1"/>
        <constraints name="WaterLevelLimit">
          <specification xsi:type="sTM:OpaqueExpression">
            <body>(self.waterLevel &lt;= self.sb.capacity)</body>
          </specification>
        </constraints>
      </snapshotObjects>
      <snapshotObjects name="ControlProgram" typedElement="#/1/@ownedElements.17/@context #/1/@ownedElements.8/@ownedEnd.0 #/1/@ownedElements.4/@ownedEnd.0 #/1/@ownedElements.7/@ownedEnd.0 #/1/@ownedElements.9/@ownedEnd.0 #/1/@ownedElements.3/@ownedEnd.1">
