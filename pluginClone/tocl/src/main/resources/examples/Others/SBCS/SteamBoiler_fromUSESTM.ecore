            upper="1"/>
        <attributes name="mode" type="#/1/@ownedElements.13" lower="1" upper="1"/>
        <attributes name="pumpControllerFailure" type="#/1/@ownedElements.23" lower="1"
            upper="1"/>
        <attributes name="pumpFailure" type="#/1/@ownedElements.23" lower="1" upper="1"/>
        <attributes name="ready" type="#/1/@ownedElements.23" lower="1" upper="1"/>
        <attributes name="smdFailure" type="#/1/@ownedElements.23" lower="1" upper="1"/>
        <attributes name="wlmdFailure" type="#/1/@ownedElements.23" lower="1" upper="1"/>
      </snapshotObjects>
      <snapshotObjects name="PumpController" typedElement="#/1/@ownedElements.19/@context #/1/@ownedElements.20/@context #/1/@ownedElements.8/@ownedEnd.1 #/1/@ownedElements.5/@ownedEnd.0">
        <attributes name="circulating" type="#/1/@ownedElements.23" lower="1" upper="1"/>
      </snapshotObjects>
      <snapshotObjects name="SteamBoiler" typedElement="#/1/@ownedElements.21/@context #/1/@ownedElements.11/@ownedEnd.0 #/1/@ownedElements.10/@ownedEnd.0 #/1/@ownedElements.3/@ownedEnd.0 #/1/@ownedElements.6/@ownedEnd.0">
        <attributes name="capacity" type="#/1/@ownedElements.22" lower="1" upper="1"/>
        <attributes name="maximalLimit" type="#/1/@ownedElements.22" lower="1" upper="1"/>
        <attributes name="maximalNormal" type="#/1/@ownedElements.22" lower="1" upper="1"/>
        <attributes name="maximumDecrease" type="#/1/@ownedElements.22" lower="1"
            upper="1"/>
        <attributes name="maximumIncrease" type="#/1/@ownedElements.22" lower="1"
            upper="1"/>
        <attributes name="minimalLimit" type="#/1/@ownedElements.22" lower="1" upper="1"/>
        <attributes name="minimalNormal" type="#/1/@ownedElements.22" lower="1" upper="1"/>
        <attributes name="valveOpen" type="#/1/@ownedElements.12" lower="1" upper="1"/>
        <constraints name="ValveOpenInv">
          <specification xsi:type="sTM:OpaqueExpression">
            <body>((self.valveOpen = ValveState::open) implies (self.program.mode = Mode::Initialization))</body>
          </specification>
        </constraints>
      </snapshotObjects>
      <snapshotObjects name="SteamMeasurementDevice" typedElement="#/1/@ownedElements.16/@context #/1/@ownedElements.11/@ownedEnd.1 #/1/@ownedElements.9/@ownedEnd.1">
        <attributes name="evaporationRate" type="#/1/@ownedElements.22" lower="1"
            upper="1"/>
      </snapshotObjects>
      <snapshotObjects name="Pump" typedElement="#/1/@ownedElements.7/@ownedEnd.1 #/1/@ownedElements.5/@ownedEnd.1 #/1/@ownedElements.6/@ownedEnd.1">
        <attributes name="capacity" type="#/1/@ownedElements.22" lower="1" upper="1"/>
        <attributes name="mode" type="#/1/@ownedElements.14" lower="1" upper="1"/>
      </snapshotObjects>
      <snapshotObjects name="PhysicalUnit">
        <attributes name="ready" type="#/1/@ownedElements.23" lower="1" upper="1"/>
      </snapshotObjects>
    </ownedElements>
