snapshotObjectId : Integer
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : PhysicalUnit = self.snapshot.getNext().physicalunit->any(p | self.snapshotObjectId = p.snapshotObjectId)

getPost() : Set(PhysicalUnit) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : PhysicalUnit = self.snapshot.getPrevious().physicalunit->any(p | self.snapshotObjectId = p.snapshotObjectId)

