atSnapshot(refSnap : Snapshot) : PhysicalUnit = refSnap.physicalunit->any(p | self.snapshotObjectId = p.snapshotObjectId)

end

class FirstSnapshot < Snapshot
end

class LastSnapshot < Snapshot
end

association SteamBoilerControlProgram between
SteamBoiler[1] role sb
ControlProgram[1] role program
end
association ControlProgramWLMD between
ControlProgram[1] role program
WaterLevelMeasurementDevice[1] role wlmd
end
association PumpControllerPump between
PumpController[1] role controller
Pump[1] role pump
end
association SteamBoilerPump between
SteamBoiler[1] role sb
Pump[1] role pump
end
association ControlProgramPump between
ControlProgram[1] role program
Pump[1] role pump
end
association ControlProgramPumpControler between
ControlProgram[1] role program
PumpController[1] role PC
end
association ControlProgramSMD between
ControlProgram[1] role program
SteamMeasurementDevice[1] role smd
end
association SteamBoilerWLMD between
SteamBoiler[1] role sb
WaterLevelMeasurementDevice[1] role wlmd
end
association SteamBoilerSMD between
SteamBoiler[1] role sb
SteamMeasurementDevice[1] role smd
end
enum ValveState {open, closed}

enum Mode {Normal, Initialization, Degraded, Rescue, EmergencyStop}

enum State {on, off}

abstract class Transition
end

class SteamMeasurementDevice_getSteam < Transition
attributes
result : Real
transitionContext : SteamMeasurementDevice
end

class ControlProgram_startOperation < Transition
attributes
transitionContext : ControlProgram
end

class WaterLevelMeasurementDevice_getLevel < Transition
attributes
result : Real
transitionContext : WaterLevelMeasurementDevice
end

class PumpController_closePump < Transition
attributes
transitionContext : PumpController
end

class PumpController_openPump < Transition
attributes
transitionContext : PumpController
end

class SteamBoiler_openValve < Transition
attributes
transitionContext : SteamBoiler
end

composition SnapshotWaterLevelMeasurementDevice between
Snapshot[1] role snapshot
WaterLevelMeasurementDevice[0..*] role waterlevelmeasurementdevice
end
composition SnapshotControlProgram between
Snapshot[1] role snapshot
ControlProgram[0..*] role controlprogram
end
composition SnapshotPumpController between
Snapshot[1] role snapshot
PumpController[0..*] role pumpcontroller
end
composition SnapshotSteamBoiler between
Snapshot[1] role snapshot
SteamBoiler[0..*] role steamboiler
end
composition SnapshotSteamMeasurementDevice between
Snapshot[1] role snapshot
SteamMeasurementDevice[0..*] role steammeasurementdevice
end
composition SnapshotPump between
Snapshot[1] role snapshot
Pump[0..*] role pump
end
composition SnapshotPhysicalUnit between
Snapshot[1] role snapshot
PhysicalUnit[0..*] role physicalunit
end
association beforeTransition between
Snapshot[1] role beforeS
Transition[0..1] role nextT
end
association afterTransition between
Snapshot[1] role nextS
Transition[0..1] role beforeT
end

constraints
context Snapshot
inv acyclicScenareo: self.getPost()->excludes(self) and self.getPre()->excludes(self)

context Snapshot
inv sameSnapshot: Snapshot.allInstances()->forAll(s | (self.nextT = s.nextT and self.beforeT = s.beforeT) implies self = s)

context Snapshot
inv oneScenareo: Snapshot.allInstances()->select(oclIsTypeOf(FirstSnapshot))->size() <= 1 and Snapshot.allInstances()->select(oclIsTypeOf(LastSnapshot))->size() <= 1 and Snapshot.allInstances()->select(not (oclIsTypeOf(FirstSnapshot) or oclIsTypeOf(LastSnapshot)))->forAll(getPre()->exists(oclIsTypeOf(FirstSnapshot)) and getPost()->exists(oclIsTypeOf(LastSnapshot)))

context Snapshot
inv firstLast: Snapshot.allInstances()->size() > 1 implies ((self.beforeT.oclIsUndefined() implies self.oclIsTypeOf(FirstSnapshot)) and (self.nextT.oclIsUndefined() implies self.oclIsTypeOf(LastSnapshot)))

context WaterLevelMeasurementDevice
inv uniqueIds: WaterLevelMeasurementDevice.allInstances()->forAll(w : WaterLevelMeasurementDevice | (w.snapshot = self.snapshot and w.snapshotObjectId = self.snapshotObjectId) implies w = self)

context WaterLevelMeasurementDevice
inv WaterLevelLimit: (self.waterLevel <= self.sb.capacity)


context ControlProgram
inv validLinking_ControlProgramWLMD: Set{self.snapshot.waterlevelmeasurementdevice}->flatten()->includesAll(Set{self.wlmd}->flatten()->excluding(null))

context ControlProgram
inv uniqueIds: ControlProgram.allInstances()->forAll(c : ControlProgram | (c.snapshot = self.snapshot and c.snapshotObjectId = self.snapshotObjectId) implies c = self)

context ControlProgram
inv validLinking_ControlProgramSMD: Set{self.snapshot.steammeasurementdevice}->flatten()->includesAll(Set{self.smd}->flatten()->excluding(null))

context ControlProgram
inv validLinking_ControlProgramPumpControler: Set{self.snapshot.pumpcontroller}->flatten()->includesAll(Set{self.PC}->flatten()->excluding(null))

context ControlProgram
inv validLinking_ControlProgramPump: Set{self.snapshot.pump}->flatten()->includesAll(Set{self.pump}->flatten()->excluding(null))


context PumpController
inv uniqueIds: PumpController.allInstances()->forAll(p : PumpController | (p.snapshot = self.snapshot and p.snapshotObjectId = self.snapshotObjectId) implies p = self)

context PumpController
inv validLinking_PumpControllerPump: Set{self.snapshot.pump}->flatten()->includesAll(Set{self.pump}->flatten()->excluding(null))


context SteamBoiler
inv validLinking_SteamBoilerWLMD: Set{self.snapshot.waterlevelmeasurementdevice}->flatten()->includesAll(Set{self.wlmd}->flatten()->excluding(null))

context SteamBoiler
inv validLinking_SteamBoilerPump: Set{self.snapshot.pump}->flatten()->includesAll(Set{self.pump}->flatten()->excluding(null))

context SteamBoiler
inv validLinking_SteamBoilerControlProgram: Set{self.snapshot.controlprogram}->flatten()->includesAll(Set{self.program}->flatten()->excluding(null))

context SteamBoiler
inv uniqueIds: SteamBoiler.allInstances()->forAll(s : SteamBoiler | (s.snapshot = self.snapshot and s.snapshotObjectId = self.snapshotObjectId) implies s = self)

context SteamBoiler
inv ValveOpenInv: ((self.valveOpen = ValveState::open) implies (self.program.mode = Mode::Initialization))

context SteamBoiler
inv validLinking_SteamBoilerSMD: Set{self.snapshot.steammeasurementdevice}->flatten()->includesAll(Set{self.smd}->flatten()->excluding(null))


context SteamMeasurementDevice
inv uniqueIds: SteamMeasurementDevice.allInstances()->forAll(s : SteamMeasurementDevice | (s.snapshot = self.snapshot and s.snapshotObjectId = self.snapshotObjectId) implies s = self)


context Pump
inv uniqueIds: Pump.allInstances()->forAll(p : Pump | (p.snapshot = self.snapshot and p.snapshotObjectId = self.snapshotObjectId) implies p = self)


context PhysicalUnit
inv uniqueIds: PhysicalUnit.allInstances()->forAll(p : PhysicalUnit | (p.snapshot = self.snapshot and p.snapshotObjectId = self.snapshotObjectId) implies p = self)


context Transition
inv sameTransition: Transition.allInstances()->forAll(t : Transition | (self.nextS = t.nextS and self.beforeS = t.beforeS) implies self = t)

context SteamMeasurementDevice_getSteam
inv validContext: self.transitionContext.snapshot = self.beforeS

context SteamMeasurementDevice_getSteam
inv frameSus_Pump: (Pump.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(Pump.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.pump->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().capacity = capacity and getNext().mode = mode and getNext().controller.snapshotObjectId = controller.snapshotObjectId and getNext().program.snapshotObjectId = program.snapshotObjectId and getNext().sb.snapshotObjectId = sb.snapshotObjectId and true)

context SteamMeasurementDevice_getSteam
inv frameSus_PhysicalUnit: (PhysicalUnit.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(PhysicalUnit.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.physicalunit->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().ready = ready and true)

context SteamMeasurementDevice_getSteam
inv frameSus_ControlProgram: (ControlProgram.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(ControlProgram.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.controlprogram->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().failureDetected = failureDetected and getNext().mode = mode and getNext().pumpControllerFailure = pumpControllerFailure and getNext().pumpFailure = pumpFailure and getNext().ready = ready and getNext().smdFailure = smdFailure and getNext().wlmdFailure = wlmdFailure and getNext().PC.snapshotObjectId = PC.snapshotObjectId and getNext().pump.snapshotObjectId = pump.snapshotObjectId and getNext().sb.snapshotObjectId = sb.snapshotObjectId and getNext().smd.snapshotObjectId = smd.snapshotObjectId and getNext().wlmd.snapshotObjectId = wlmd.snapshotObjectId and true)

context SteamMeasurementDevice_getSteam
inv frameSus_SteamBoiler: (SteamBoiler.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(SteamBoiler.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.steamboiler->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().capacity = capacity and getNext().maximalLimit = maximalLimit and getNext().maximalNormal = maximalNormal and getNext().maximumDecrease = maximumDecrease and getNext().maximumIncrease = maximumIncrease and getNext().minimalLimit = minimalLimit and getNext().minimalNormal = minimalNormal and getNext().valveOpen = valveOpen and getNext().program.snapshotObjectId = program.snapshotObjectId and getNext().pump.snapshotObjectId = pump.snapshotObjectId and getNext().smd.snapshotObjectId = smd.snapshotObjectId and getNext().wlmd.snapshotObjectId = wlmd.snapshotObjectId and true)

context SteamMeasurementDevice_getSteam
inv frameDel_WaterLevelMeasurementDevice: (WaterLevelMeasurementDevice.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-WaterLevelMeasurementDevice.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameDel_ControlProgram: (ControlProgram.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-ControlProgram.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameSus_SteamMeasurementDevice: let SteamMeasurementDevice_C : Set(SteamMeasurementDevice) = Set{Set{self.transitionContext.getNext().getPrevious()}->flatten()}->flatten() in (self.transitionContext <> null and Set{self.transitionContext}->flatten() <> Set{} implies (self.transitionContext.getNext().program.snapshotObjectId = self.transitionContext.program.snapshotObjectId and self.transitionContext.getNext().sb.snapshotObjectId = self.transitionContext.sb.snapshotObjectId)) and (SteamMeasurementDevice.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(SteamMeasurementDevice.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.steammeasurementdevice->any(o | o.snapshotObjectId = id))->asSet()-SteamMeasurementDevice_C)->forAll(getNext().evaporationRate = evaporationRate and getNext().program.snapshotObjectId = program.snapshotObjectId and getNext().sb.snapshotObjectId = sb.snapshotObjectId and true)

context SteamMeasurementDevice_getSteam
inv frameDel_Pump: (Pump.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-Pump.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameAdd_PumpController: (PumpController.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-PumpController.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameAdd_SteamMeasurementDevice: (SteamMeasurementDevice.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-SteamMeasurementDevice.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameAdd_SteamBoiler: (SteamBoiler.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-SteamBoiler.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameAdd_PhysicalUnit: (PhysicalUnit.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-PhysicalUnit.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameAdd_ControlProgram: (ControlProgram.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-ControlProgram.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameDel_PumpController: (PumpController.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-PumpController.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameSus_PumpController: (PumpController.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(PumpController.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.pumpcontroller->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().circulating = circulating and getNext().program.snapshotObjectId = program.snapshotObjectId and getNext().pump.snapshotObjectId = pump.snapshotObjectId and true)

context SteamMeasurementDevice_getSteam
inv post1: (self.transitionContext.getNext().evaporationRate = result)

context SteamMeasurementDevice_getSteam
inv frameDel_SteamBoiler: (SteamBoiler.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-SteamBoiler.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameDel_PhysicalUnit: (PhysicalUnit.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-PhysicalUnit.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv pre1: (self.transitionContext.program.mode = Mode::Normal)

context SteamMeasurementDevice_getSteam
inv frameDel_SteamMeasurementDevice: (SteamMeasurementDevice.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-SteamMeasurementDevice.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameAdd_WaterLevelMeasurementDevice: (WaterLevelMeasurementDevice.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-WaterLevelMeasurementDevice.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameAdd_Pump: (Pump.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-Pump.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context SteamMeasurementDevice_getSteam
inv frameSus_WaterLevelMeasurementDevice: (WaterLevelMeasurementDevice.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(WaterLevelMeasurementDevice.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.waterlevelmeasurementdevice->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().waterLevel = waterLevel and getNext().program.snapshotObjectId = program.snapshotObjectId and getNext().sb.snapshotObjectId = sb.snapshotObjectId and true)

context ControlProgram_startOperation
inv frameSus_PumpController: (PumpController.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(PumpController.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.pumpcontroller->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().circulating = circulating and getNext().program.snapshotObjectId = program.snapshotObjectId and getNext().pump.snapshotObjectId = pump.snapshotObjectId and true)

context ControlProgram_startOperation
inv frameDel_PumpController: (PumpController.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-PumpController.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context ControlProgram_startOperation
inv frameSus_Pump: (Pump.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()->intersection(Pump.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->collect(id | beforeS.pump->any(o | o.snapshotObjectId = id))->asSet())->forAll(getNext().capacity = capacity and getNext().mode = mode and getNext().controller.snapshotObjectId = controller.snapshotObjectId and getNext().program.snapshotObjectId = program.snapshotObjectId and getNext().sb.snapshotObjectId = sb.snapshotObjectId and true)

context ControlProgram_startOperation
inv frameAdd_ControlProgram: (ControlProgram.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-ControlProgram.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context ControlProgram_startOperation
inv frameAdd_Pump: (Pump.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-Pump.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context ControlProgram_startOperation
inv frameAdd_PhysicalUnit: (PhysicalUnit.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-PhysicalUnit.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context ControlProgram_startOperation
inv validContext: self.transitionContext.snapshot = self.beforeS

context ControlProgram_startOperation
inv post1: (self.transitionContext.getNext().ready = true)

context ControlProgram_startOperation
inv frameDel_Pump: (Pump.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-Pump.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context ControlProgram_startOperation
inv frameDel_ControlProgram: (ControlProgram.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-ControlProgram.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context ControlProgram_startOperation
inv frameAdd_PumpController: (PumpController.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-PumpController.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context ControlProgram_startOperation
inv frameDel_SteamBoiler: (SteamBoiler.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet()-SteamBoiler.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet())->size() = 0

context ControlProgram_startOperation
inv frameAdd_SteamMeasurementDevice: (SteamMeasurementDevice.allInstances()->select(o | o.snapshot = self.nextS)->collect(snapshotObjectId)->asSet()-SteamMeasurementDevice.allInstances()->select(o | o.snapshot = self.beforeS)->collect(snapshotObjectId)->asSet())->size() = 0

context ControlProgram_startOperation
