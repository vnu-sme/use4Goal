atSnapshot(refSnap : Snapshot) : SteamMeasurementDevice = refSnap.steammeasurementdevice->any(s | self.snapshotObjectId = s.snapshotObjectId)

end

class Pump
attributes
capacity : Real
mode : State
snapshotObjectId : Integer
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : Pump = self.snapshot.getNext().pump->any(p | self.snapshotObjectId = p.snapshotObjectId)

getPost() : Set(Pump) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : Pump = self.snapshot.getPrevious().pump->any(p | self.snapshotObjectId = p.snapshotObjectId)

getPre() : Set(Pump) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : Pump = refSnap.pump->any(p | self.snapshotObjectId = p.snapshotObjectId)

end

class PhysicalUnit
attributes
