model SteamBoilerSTM

class Snapshot
operations
getNext() : Snapshot = self.nextT.nextS

getPost() : Set(Snapshot) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : Snapshot = self.beforeT.beforeS

getPre() : Set(Snapshot) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

sat(e : OclAny) : Boolean = true

end

class WaterLevelMeasurementDevice
attributes
waterLevel : Real
snapshotObjectId : Integer
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : WaterLevelMeasurementDevice = self.snapshot.getNext().waterlevelmeasurementdevice->any(w | self.snapshotObjectId = w.snapshotObjectId)

getPost() : Set(WaterLevelMeasurementDevice) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : WaterLevelMeasurementDevice = self.snapshot.getPrevious().waterlevelmeasurementdevice->any(w | self.snapshotObjectId = w.snapshotObjectId)

getPre() : Set(WaterLevelMeasurementDevice) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : WaterLevelMeasurementDevice = refSnap.waterlevelmeasurementdevice->any(w | self.snapshotObjectId = w.snapshotObjectId)

end

class ControlProgram
attributes
failureDetected : Boolean
mode : Mode
pumpControllerFailure : Boolean
pumpFailure : Boolean
ready : Boolean
smdFailure : Boolean
wlmdFailure : Boolean
snapshotObjectId : Integer
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : ControlProgram = self.snapshot.getNext().controlprogram->any(c | self.snapshotObjectId = c.snapshotObjectId)

getPost() : Set(ControlProgram) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : ControlProgram = self.snapshot.getPrevious().controlprogram->any(c | self.snapshotObjectId = c.snapshotObjectId)

getPre() : Set(ControlProgram) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : ControlProgram = refSnap.controlprogram->any(c | self.snapshotObjectId = c.snapshotObjectId)

end

class PumpController
attributes
circulating : Boolean
snapshotObjectId : Integer
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : PumpController = self.snapshot.getNext().pumpcontroller->any(p | self.snapshotObjectId = p.snapshotObjectId)

getPost() : Set(PumpController) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : PumpController = self.snapshot.getPrevious().pumpcontroller->any(p | self.snapshotObjectId = p.snapshotObjectId)

getPre() : Set(PumpController) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : PumpController = refSnap.pumpcontroller->any(p | self.snapshotObjectId = p.snapshotObjectId)

end

class SteamBoiler
attributes
capacity : Real
maximalLimit : Real
maximalNormal : Real
maximumDecrease : Real
maximumIncrease : Real
minimalLimit : Real
minimalNormal : Real
valveOpen : ValveState
snapshotObjectId : Integer
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : SteamBoiler = self.snapshot.getNext().steamboiler->any(s | self.snapshotObjectId = s.snapshotObjectId)

getPost() : Set(SteamBoiler) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : SteamBoiler = self.snapshot.getPrevious().steamboiler->any(s | self.snapshotObjectId = s.snapshotObjectId)

getPre() : Set(SteamBoiler) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : SteamBoiler = refSnap.steamboiler->any(s | self.snapshotObjectId = s.snapshotObjectId)

end

class SteamMeasurementDevice
attributes
evaporationRate : Real
snapshotObjectId : Integer
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : SteamMeasurementDevice = self.snapshot.getNext().steammeasurementdevice->any(s | self.snapshotObjectId = s.snapshotObjectId)

getPost() : Set(SteamMeasurementDevice) = Set{self.getNext()}->closure(getNext())->excluding(null)

