model LibraryManagement


aggregation PredSuccBook between
  Book[0..1] role predBook
  Book[0..1] role succBook
end

class returnBook_BookOpC < BookOpC
attributes
  result : Boolean
end

composition SnapshotMember between
  Snapshot[1] role snapshotMember
  Member[*]
end

association Filmstrip between
  Snapshot[0..1] role pred
  Snapshot[0..1] role succ
  OperationCall[0..1]
end

abstract class BookOpC < OperationCall
attributes
  aSelf : Book
end

class returnBook_MemberOpC < MemberOpC
attributes
  b : Book
  result : Boolean
end

composition SnapshotBook between
  Snapshot[1] role snapshotBook
  Book[*]
end

class Snapshot
operations
  copy() : Snapshot
    begin
      declare s : Snapshot;
      s := new Snapshot;
      for cl in self.book do 
        declare x : Book;
        x := new Book;
        insert (cl,x) into PredSuccBook;
        insert (s,x) into SnapshotBook;
      end;
      for cl in self.member do 
        declare x : Member;
        x := new Member;
        insert (cl,x) into PredSuccMember;
        insert (s,x) into SnapshotMember;
      end;
      ;
      for cl in s.book do 
        cl.author := cl.predBook.author;
        cl.isAvailable := cl.predBook.isAvailable;
        cl.isbn := cl.predBook.isbn;
        cl.title := cl.predBook.title;
      end;
      for cl in s.member do 
        cl.memberId := cl.predMember.memberId;
        cl.name := cl.predMember.name;
      end;
      for cl in self.book do 
        if not cl.member.isUndefined then
          insert (cl.member.succMember,cl.succBook) into BorrowedBooks
        end;
      end;
      result := s;
    end
  pred() : Snapshot = 
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot = 
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

aggregation PredSuccMember between
  Member[0..1] role predMember
  Member[0..1] role succMember
end

abstract class OperationCall
operations
  pred() : Snapshot = 
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot = 
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

abstract class MemberOpC < OperationCall
attributes
  aSelf : Member
end

class borrowBook_MemberOpC < MemberOpC
attributes
  b : Book
  result : Boolean
end

class borrow_BookOpC < BookOpC
attributes
  result : Boolean
end

class Book
attributes
  title : String
  author : String
  isbn : String
  isAvailable : Boolean
operations
  borrow() : Boolean
  returnBook() : Boolean
end

class Member
attributes
  name : String
  memberId : Integer
operations
  borrowBook(b : Book) : Boolean
  returnBook(b : Book) : Boolean
end

association BorrowedBooks between
  Member[1]
  Book[*] role books
end

constraints
context Book inv validSnapshotLinking:
  (self.succBook.isDefined() implies (self.succBook.snapshotBook = self.snapshotBook.succ()))

context BookOpC inv aSelfDefined:
  self.aSelf.isDefined()

context BookOpC inv aSelfInPred:
  (self.aSelf.snapshotBook = self.pred())

context Member inv validLinkingBorrowedBooks:
  self.books->forAll( c:Book | (c.snapshotBook = self.snapshotMember) )

context Member inv validSnapshotLinking:
  (self.succMember.isDefined() implies (self.succMember.snapshotMember = self.snapshotMember.succ()))

context MemberOpC inv aSelfDefined:
  self.aSelf.isDefined()

context MemberOpC inv aSelfInPred:
  (self.aSelf.snapshotMember = self.pred())

context OperationCall inv assocClassBehavior:
  (((self.pred->size() = 1) and (self.succ->size() = 1)) and OperationCall.allInstances()->forAll( op:OperationCall | (((self.pred = op.pred) and (self.succ = op.succ)) implies (self = op)) ))

context Snapshot inv cycleFree:
  Set{self.succ()}->closure( s:Snapshot | s.succ() )->excludes(self)

context Snapshot inv oneFilmstrip:
  ((Snapshot.allInstances()->select( s:Snapshot | s.pred().isUndefined() )->size() = 1) and (Snapshot.allInstances()->select( s:Snapshot | s.succ().isUndefined() )->size() = 1))

context borrowBook_MemberOpC inv post_post1:
  (b.succBook.isAvailable = false)

context borrowBook_MemberOpC inv pre_pre1:
  (b.isAvailable = true)

context borrow_BookOpC inv post_post1:
  (aSelf.succBook.isAvailable = false)

context borrow_BookOpC inv pre_pre1:
  (aSelf.isAvailable = true)

context returnBook_BookOpC inv post_post1:
  (aSelf.succBook.isAvailable = true)

context returnBook_BookOpC inv pre_pre1:
  (aSelf.isAvailable = false)

context returnBook_MemberOpC inv post_post1:
  (b.succBook.isAvailable = true)

context returnBook_MemberOpC inv pre_pre1:
  (b.isAvailable = false)

context Snapshot::copy() : Snapshot
  pre uncopied: self.succ().isUndefined()

