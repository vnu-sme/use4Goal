class Role
attributes
snapshotObjectId : Integer
operations
getAHJuniorRoles(z : STZone) : Set(Role) = A_Hierarchy.allInstances->select(ah : A_Hierarchy | ((ah.seniorRole = self) and (ah.zone = z)))->collect(ah1 : A_Hierarchy | ah1.juniorRole)->asSet

getAllAHInheritedRoles(z : STZone) : Set(Role) = Role.allInstances->select(r : Role | self.inheritsAH(r, z))->asSet

getAllIHInheritedRoles(z : STZone) : Set(Role) = Role.allInstances->select(r : Role | self.inheritsIH(r, z))->asSet

getAssignedPermissions(z : STZone) : Set(Permission) = self.permAssig->select(pa : PermissionAssignment | (pa.zone = z))->collect(pa1 : PermissionAssignment | pa1.permission)->asSet

getAuthorizedPermissions(z : STZone) : Set(Permission) = self.getAssignedPermissions(z)->union(self.getAllIHInheritedRoles(z)->collect(r : Role | r.getAssignedPermissions(z)))->asSet

getDSoDRoles(z : STZone) : Set(Role) = self.sod->select(s : SOD | ((s.zone = z) and s.oclIsTypeOf(DSOD)))->collect(s : SOD | s.getInvolvedRoles())->union(self.SOD->select(s : SOD | ((s.zone = z) and s.oclIsTypeOf(DSOD)))->collect(s : SOD | s.getInvolvedRoles()))->excluding(self)->asSet

getIHJuniorRoles(z : STZone) : Set(Role) = I_Hierarchy.allInstances->select(ih : I_Hierarchy | ((ih.seniorRole = self) and (ih.zone = z)))->collect(ih1 : I_Hierarchy | ih1.juniorRole)->asSet

getJuniorRoles(z : STZone) : Set(Role) = RoleHierarchy.allInstances->select(h : RoleHierarchy | ((h.seniorRole = self) and (h.zone = z)))->collect(rh : RoleHierarchy | rh.juniorRole)->asSet

getPrerequisiteRoles() : Set(Role) = self.prerequisiteRole->asSet

getSSoDRoles(z : STZone) : Set(Role) = self.sod->select(s : SOD | ((s.zone = z) and s.oclIsTypeOf(RSSOD)))->collect(s : SOD | s.getInvolvedRoles())->union(self.SOD->select(s : SOD | ((s.zone = z) and s.oclIsTypeOf(RSSOD)))->collect(s : SOD | s.getInvolvedRoles()))->excluding(self)->asSet

inherits(r : Role, z : STZone) : Boolean = if self.getJuniorRoles(z)->includes(r) then true else self.getJuniorRoles(z)->exists(j : Role | j.inherits(r, z)) endif

inheritsAH(r : Role, z : STZone) : Boolean = if self.getAHJuniorRoles(z)->includes(r) then true else self.getAHJuniorRoles(z)->exists(j : Role | j.inheritsAH(r, z)) endif

inheritsIH(r : Role, z : STZone) : Boolean = if self.getIHJuniorRoles(z)->includes(r) then true else self.getIHJuniorRoles(z)->exists(j : Role | j.inheritsIH(r, z)) endif

getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : Role = self.snapshot.getNext().role->any(r | self.snapshotObjectId = r.snapshotObjectId)

getPost() : Set(Role) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : Role = self.snapshot.getPrevious().role->any(r | self.snapshotObjectId = r.snapshotObjectId)

getPre() : Set(Role) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : Role = refSnap.role->any(r | self.snapshotObjectId = r.snapshotObjectId)

end

