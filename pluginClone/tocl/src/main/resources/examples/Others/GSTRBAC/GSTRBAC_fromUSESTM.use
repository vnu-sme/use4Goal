model GSTRBACSTM

class Snapshot
operations
getNext() : Snapshot = self.nextT.nextS

getPost() : Set(Snapshot) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : Snapshot = self.beforeT.beforeS

getPre() : Set(Snapshot) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

sat(e : OclAny) : Boolean = true

end

class RSSOD < SOD
operations
getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : RSSOD = self.snapshot.getNext().rssod->any(r | self.snapshotObjectId = r.snapshotObjectId)

getPost() : Set(RSSOD) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : RSSOD = self.snapshot.getPrevious().rssod->any(r | self.snapshotObjectId = r.snapshotObjectId)

getPre() : Set(RSSOD) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : RSSOD = refSnap.rssod->any(r | self.snapshotObjectId = r.snapshotObjectId)

end

