attributes
snapshotObjectId : Integer
operations
getPrerequisitePermissions() : Set(Permission) = self.prerequisitePermission->asSet

getSoDPermissions(z : STZone) : Set(Permission) = self.pssod->select(s : PSSOD | (s.zone = z))->collect(s : PSSOD | s.getInvolvedPermissions())->union(self.PSSOD->select(s : PSSOD | (s.zone = z))->collect(s : PSSOD | s.getInvolvedPermissions()))->excluding(self)->asSet

getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : Permission = self.snapshot.getNext().permission->any(p | self.snapshotObjectId = p.snapshotObjectId)

getPost() : Set(Permission) = Set{self.getNext()}->closure(getNext())->excluding(null)

