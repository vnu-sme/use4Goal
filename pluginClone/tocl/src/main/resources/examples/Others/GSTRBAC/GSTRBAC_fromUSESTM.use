class User
attributes
name : String
snapshotObjectId : Integer
operations
checkAccess(o : Object, a : Activity, z : STZone) : Boolean = self.getActivatedRoles(z)->collect(r : Role | r.getAuthorizedPermissions(z))->asSet->exists(p : Permission | ((p.object = o) and (p.activity = a)))

getActivatedRoles(z : STZone) : Set(Role) = self.relations->select(r : UserRoleRelation | (r.oclIsTypeOf(UserRoleActivation) and (r.zone = z)))->collect(r : UserRoleRelation | r.role)->asSet

getAssignedRoles(z : STZone) : Set(Role) = self.relations->select(r : UserRoleRelation | (r.oclIsTypeOf(UserRoleAssignment) and (r.zone = z)))->collect(r : UserRoleRelation | r.role)->asSet

getAuthorizedRoles(z : STZone) : Set(Role) = self.getAssignedRoles(z)->union(self.getAssignedRoles(z)->collect(r : Role | r.getAllAHInheritedRoles(z))->asSet)

getCurrentSnapshot() : Snapshot = self.snapshot

getNext() : User = self.snapshot.getNext().user->any(u | self.snapshotObjectId = u.snapshotObjectId)

getPost() : Set(User) = Set{self.getNext()}->closure(getNext())->excluding(null)

getPrevious() : User = self.snapshot.getPrevious().user->any(u | self.snapshotObjectId = u.snapshotObjectId)

getPre() : Set(User) = Set{self.getPrevious()}->closure(getPrevious())->excluding(null)

atSnapshot(refSnap : Snapshot) : User = refSnap.user->any(u | self.snapshotObjectId = u.snapshotObjectId)

end

