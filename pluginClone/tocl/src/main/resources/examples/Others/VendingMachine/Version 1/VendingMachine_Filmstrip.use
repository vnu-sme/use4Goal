model VendingMachineSystem


class insertMoney_VendingMachineOpC < VendingMachineOpC
attributes
  money : Integer
end

aggregation PredSuccVendingMachine between
  VendingMachine[0..1] role predVendingMachine
  VendingMachine[0..1] role succVendingMachine
end

aggregation PredSuccItem between
  Item[0..1] role predItem
  Item[0..1] role succItem
end

association Filmstrip between
  Snapshot[0..1] role pred
  Snapshot[0..1] role succ
  OperationCall[0..1]
end

class Snapshot
operations
  pred() : Snapshot = 
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot = 
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

abstract class VendingMachineOpC < OperationCall
attributes
  aSelf : VendingMachine
end

class dispenseItem_VendingMachineOpC < VendingMachineOpC
end

abstract class OperationCall
operations
  pred() : Snapshot = 
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot = 
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

composition SnapshotItem between
  Snapshot[1] role snapshotItem
  Item[*]
end

class selectItem_VendingMachineOpC < VendingMachineOpC
attributes
  item : Item
end

composition SnapshotVendingMachine between
  Snapshot[1] role snapshotVendingMachine
  VendingMachine[*]
end

class VendingMachine
attributes
  totalMoney : Integer init : 0
  selectedItem : Item init : null
operations
  insertMoney(money : Integer)
    begin
      self.totalMoney := (self.totalMoney + money)
    end
  selectItem(item : Item)
    begin
      self.selectedItem := item
    end
  dispenseItem()
    begin
      if (self.totalMoney >= self.selectedItem.price) then
        self.totalMoney := (self.totalMoney - self.selectedItem.price);
        self.selectedItem.stock := (self.selectedItem.stock - 1);
        self.selectedItem := null;
      end
    end
end

class Item
attributes
  id : Integer
  price : Integer
  stock : Integer
end

association VendingMachineItem between
  VendingMachine[1] role machine
  Item[1..*] role items
end

constraints
context Item inv validSnapshotLinking:
  (self.succItem.isDefined() implies (self.succItem.snapshotItem = self.snapshotItem.succ()))

context OperationCall inv assocClassBehavior:
  (((self.pred->size() = 1) and (self.succ->size() = 1)) and OperationCall.allInstances()->forAll( op:OperationCall | (((self.pred = op.pred) and (self.succ = op.succ)) implies (self = op)) ))

context Snapshot inv cycleFree:
  Set{self.succ()}->closure( s:Snapshot | s.succ() )->excludes(self)

context Snapshot inv oneFilmstrip:
  ((Snapshot.allInstances()->select( s:Snapshot | s.pred().isUndefined() )->size() = 1) and (Snapshot.allInstances()->select( s:Snapshot | s.succ().isUndefined() )->size() = 1))

context VendingMachine inv validLinkingVendingMachineItem:
  self.items->forAll( c:Item | (c.snapshotItem = self.snapshotVendingMachine) )

context VendingMachine inv validSnapshotLinking:
  (self.succVendingMachine.isDefined() implies (self.succVendingMachine.snapshotVendingMachine = self.snapshotVendingMachine.succ()))

context VendingMachineOpC inv aSelfDefined:
  self.aSelf.isDefined()

context VendingMachineOpC inv aSelfInPred:
  (self.aSelf.snapshotVendingMachine = self.pred())

context dispenseItem_VendingMachineOpC inv post_itemDispensed:
  (aSelf.succVendingMachine.selectedItem.stock = (aSelf.succVendingMachine.selectedItem.predItem.stock - 1))

context dispenseItem_VendingMachineOpC inv post_itemNullified:
  aSelf.succVendingMachine.selectedItem.isUndefined()

context dispenseItem_VendingMachineOpC inv post_moneyUpdated:
  (aSelf.succVendingMachine.totalMoney = (aSelf.succVendingMachine.predVendingMachine.totalMoney - aSelf.succVendingMachine.selectedItem.price))

context dispenseItem_VendingMachineOpC inv pre_enoughMoney:
  (aSelf.totalMoney >= aSelf.selectedItem.price)

context dispenseItem_VendingMachineOpC inv pre_itemSelected:
  (aSelf.selectedItem <> null)

context insertMoney_VendingMachineOpC inv post_moneyInserted:
  (aSelf.succVendingMachine.totalMoney = (aSelf.succVendingMachine.predVendingMachine.totalMoney + money))

context insertMoney_VendingMachineOpC inv pre_validMoney:
  (money > 0)

context selectItem_VendingMachineOpC inv paramItemInPred:
  (not self.item.isUndefined() implies (self.item.snapshotItem = self.pred()))

context selectItem_VendingMachineOpC inv post_itemSelected:
  (aSelf.succVendingMachine.selectedItem = item.succItem)

context selectItem_VendingMachineOpC inv pre_itemAvailable:
  (item.stock > 0)

context self : VendingMachine inv moneyConstraint:
  (self.totalMoney >= 0)

context self : Item inv priceConstraint:
  (self.price > 0)

context self : Item inv stockConstraint:
  (self.stock >= 0)

