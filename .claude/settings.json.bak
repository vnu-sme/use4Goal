{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows --repo \"E:/code/Lab/USE_spaces/use-goal-BPMN\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status --repo \"E:/code/Lab/USE_spaces/use-goal-BPMN\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
